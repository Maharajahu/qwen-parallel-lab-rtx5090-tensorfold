+            defer e.features = 0;
+            try e.body(exact);
+        } else if (prompt) {
+            // uncaptured: a prompt chunk's GEMMs dwarf its launches, and each length's graph would pay the stall
+            e.features = if (images) |im| im.features else 0;
+            defer e.features = 0;
+            try e.body(shape);
+        } else {
+            const gop = try e.graphs.getOrPut(e.gpa, shape.key());
