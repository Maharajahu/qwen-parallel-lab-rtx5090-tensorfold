+    try std.testing.expect(tailEligible(2048, 8192));
+    try std.testing.expect(tailEligible(2048, 129024));
+    try std.testing.expect(!tailEligible(2048, 8191));
+    for ([_]usize{ 0, 1, 32, 64, 127, 129, 2047, 2049, 4096 }) |rows|
