--- /dev/null
+++ b/zig/kernels/cuda/prefill_attention_expand.cuh
@@ -0,0 +1,22 @@
+// A paged FP8 cache expanded once per prompt chunk with hpattn8's exact multiply and BF16 rounding.
+#pragma once
+#include "prefill_attention.cuh"
+
+extern "C" __global__ void tf_prefill_expand8(const uint8_t* k, const uint8_t* v, const float* ks, const float* vs,
+    __nv_bfloat16* bk, __nv_bfloat16* bv, const int* pages, long long stride, int len, int cap) {
+    const int pair = blockIdx.x * blockDim.x + threadIdx.x;
+    const int row = pair / 128, dim = (pair % 128) * 2, h = blockIdx.y;
+    if (row >= len) return;
+    const long long page = (long long)pages[row / 128] * stride;
+    const int r = h * 128 + row % 128;
+    const long long at = page + (long long)r * 256 + dim, to = ((long long)h * cap + row) * 256 + dim;
+    const float sk = *(const float*)((const uint8_t*)ks + page + r * 4);
+    const float sv = *(const float*)((const uint8_t*)vs + page + r * 4);
+    auto convert = [](const uint8_t* src, float scale) {
+        const auto e = *reinterpret_cast<const __nv_fp8x2_storage_t*>(src);
+        const float2 x = __half22float2(__half2(__nv_cvt_fp8x2_to_halfraw2(e, __NV_E4M3)));
+        return tf_prefill_attention::pack(__fmul_rn(x.x, scale), __fmul_rn(x.y, scale));
+    };
+    *reinterpret_cast<uint32_t*>(bk + to) = convert(k + at, sk);
+    *reinterpret_cast<uint32_t*>(bv + to) = convert(v + at, sv);
+}
