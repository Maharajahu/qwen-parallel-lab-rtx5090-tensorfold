+        // Preserve the original per-tile output-rescale rounding point.
+#pragma unroll
+        for (int n = 0; n < 4; ++n) {
+            transpose_mul2(
+                out[n][0], out[n][1], alpha[0], alpha[1]);
+            transpose_mul2(
+                out[n][2], out[n][3], alpha[0], alpha[1]);
+        }
