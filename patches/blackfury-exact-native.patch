new file mode 100644
index 00000000..0fc93377
--- /dev/null
+++ b/zig/src/core/lab_profile.c
@@ -0,0 +1,34 @@
+#include <stdint.h>
+#include <nvtx3/nvToolsExt.h>
+
+// NVTX's installed NVIDIA headers retain their own license; no vendor source is copied into this experiment.
+void tf_lab_init(void) {
+    nvtxInitialize(NULL);
+}
+
+static nvtxEventAttributes_t attributes(const char *name, uint64_t payload) {
+    nvtxEventAttributes_t a = {0};
+    a.version = NVTX_VERSION;
+    a.size = NVTX_EVENT_ATTRIB_STRUCT_SIZE;
+    a.messageType = NVTX_MESSAGE_TYPE_ASCII;
+    a.message.ascii = name;
+    a.payloadType = NVTX_PAYLOAD_TYPE_UNSIGNED_INT64;
+    a.payload.ullValue = payload;
+    a.colorType = NVTX_COLOR_ARGB;
+    a.color = 0xFF4A90D9;
+    return a;
+}
+
+void tf_lab_push(const char *name, uint64_t payload) {
+    nvtxEventAttributes_t a = attributes(name, payload);
+    nvtxRangePushEx(&a);
+}
+
+void tf_lab_pop(void) {
+    nvtxRangePop();
+}
+
+void tf_lab_mark(const char *name, uint64_t payload) {
+    nvtxEventAttributes_t a = attributes(name, payload);
+    nvtxMarkEx(&a);
+}
diff --git a/zig/src/core/lab_profile.zig b/zig/src/core/lab_profile.zig
new file mode 100644
index 00000000..4e8bcef3
--- /dev/null
+++ b/zig/src/core/lab_profile.zig
@@ -0,0 +1,54 @@
+//! Opt-in diagnostic NVTX scopes; no GPU events, synchronization, allocation or logging on the hot path.
+const builtin = @import("builtin");
+const linked = !builtin.is_test;
+var enabled = false;
+
+extern fn tf_lab_init() void;
+extern fn tf_lab_push(name: [*:0]const u8, payload: u64) void;
+extern fn tf_lab_pop() void;
+extern fn tf_lab_mark(name: [*:0]const u8, payload: u64) void;
+
+pub fn init(on: bool) void {
+    if (comptime linked) {
+        enabled = on;
+        if (on) tf_lab_init();
+    }
+}
+
+pub const Span = struct {
+    active: bool,
+    pub fn end(s: Span) void {
+        if (comptime linked) if (s.active) tf_lab_pop();
+    }
+};
+
+pub fn begin(name: [:0]const u8, payload: u64) Span {
+    if (comptime linked) if (enabled) {
+        tf_lab_push(name.ptr, payload);
+        return .{ .active = true };
+    };
+    return .{ .active = false };
+}
+
+pub fn mark(name: [:0]const u8, payload: u64) void {
+    if (comptime linked) if (enabled) tf_lab_mark(name.ptr, payload);
+}
+
+pub fn pack(high: usize, low: usize) u64 {
+    return (@as(u64, @intCast(high)) << 32) | @as(u64, @intCast(low));
+}
+
+pub fn wait(stream: anytype, name: [:0]const u8) !void {
+    const span = begin(name, 0);
+    defer span.end();
+    try stream.synchronize();
+}
+
+test "lab profiling disabled scopes preserve zero work" {
+    init(false);
+    const span = begin("test", pack(129024, 8));
+    try @import("std").testing.expect(!span.active);
+    span.end();
+    mark("test", 0);
+    try @import("std").testing.expectEqual(@as(u64, 129024) << 32 | 8, pack(129024, 8));
+}
