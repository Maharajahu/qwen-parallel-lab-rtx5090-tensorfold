+const std = @import("std");
+const cuda = @import("cuda");
+const geometry = @import("cuda_geometry.zig");
+const Seg = @import("cuda_cache.zig").Seg;
+
+pub const State = struct {
+    cap: usize = 0,
+    ptr: u64 = 0,
+    kernel: cuda.Function = undefined,
+    tail: cuda.Function = undefined,
+
+    pub fn init(ctx: *const cuda.Context, g: geometry.Geometry, kv8: bool, context: usize) !State {
+        if (!kv8 or !g.kinds.modelopt or !geometry.dense27(g)) return .{};
+        if (try ctx.attribute(.compute_capability_major) != 12 or
+            try ctx.attribute(.compute_capability_minor) != 0 or
+            try ctx.attribute(.multiprocessor_count) != 170) return .{};
+        return .{ .cap = @min(context, 131072) };
+    }
+
+    pub fn bytes(s: State, heads: usize) usize {
+        return s.cap * heads * geometry.head_dim * 4;
+    }
