+/// Three resident blocks help this envelope until a long final wave would undo the gain.
+pub fn useAsync(rows: usize, cached: usize) bool {
+    if (rows < 6 or rows > 10 or cached < 32768) return false;
+    const chunk = @max(@as(usize, 128), ((cached + rows + 8191) / 8192) * 128);
