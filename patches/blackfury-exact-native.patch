+                    alpha[lb] = ab;
+                }
+            }
+            __syncthreads();
+            sa = fmaf(sa, aa, red[0][la] + red[1][la]);
+            sb = fmaf(sb, ab, red[0][lb] + red[1][lb]);
+            mxa = na;
+            mxb = nb;
+            // the values: rescale every line once, then each tile of values (a window tile's, row by row)
+#pragma unroll
+            for (int a = 0; a < MT; a++) {
+                const float a0 = alpha[16 * a + g], a1 = alpha[16 * a + g + 8];
+#pragma unroll
+                for (int n = 0; n < NT; n++) {
