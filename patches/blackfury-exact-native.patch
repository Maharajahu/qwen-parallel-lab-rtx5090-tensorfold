+                PL[sl] = r_k1[ja] > k0 ? sa : 0.0f;
+            }
+            if (inb) {
+                const size_t sl = ((size_t)(m0 + jb) * QH + h * G + lb % G) * MAXCH + c;
+                PM[sl] = r_k1[jb] > k0 ? mxb : -INFINITY;
+                PL[sl] = r_k1[jb] > k0 ? sb : 0.0f;
+            }
+        }
+#pragma unroll
+        for (int a = 0; a < MT; a++) {
+            const int l0 = 16 * a + g, l1 = l0 + 8, j0 = l0 / G, j1 = l1 / G;
+#pragma unroll
+            for (int n = 0; n < NT; n++) {
+                const int d = 8 * (NT * warp + n) + 2 * qd;
