+// Exact widening for the SM120a specialization.
+__device__ __forceinline__ uint2 widen4_native(uint32_t w) {
+    uint32_t lo, hi;
+    asm("cvt.rn.bf16x2.e4m3x2 %0, %1;" : "=r"(lo) : "h"((unsigned short)w));
+    asm("cvt.rn.bf16x2.e4m3x2 %0, %1;" : "=r"(hi) : "h"((unsigned short)(w >> 16)));
+    return make_uint2(lo, hi);
+}
+__device__ __forceinline__ void widen16_native(uint4 w, uint4* lo, uint4* hi) {
+    const uint2 a = widen4_native(w.x), b = widen4_native(w.y), c = widen4_native(w.z), d = widen4_native(w.w);
+    *lo = make_uint4(a.x, a.y, b.x, b.y);
+    *hi = make_uint4(c.x, c.y, d.x, d.y);
+}
