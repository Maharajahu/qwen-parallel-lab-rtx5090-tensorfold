+        if (!kv8 or s.cap == 0 or sg.pt == 0 or sg.ptok != 128 or sg.len < 0 or rows < 128) return false;
+        const cached: usize = @intCast(sg.len);
+        return cached <= s.cap and rows <= s.cap - cached;
+    }
+
+    pub fn run(s: State, e: anytype, sg: Seg, layer: usize, from: usize, rows: usize) !void {
+        const g = e.g;
+        const slab = g.kv_heads * @as(usize, @intCast(sg.ptok));
+        const keys = sg.kv + layer * 2 * slab * (geometry.head_dim + 4);
