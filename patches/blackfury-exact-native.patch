diff --git a/zig/tests/cuda/contract_qwen_prompt_tail.zig b/zig/tests/cuda/contract_qwen_prompt_tail.zig
new file mode 100644
index 00000000..4390c30d
--- /dev/null
+++ b/zig/tests/cuda/contract_qwen_prompt_tail.zig
@@ -0,0 +1,214 @@
+//! Four-warp BF16 prompt tail: exact replacement, guarded repeats and independently simulated FP32 stress sums.
+const std = @import("std");
+const cuda = @import("cuda");
+const core = @import("core");
+const rig_ = @import("contract_rig.zig");
+const attn = @import("contract_attn.zig");
+const check_ = @import("check.zig");
+const c = core.contract.spec;
+const g = core.contract.gates;
+const qh = 24;
+const kh = 4;
+const hd = 256;
+const symbol = "_ZN20tf_prefill_attention19hpattn_whole_kernelILi256ELi4ELi2ELi2EEEvPK13__nv_bfloat16S3_S3_PS1_iiiiifi";
+const parent = "_ZN20tf_prefill_attention19hpattn_whole_kernelILi256ELi8ELi2ELi2EEEvPK13__nv_bfloat16S3_S3_PS1_iiiiifi";
+
+pub const Group = struct {
+    module: cuda.Module,
+    cases: [2]Case,
+
+    pub fn create(gpu: check_.Gpu, stream: cuda.Stream, kernels: *std.ArrayList(g.Kernel)) !?*Group {
+        if (try gpu.ctx.capability() != 120) return null;
+        const self = try gpu.gpa.create(Group);
+        errdefer gpu.gpa.destroy(self);
+        self.module = try cuda.Module.load(gpu.d, cuda.kernels.prefill_attention);
+        errdefer self.module.unload();
+        const candidate = try self.module.function(symbol);
+        const baseline = try self.module.function(parent);
+        try candidate.allowDynamicShared(65536);
+        try baseline.allowDynamicShared(98304);
+        for (&self.cases, 0..) |*item, i| item.* = .{ .rig = .{ .gpu = gpu, .s = stream }, .candidate = candidate, .baseline = baseline, .arena = .init(gpu.gpa), .control = i == 1 };
+        try kernels.ensureUnusedCapacity(gpu.gpa, self.cases.len);
+        for (&self.cases) |*item| kernels.appendAssumeCapacity(item.kernel());
+        return self;
+    }
+
+    pub fn destroy(self: *Group) void {
+        const a = self.cases[0].rig.gpu.gpa;
+        for (&self.cases) |*item| {
+            item.rig.deinit();
+            item.arena.deinit();
+        }
+        self.module.unload();
+        a.destroy(self);
+    }
+};
+
+fn depth(s: c.Shape) usize {
+    return s.k + s.rows;
+}
+
+const Case = struct {
+    rig: rig_.Rig,
+    candidate: cuda.Function,
+    baseline: cuda.Function,
+    arena: std.heap.ArenaAllocator,
+    control: bool,
+    shape: c.Shape = .{ .rows = 0, .n = qh, .k = 0 },
+    ptrs: [3]u64 = @splat(0),
+    out: u64 = 0,
+    base: u64 = 0,
+    terms: []f64 = &.{},
+    const vt = g.hooks(Case);
+
+    fn kernel(self: *Case) g.Kernel {
+        return .{ .ctx = self, .vt = &vt, .control = if (self.control) .shapes else null, .spec = .{
+            .name = if (self.control) "control qwen BF16 tail dropping final row" else "cuda qwen BF16 four-warp prompt tail",
+            .accum = .f32,
+            .depth = depth,
+            .ops = 3,
+            .out = .bf16,
+            .replaces = "eight-warp hpattn_whole<256,8,2,2>",
+            .nan = .{ .stated = "preserves the eight-warp parent's output bytes with planted NaN and both infinities" },
+            .tiles = .{ .{ .size = 32 }, .{}, .{} },
+            .served = &.{
+                .{ .rows = 128, .n = qh, .k = 8192 },
+                .{ .rows = 128, .n = qh, .k = 65536 },
+                .{ .rows = 128, .n = qh, .k = 128896 },
+                .{ .rows = 2048, .n = qh, .k = 8192 },
+                .{ .rows = 2048, .n = qh, .k = 126976 },
+                .{ .rows = 2048, .n = qh, .k = 129024 },
+            },
+        } };
+    }
+
+    pub fn prepare(self: *Case, shape: c.Shape, fill: g.Fill, seed: u64) !bool {
+        if (shape.rows == 0 or shape.rows > 2048 or shape.n != qh or shape.k + shape.rows > 131072) return false;
+        self.rig.reset();
+        _ = self.arena.reset(.free_all);
+        self.shape = shape;
+        const a = self.arena.allocator();
+        const cap = shape.k + shape.rows;
+        var rng_state = std.Random.DefaultPrng.init(seed);
+        const rng = rng_state.random();
+        const q = try a.alloc(u16, self.count());
+        const kv = try a.alloc(u16, 2 * kh * cap * hd);
+        const k = kv[0 .. kh * cap * hd];
+        const v = kv[k.len..];
+        if (fill == .stress) {
+            @memset(q, 0);
+            @memset(k, 0);
+            const col = try a.alloc(f32, 2048);
+            attn.mirrored(rng, col);
+            self.terms = try a.alloc(f64, cap);
+            for (self.terms, 0..) |*term, pos| term.* = if (pos < col.len) c.fromBf16(c.toBf16(col[pos])) else 0;
+            for (0..kh) |h| for (0..cap) |pos| {
+                @memset(v[(h * cap + pos) * hd ..][0..hd], c.toBf16(@floatCast(self.terms[pos])));
+            };
+        } else {
+            for (q) |*x| x.* = c.toBf16(rng.float(f32) * 2 - 1);
+            for (kv) |*x| x.* = c.toBf16(rng.float(f32) * 2 - 1);
+            if (fill == .nonfinite) {
+                q[3] = c.toBf16(std.math.nan(f32));
+                v[7] = c.toBf16(std.math.inf(f32));
+                v[hd + 11] = c.toBf16(-std.math.inf(f32));
+                k[(3 * cap + shape.k - 1) * hd] = c.toBf16(std.math.nan(f32));
+            }
+        }
+        self.ptrs = .{ try self.rig.input(std.mem.sliceAsBytes(q)), try self.rig.input(std.mem.sliceAsBytes(k)), try self.rig.input(std.mem.sliceAsBytes(v)) };
+        self.out = try self.rig.output(self.count() * 2);
+        self.base = try self.rig.scratch(self.count() * 2);
+        return true;
+    }
+
+    fn launch(self: *Case, baseline: bool) !void {
+        const n = self.shape.rows - @intFromBool(self.control and !baseline);
+        if (n == 0) return;
+        var args: cuda.Args = .{};
+        for (self.ptrs) |ptr| args.add(ptr);
+        args.add(if (baseline) self.base else self.out);
+        for ([_]usize{ self.shape.k, n, qh, kh, qh / kh }) |x| args.add(@as(c_int, @intCast(x)));
+        args.add(@as(f32, 1.0 / 16.0));
+        args.add(@as(c_int, @intCast(self.shape.k + self.shape.rows)));
+        const tile: usize = if (baseline) 64 else 32;
+        try cuda.launch.launch(if (baseline) self.baseline else self.candidate, .{ .grid = .{ .x = @intCast((n + tile - 1) / tile), .y = qh / 2 }, .block = .{ .x = if (baseline) 256 else 128 }, .shared = if (baseline) 98304 else 65536 }, self.rig.s, &args);
+    }
+
+    pub fn run(self: *Case) !void {
+        try self.launch(false);
+        try self.rig.s.synchronize();
+    }
+
+    pub fn replaced(self: *Case) ![]const u8 {
+        try self.launch(true);
+        return self.rig.bytes(self.base, self.count() * 2);
+    }
+
+    pub fn count(self: *Case) usize {
+        return self.shape.rows * qh * hd;
+    }
+
+    pub fn check(self: *Case, _: g.Gate) !?[]const u8 {
+        const got = try self.rig.outputBytes();
+        if (!std.mem.eql(u8, got, try self.replaced())) return "nonfinite output differs from parent";
+        var nf: usize = 0;
+        for (0..self.count()) |i| if (!std.math.isFinite(c.read(.bf16, got, i))) {
+            nf += 1;
+        };
+        if (nf == 0 or nf == self.count()) return "nonfinite fixture lacks mixed finite/nonfinite outputs";
+        return null;
+    }
+
+    pub fn reference(self: *Case, want: []f64, mag: []f64) !void {
+        for (0..self.shape.rows) |row| {
+            const n = self.shape.k + row + 1;
+            var sum: f64 = 0;
+            var abs: f64 = 0;
+            for (self.terms[0..n]) |x| {
+                sum += x;
+                abs += @abs(x);
+            }
+            @memset(want[row * qh * hd ..][0 .. qh * hd], sum / @as(f64, @floatFromInt(n)));
+            @memset(mag[row * qh * hd ..][0 .. qh * hd], abs / @as(f64, @floatFromInt(n)));
+        }
+    }
+
+    pub fn simulate(self: *Case, acc: c.Accum, order: g.Order, out: []f64) !void {
+        const ones = try self.arena.allocator().alloc(f64, self.terms.len);
+        @memset(ones, 1);
+        for (0..self.shape.rows) |row| {
+            const n = self.shape.k + row + 1;
+            const denominator = core.contract.rows.sumIn(acc, order, ones[0..n]);
+            const numerator = core.contract.rows.sumIn(acc, order, self.terms[0..n]);
+            @memset(out[row * qh * hd ..][0 .. qh * hd], numerator / denominator);
+        }
+    }
+};
+
+pub fn run(gpu: check_.Gpu) !void {
+    var stream = try cuda.Stream.init(gpu.d, false);
+    defer stream.deinit();
+    var kernels: std.ArrayList(g.Kernel) = .empty;
+    defer kernels.deinit(gpu.gpa);
+    const group = (try Group.create(gpu, stream, &kernels)) orelse return error.RequiresSm120;
+    defer group.destroy();
+    var tally: g.Tally = .{};
+    try g.runAll(gpu.gpa, kernels.items, 0x4b128, &tally);
+    const f = group.cases[0].candidate;
+    const limits = core.contract.limits;
+    const usage: limits.Usage = .{ .regs = @intCast(try f.attribute(.num_regs)), .static = @intCast(try f.attribute(.shared_size_bytes)), .bound = @intCast(try f.attribute(.max_threads_per_block)), .local = @intCast(try f.attribute(.local_size_bytes)) };
+    const launch = blk: {
+        for (core.contract.registry.all_cuda) |record| {
+            if (std.mem.eql(u8, record.launch.symbol, symbol)) break :blk record.launch;
+        }
+        return error.TailLaunchRecordMissing;
+    };
+    var explanation: std.ArrayList(u8) = .empty;
+    defer explanation.deinit(gpu.gpa);
+    const failures = try limits.cuda(launch, usage, limits.target(120).?, &explanation, gpu.gpa);
+    var broken = launch;
+    broken.threads = 2048;
+    const red = try limits.cuda(broken, usage, limits.target(120).?, &explanation, gpu.gpa) > 0;
+    std.debug.print("SUMMARY BF16 prompt tail: {d} passed, {d} failed, {d} controls red, {d} missed; limits {d}, limit control {s}; regs {d}, static {d}, bound {d}, local {d}\n", .{ tally.passed, tally.failed, tally.caught, tally.missed, failures, if (red) "RED" else "MISSED", usage.regs, usage.static, usage.bound, usage.local });
+    try check_.expect(tally.problems() + failures == 0 and red and usage.regs == 249 and usage.local == 0, "BF16 prompt tail contract failed", .{});
+}
