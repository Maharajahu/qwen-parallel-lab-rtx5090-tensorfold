+        const cfg: cuda.Config = .{ .grid = .{ .x = @intCast((rows + tile - 1) / tile), .y = @intCast(g.q_heads / 2) }, .block = .{ .x = if (short) 128 else 256 }, .shared = if (short) 65536 else 98304 };
