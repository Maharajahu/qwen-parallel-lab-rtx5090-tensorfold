+// The 27B page-128 entry points use this fixed layout; other entries retain Fp8Tiles.
+template <int THREADS>
+struct Paged27Tiles {
+    static constexpr bool paged_layout = true;
+    static constexpr int PER = TK * 16 / THREADS;
+    TileStore s;
+    const unsigned char* head;
+    const int* ids;
+    size_t stride;
+    int scale_delta;
+    uint4 kr[PER], vr[PER];
+    float sr;
+    const unsigned char* near = nullptr;
+    int page = -1;
+    __device__ Paged27Tiles(TileStore store, const Seg& sg, int layer, int, int h) : s(store) {
+        head = reinterpret_cast<const unsigned char*>(sg.kv) + (size_t)layer * 2 * 4 * 128 * (HD + 4) + h * 128 * HD;
+        ids = reinterpret_cast<const int*>(sg.pt);
+        stride = sg.ps;
+        scale_delta = 2 * 4 * 128 * HD + h * 128 * 4 - h * 128 * HD;
+    }
+    __device__ const unsigned char* base(int pos) {
+        if (page != (pos >> 7)) { page = pos >> 7; near = head + (size_t)ids[page] * stride; }
+        return near;
+    }
+    __device__ const float* ksp(int pos) {
+        return reinterpret_cast<const float*>(base(pos) + scale_delta) + (pos & 127);
+    }
+    template <class Row>
+    __device__ void fetch(int t0, Row row) {
+        const int tid = threadIdx.x, part = tid & 15;
+#pragma unroll
+        for (int i = 0; i < PER; i++) {
+            const int r = row(t0 + (tid >> 4) + THREADS / 16 * i);
+            kr[i] = vr[i] = make_uint4(0u, 0u, 0u, 0u);
+            if (r >= 0) {
+                const unsigned char* k = base(r) + (r & 127) * HD + part * 16;
+                kr[i] = *reinterpret_cast<const uint4*>(k);
+                vr[i] = *reinterpret_cast<const uint4*>(k + 4 * 128 * HD);
+            }
+        }
+        const int r = row(t0 + (tid & 31));
+        sr = 0.0f;
+        if (tid < 64 && r >= 0) sr = *(ksp(r) + (tid < 32 ? 0 : 4 * 128));
+    }
+    __device__ void put(bool keys) {
+        const int tid = threadIdx.x, part = tid & 15;
+#pragma unroll
+        for (int i = 0; i < PER; i++) {
+            const int u = (tid >> 4) + THREADS / 16 * i;
+            if (keys) widen16_native(kr[i], &s.kt[swz(u, 2 * part)], &s.kt[swz(u, 2 * part + 1)]);
+            widen16_native(vr[i], &s.vt[swz(u, 2 * part)], &s.vt[swz(u, 2 * part + 1)]);
+        }
