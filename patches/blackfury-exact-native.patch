+    const int warp = tid >> 5;
+    const int lane = tid & 31;
+    const int g = lane >> 2;
+    const int qd = lane & 3;
+    const int m = static_cast<int>(blockIdx.x);
+    const int h = static_cast<int>(blockIdx.z);
+
+    // Use P[2] without reading unused per-row metadata.
+    int active_rows = total;
+    if (P != nullptr) active_rows = min(active_rows, P[2]);
