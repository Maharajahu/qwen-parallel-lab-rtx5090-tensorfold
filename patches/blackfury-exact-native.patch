+                for (int a = 0; a < MT; a++)
+#pragma unroll
+                    for (int j = 0; j < TK / 16; j++) {
+                        uint32_t pa4[4];
+                        qmm_frag::ldmatrix4(pa4, &pt[16 * a + lane % 16][16 * j + 8 * (lane / 16)]);
+#pragma unroll
+                        for (int n = 0; n < NT; n += 2) {
+                            uint32_t b[4];
+                            ldmatrix4t(b, vt + swz(16 * j + 8 * (mq % 2) + lane % 8, NT * warp + n + mq / 2));
