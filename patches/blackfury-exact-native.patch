+extern "C" __global__ void __launch_bounds__(256) tf_q35_attn_paired_merge(
+    Geo geo,const float* PM,const float* PL,const float* PO,const Seg* segs,
+    const int* rowseg,const Ancestor* rowanc,const int* P,__nv_bfloat16* OUT){
+    __shared__ float pm[64],pl[64],weights[64],maximum;
+    const int d=threadIdx.x,q=blockIdx.x,m=q/geo.qh;
+    if(past_rows(P,m))return;
