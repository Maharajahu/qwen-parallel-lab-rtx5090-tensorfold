+        for (int e = 0; e < 2; ++e) {
+            const int iq = 2 * qd + e;
+            if (iq < G) {
+                const size_t slot =
+                    ((size_t(m) * QH + h * G + iq) * MAXCH) + C;
+                PM[slot] = mx[e];
+                PL[slot] = sum[e];
+            }
+        }
+    }
+
+    // Warps own disjoint 64-dimensional regions, so PO has no races.
+#pragma unroll
+    for (int e = 0; e < 2; ++e) {
+        const int iq = 2 * qd + e;
+        if (iq < G) {
+            const size_t slot =
+                ((size_t(m) * QH + h * G + iq) * MAXCH) + C;
+
+#pragma unroll
+            for (int n = 0; n < 4; ++n) {
+                const int d = 16 * (4 * warp + n) + g;
+                PO[slot * HD + d] = out[n][e];
+                PO[slot * HD + d + 8] = out[n][2 + e];
+            }
+        }
+    }
+}
