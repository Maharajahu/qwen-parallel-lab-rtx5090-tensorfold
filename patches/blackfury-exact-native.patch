+                            qmm_frag::mma(o[a][n + 1], pa4, b[2], b[3]);
+                        }
+                    }
+            };
+            if (shared) values(-1);
+            else
+                for (int j = 0; j < RB; j++) {
+                    if (!(cls >> j & 1)) continue;
+                    __syncthreads();
+                    fetch(t0, j, false);
+                    tf_common::cp_wait<0>();
+                    __syncthreads();
+                    tiles.put(false);
+                    __syncthreads();
+                    values(j);
+                }
+            if (!shared && t0 + TK < kend && t0 + 2 * TK <= sg.len) fetch(t0 + TK, -1);
