diff --git a/zig/kernels/cuda/qwen35_attn_async.cuh b/zig/kernels/cuda/qwen35_attn_async.cuh
new file mode 100644
index 00000000..be6c22c5
--- /dev/null
+++ b/zig/kernels/cuda/qwen35_attn_async.cuh
@@ -0,0 +1,407 @@
+// Paged FP8 attention with asynchronous copies and aliased K/V staging.
+#pragma once
+
+namespace tf_q35_tc {
+
+template <int THREADS>
+struct Async27Tiles {
+    static constexpr bool paged_layout = true;
+    static constexpr int PER = TK * 16 / THREADS;
+    TileStore s;
+    uint4* raw;
+    const unsigned char* head;
+    const int* ids;
+    size_t stride;
+    int scale_delta;
+    const unsigned char* near = nullptr;
+    int page = -1;
+    __device__ Async27Tiles(TileStore store, uint4* staging, const Seg& sg, int layer, int, int h)
+        : s(store), raw(staging) {
+        head = reinterpret_cast<const unsigned char*>(sg.kv) + (size_t)layer * 2 * 4 * 128 * (HD + 4) + h * 128 * HD;
+        ids = reinterpret_cast<const int*>(sg.pt);
+        stride = sg.ps;
+        scale_delta = 2 * 4 * 128 * HD + h * 128 * 4 - h * 128 * HD;
+    }
+    __device__ const unsigned char* base(int pos) {
+        if (page != (pos >> 7)) { page = pos >> 7; near = head + (size_t)ids[page] * stride; }
+        return near;
+    }
+    __device__ const float* ksp(int pos) {
+        return reinterpret_cast<const float*>(base(pos) + scale_delta) + (pos & 127);
+    }
+    __device__ void shared_fetch(int t0, bool keys) {
+        const int tid = threadIdx.x, part = tid & 15;
+        const unsigned char* page_base = base(t0);
+        const unsigned char* p = page_base + (t0 & 127) * HD + (keys ? 0 : 4 * 128 * HD);
+#pragma unroll
+        for (int i = 0; i < PER; i++) {
+            const int u = (tid >> 4) + THREADS / 16 * i;
+            tf_common::cp16(raw + u * 16 + part, p + u * HD + part * 16);
+        }
+        if (tid < 32) {
+            const float* sc = reinterpret_cast<const float*>(page_base + scale_delta) + (t0 & 127);
+            tf_common::cp4((keys ? s.ksc : s.vsc) + tid, sc + tid + (keys ? 0 : 4 * 128));
+        }
+        tf_common::cp_commit();
+    }
+    template <class Row>
+    __device__ void fetch(int t0, Row row, bool keys) {
+        const int tid = threadIdx.x, part = tid & 15;
+#pragma unroll
+        for (int i = 0; i < PER; i++) {
+            const int u = (tid >> 4) + THREADS / 16 * i;
+            const int r = row(t0 + u);
+            const unsigned char* ptr = head;
+            if (r >= 0) ptr = base(r) + (r & 127) * HD + part * 16 + (keys ? 0 : 4 * 128 * HD);
+            tf_common::cp16z(raw + u * 16 + part, ptr, r >= 0);
+        }
+        if (tid < 32) {
+            const int r = row(t0 + tid);
+            float* dst = (keys ? s.ksc : s.vsc) + tid;
+            if (r >= 0) tf_common::cp4(dst, ksp(r) + (keys ? 0 : 4 * 128));
+            else *dst = 0.0f;
+        }
+        tf_common::cp_commit();
+    }
+    __device__ void put(bool) {
+        const int tid = threadIdx.x, part = tid & 31;
+#pragma unroll
+        for (int i = 0; i < TK * 32 / THREADS; i++) {
+            const int u = (tid >> 5) + THREADS / 32 * i;
+            const uint2 x = reinterpret_cast<const uint2*>(raw)[u * 32 + part];
+            const uint2 a = widen4_native(x.x), b = widen4_native(x.y);
+            s.kt[swz(u, part)] = make_uint4(a.x, a.y, b.x, b.y);
+        }
+    }
+    __device__ const uint4* keys() const { return s.kt; }
+    __device__ const uint4* values() const { return s.kt; }
+    __device__ float kscale(int u) const { return s.ksc[u]; }
+    __device__ float vscale(int u) const { return s.vsc[u]; }
+    __device__ float key_scale(int pos) { return *ksp(pos); }
+};
+
+// RB rows a block (MT m16 tiles of query heads); a stream's rows of one chunk width read each key tile once.
+template <int MT, class Tiles, int FixedQH = 0, int FixedKVH = 0>
+__device__ __forceinline__ void attn_rows_async(TileStore store, uint4* raw, Geo geo, const __nv_bfloat16* __restrict__ Q, const Seg* __restrict__ segs,
+                                                                      const int* __restrict__ rowseg, const Ancestor* __restrict__ rowanc, int layer,
+                                                                      const int* __restrict__ P, float scale, int total,
+                                                                      float* __restrict__ PM, float* __restrict__ PL, float* __restrict__ PO) {
+    constexpr int LINES = 16 * MT, WARPS = 2 * MT, NT = HD / 8 / WARPS;
+    __shared__ __align__(16) __nv_bfloat16 pt[LINES][TK + 8];
+    __shared__ float red[2][LINES], alpha[LINES];
+    __shared__ int r_k0[32], r_k1[32], r_seg[32], r_ck[32];
+    __shared__ Ancestor r_anc[32];
+    const int QH = FixedQH ? FixedQH : geo.qh, KVH = FixedKVH ? FixedKVH : geo.kvh;
+    const int G = QH / KVH, RB = LINES / G;
+    const int tid = threadIdx.x, warp = tid >> 5, lane = tid & 31, g = lane >> 2, qd = lane & 3;
+    const int c = blockIdx.y, h = blockIdx.z, m0 = blockIdx.x * RB;
+    if (c >= MAXCH) return;
+    // the group's rows of long streams (a short stream's rows are attn_one's)
+    if (tid < RB) {
+        const int m = m0 + tid;
+        r_seg[tid] = -1;
+        if (m < total && !past_rows(P, m) && segs[rowseg[m]].len >= GROUP_LEN) {
+            const Seg sg = segs[rowseg[m]];
+            const Ancestor anc = rowanc[m];
+            const int keys = sg.len + rows_seen(anc), ck = chunk_keys(keys);
+            r_seg[tid] = rowseg[m];
+            r_ck[tid] = ck;
+            r_k0[tid] = c * ck;
+            r_k1[tid] = min(c * ck + ck, keys);
+            r_anc[tid] = anc;
+        }
+    }
+    __syncthreads();
+    {
+        bool any = false;
+        for (int j = 0; j < RB; j++) any |= r_seg[j] >= 0;
+        if (!any) return;
+    }
+    // this warp's m16 tile (lines 16 mt on) and key half for the scores; its query fragments, zero past the rows
+    const int mt = warp >> 1, half = warp & 1;
+    __shared__ uint32_t qs[LINES][32];
+    uint32_t qa[12][4];
+    {
+        const int l0 = 16 * mt + g, l1 = l0 + 8;
+        const int j0 = l0 / G, j1 = l1 / G;
+        const bool in0 = j0 < RB && r_seg[j0] >= 0, in1 = j1 < RB && r_seg[j1] >= 0;
+        const uint32_t* q0 = reinterpret_cast<const uint32_t*>(Q + ((size_t)(m0 + j0) * QH + h * G + l0 % G) * HD);
+        const uint32_t* q1 = reinterpret_cast<const uint32_t*>(Q + ((size_t)(m0 + j1) * QH + h * G + l1 % G) * HD);
+#pragma unroll
+        for (int k = 0; k < HD / 16; k++) {
+            const uint32_t q0a = in0 ? q0[8 * k + qd] : 0u;
+            const uint32_t q1a = in1 ? q1[8 * k + qd] : 0u;
+            const uint32_t q0b = in0 ? q0[8 * k + qd + 4] : 0u;
+            const uint32_t q1b = in1 ? q1[8 * k + qd + 4] : 0u;
+            if (k < 4) {
+                if (half == 0) {
+                    qs[l0][(8 * k + qd) ^ ((l0 & 7) * 4)] = q0a;
+                    qs[l1][(8 * k + qd) ^ ((l1 & 7) * 4)] = q1a;
+                    qs[l0][(8 * k + qd + 4) ^ ((l0 & 7) * 4)] = q0b;
+                    qs[l1][(8 * k + qd + 4) ^ ((l1 & 7) * 4)] = q1b;
+                }
+            } else {
+                qa[k - 4][0] = q0a;
+                qa[k - 4][1] = q1a;
+                qa[k - 4][2] = q0b;
+                qa[k - 4][3] = q1b;
+            }
+        }
+    }
+    __syncthreads();
+    for (unsigned done = 0;;) {
+        // a class: the group's rows left of one stream and chunk width, so their chunk starts at one logical key
+        int lead = -1;
+        for (int j = 0; j < RB && lead < 0; j++)
+            if (r_seg[j] >= 0 && !(done >> j & 1)) lead = j;
+        if (lead < 0) break;
+        unsigned cls = 0;
+        int kend = 0;
+        for (int j = lead; j < RB; j++)
+            if (r_seg[j] == r_seg[lead] && r_ck[j] == r_ck[lead]) {
+                cls |= 1u << j;
+                kend = max(kend, r_k1[j]);
+            }
+        done |= cls;
+        const int k0 = r_k0[lead];
+        const Seg sg = segs[r_seg[lead]];
+        Tiles tiles = [&] {
+            if constexpr (Tiles::paged_layout) return Tiles(store, raw, sg, layer, KVH, h);
+            else return Tiles(store, sg, layer, KVH);
+        }();
+        // the cache position of logical key t for row j (-1: past its keys)
+        auto rowof = [&](int j, int t) -> int {
+            if (t >= r_k1[j]) return -1;
+            if constexpr (Tiles::paged_layout) return t < sg.len ? t : sg.len + seen_row(r_anc[j], t - sg.len);
+            else return h * sg.cap + (t < sg.len ? t : sg.len + seen_row(r_anc[j], t - sg.len));
+        };
+        // a tile's rows for row j (j < 0: a tile of stream keys only, shared by every row of the class)
+        auto fetch = [&](int t0, int j, bool keys = true) {
+            if (j < 0) { tiles.shared_fetch(t0, keys); return; }
+            tiles.fetch(t0, [&](int t) {
+                if constexpr (Tiles::paged_layout) return t >= kend ? -1 : j < 0 ? t : rowof(j, t);
+                else return t >= kend ? -1 : j < 0 ? h * sg.cap + t : rowof(j, t);
+            }, keys);
+        };
+        // scores of this warp's lines over its 16 keys of the tile staged last
+        auto scores = [&](float (&s)[2][4]) {
+            const uint4* kt = tiles.keys();
+#pragma unroll
+            for (int k = 0; k < HD / 16; k++) {
+                uint32_t q[4];
+                const int l0 = 16 * mt + g, l1 = l0 + 8;
+                if (k < 4) {
+                    q[0] = qs[l0][(8 * k + qd) ^ ((l0 & 7) * 4)];
+                    q[1] = qs[l1][(8 * k + qd) ^ ((l1 & 7) * 4)];
+                    q[2] = qs[l0][(8 * k + qd + 4) ^ ((l0 & 7) * 4)];
+                    q[3] = qs[l1][(8 * k + qd + 4) ^ ((l1 & 7) * 4)];
+                } else {
+#pragma unroll
+                    for (int e = 0; e < 4; e++) q[e] = qa[k - 4][e];
+                }
+                uint32_t b[4];
+                qmm_frag::ldmatrix4(b, kt + swz(16 * half + 8 * (lane >> 4) + lane % 8, 2 * k + (lane >> 3 & 1)));
+                if (k == 0) {
+                    qmm_frag::mma0(s[0], q, b[0], b[1]);
+                    qmm_frag::mma0(s[1], q, b[2], b[3]);
+                } else {
+                    qmm_frag::mma(s[0], q, b[0], b[1]);
+                    qmm_frag::mma(s[1], q, b[2], b[3]);
+                }
+            }
+        };
+        float o[MT][NT][4];
+#pragma unroll
+        for (int a = 0; a < MT; a++)
+#pragma unroll
+            for (int n = 0; n < NT; n++) o[a][n][0] = o[a][n][1] = o[a][n][2] = o[a][n][3] = 0.0f;
+        // running max and sum of this thread's two lines (g and g + 8 of tile mt)
+        const int la = 16 * mt + g, lb = la + 8, ja = la / G, jb = lb / G;
+        const bool ina = ja < RB && (cls >> ja & 1), inb = jb < RB && (cls >> jb & 1);
+        float mxa = -INFINITY, mxb = -INFINITY, sa = 0.0f, sb = 0.0f;
+        const bool shared0 = k0 + TK <= sg.len;
+        if (shared0) fetch(k0, -1);
+        for (int t0 = k0; t0 < kend; t0 += TK) {
+            const bool shared = t0 + TK <= sg.len;
+            float s[2][4];
+            if (shared) {
+                tf_common::cp_wait<0>();
+                __syncthreads();
+                tiles.put(true);
+                __syncthreads();
+                fetch(t0, -1, false);
+                scores(s);
+            } else {
+                // a tile holding window keys: each row of the class over its own keys, its lines kept
+                for (int j = 0; j < RB; j++) {
+                    if (!(cls >> j & 1)) continue;
+                    __syncthreads();
+                    fetch(t0, j);
+                    tf_common::cp_wait<0>();
+                    __syncthreads();
+                    tiles.put(true);
+                    __syncthreads();
+                    float x[2][4];
+                    scores(x);
+#pragma unroll
+                    for (int n = 0; n < 2; n++) {
+                        if (ja == j) { s[n][0] = x[n][0]; s[n][1] = x[n][1]; }
+                        if (jb == j) { s[n][2] = x[n][2]; s[n][3] = x[n][3]; }
+                    }
+                }
+                if (!ina) for (int n = 0; n < 2; n++) s[n][0] = s[n][1] = 0.0f;
+                if (!inb) for (int n = 0; n < 2; n++) s[n][2] = s[n][3] = 0.0f;
+            }
+            // scaled and masked: a key counts for a line while it is below the line's row's k1
+            float tma = -INFINITY, tmb = -INFINITY;
+#pragma unroll
+            for (int n = 0; n < 2; n++)
+#pragma unroll
+                for (int e = 0; e < 2; e++) {
+                    const int u = 16 * half + 8 * n + 2 * qd + e;
+                    const int t = t0 + u;
+                    float ka, kb;
+                    if (shared) {
+                        ka = kb = tiles.kscale(u);
+                    } else {
+                        const int ra = ina ? rowof(ja, t) : -1, rb = inb ? rowof(jb, t) : -1;
+                        ka = ra >= 0 ? tiles.key_scale(ra) : 0.0f;
+                        kb = rb >= 0 ? tiles.key_scale(rb) : 0.0f;
+                    }
+                    s[n][e] = ina && t < r_k1[ja] ? s[n][e] * ka * scale : -INFINITY;
+                    s[n][2 + e] = inb && t < r_k1[jb] ? s[n][2 + e] * kb * scale : -INFINITY;
+                    tma = fmaxf(tma, s[n][e]);
+                    tmb = fmaxf(tmb, s[n][2 + e]);
+                }
+            for (int x = 1; x <= 2; x *= 2) {
+                tma = fmaxf(tma, __shfl_xor_sync(0xffffffffu, tma, x));
+                tmb = fmaxf(tmb, __shfl_xor_sync(0xffffffffu, tmb, x));
+            }
+            if (qd == 0) {
+                red[half][la] = tma;
+                red[half][lb] = tmb;
+            }
+            if (shared) tf_common::cp_wait<0>();
+            __syncthreads();
+            if (shared) tiles.put(false);
+            tma = fmaxf(red[0][la], red[1][la]);
+            tmb = fmaxf(red[0][lb], red[1][lb]);
+            const bool acta = tma != -INFINITY, actb = tmb != -INFINITY;
+            const float na = acta ? fmaxf(mxa, tma) : mxa, nb = actb ? fmaxf(mxb, tmb) : mxb;
+            const float aa = acta ? (mxa == -INFINITY ? 0.0f : texp(mxa - na)) : 1.0f;
+            const float ab = actb ? (mxb == -INFINITY ? 0.0f : texp(mxb - nb)) : 1.0f;
+            float pa = 0.0f, pb = 0.0f;
+#pragma unroll
+            for (int n = 0; n < 2; n++)
