+    float acc=0.0f,lsum=0.0f;
+    for(int c=0;c<nch;++c){if(!(pl[c]>0.0f))continue;const float e=weights[c];
+        lsum=fmaf(pl[c],e,lsum);acc=fmaf(PO[(base+c)*256+d],e,acc);}
+    OUT[size_t(q)*256+d]=__float2bfloat16_rn(acc/lsum);
+}
