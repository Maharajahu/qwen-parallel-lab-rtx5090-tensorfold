--- /dev/null
+++ b/zig/src/cuda/qmmf_fp8_wide.zig
@@ -0,0 +1,42 @@
+//! Eight-warp FP8 decode tiles with unchanged packed words, K slices and per-output MMA order.
+const std = @import("std");
+const qmmf = @import("qmmf.zig");
+const module = @import("module.zig");
+
+pub const Fp8Wide = struct {
+    fns: [2][2]module.Function,
+
+    /// Explicit family opt-in after qualifying this tile on the current GPU.
+    pub fn load(mod: module.Module) !Fp8Wide {
+        var result: Fp8Wide = undefined;
+        inline for (.{ false, true }, 0..) |wide, oi| inline for (.{ false, true }, 0..) |cluster, ci| {
+            const name = std.fmt.comptimePrint(
+                "_ZN7tf_qmmf11qmmf_kernelILi1ELi16ELi64ELi1ELi8ELi4ELb{d}ELb{d}ELb0EEEvPK13__nv_bfloat16PKhS5_fPvPfiiiiiii",
+                .{ @intFromBool(wide), @intFromBool(cluster) },
+            );
+            const f = try mod.function(name);
+            try f.allowDynamicShared(qmmf.sharedBytes(.fp8, 16));
+            result.fns[oi][ci] = f;
+        };
+        return result;
+    }
+
+    pub fn eligible(rows: usize, w: qmmf.Weight) bool {
+        if (rows == 0 or rows > 16 or w.mode != .fp8) return false;
+        return (w.k == 5120 and (w.n == 6144 or w.n == 10240 or w.n == 12288)) or
+            (w.k == 6144 and w.n == 5120);
+    }
+};
+
+test "FP8 eight-warps keeps unsupported widths and formats on the original tile" {
+    var w: qmmf.Weight = .{ .mode = .fp8, .codes = 0, .scales = 0, .n = 10240, .k = 5120, .npad = 10240 };
+    for ([_]usize{ 1, 7, 16 }) |rows| try std.testing.expect(Fp8Wide.eligible(rows, w));
+    for ([_]usize{ 0, 17, 128 }) |rows| try std.testing.expect(!Fp8Wide.eligible(rows, w));
+    w.n = 1024;
+    try std.testing.expect(!Fp8Wide.eligible(16, w));
+    w.n = 5120;
+    w.k = 6144;
+    try std.testing.expect(Fp8Wide.eligible(16, w));
+    w.mode = .fp4;
+    try std.testing.expect(!Fp8Wide.eligible(16, w));
+}
