@@ -0,0 +1,65 @@
+//! Exact original attention arithmetic in a fixed prefix and growing causal tail.
+const std = @import("std");
+const cuda = @import("cuda");
+
+pub const Functions = struct {
+    prefix: cuda.Function,
+    tail: cuda.Function,
+    merge: cuda.Function,
+
+    pub fn load(mod: cuda.Module) !Functions {
+        const prefix = try mod.function("tf_q35_attn_paired_prefix");
+        const tail = try mod.function("tf_q35_attn_paired_tail");
+        try prefix.setAttribute(.preferred_shared_memory_carveout, 100);
+        try tail.setAttribute(.preferred_shared_memory_carveout, 100);
+        return .{ .prefix = prefix, .tail = tail, .merge = try mod.function("tf_q35_attn_paired_merge") };
+    }
+};
+
+pub const partial_slots = 10 * 24 * 64;
+
+pub fn use(rows: usize, segs: anytype) bool {
+    return rows >= 1 and rows <= 10 and segs.len == 1 and
+        segs[0].rows == @as(i32, @intCast(rows)) and segs[0].row0 == 0 and
+        segs[0].pt != 0 and segs[0].ptok == 128 and segs[0].len >= 129024 and
+        segs[0].len <= 131071 and segs[0].cap >= segs[0].len + segs[0].rows;
+}
+
+test "Qwen attention path: paired dispatch keys the actual rows and bounded causal tail before graph bucketing" {
+    const Seg = struct { rows: i32 = 9, row0: i32 = 0, pt: u64 = 1, ptok: i32 = 128, len: i32, cap: i32 = 131072 };
+    var s = [_]Seg{.{ .len = 129024 }};
+    for ([_]i32{ 129024, 129025, 129151, 129152, 130048, 131063 }) |n| {
+        s[0].len = n;
+        try std.testing.expect(use(9, &s));
+    }
+    for ([_]i32{ 129023, 131072 }) |n| {
+        s[0].len = n;
+        try std.testing.expect(!use(9, &s));
+    }
+    s[0].len = 129024;
+    for ([_]usize{ 0, 1, 8, 10, 11, 16 }) |rows| try std.testing.expect(!use(rows, &s));
+    try std.testing.expect(!use(9, @as([]const Seg, &.{})));
+    try std.testing.expect(!use(9, @as([]const Seg, &.{ s[0], s[0] })));
+    s[0].ptok = 64;
+    try std.testing.expect(!use(9, &s));
+    s[0].ptok = 128;
+    s[0].pt = 0;
+    try std.testing.expect(!use(9, &s));
+    s[0].pt = 1;
+    s[0].cap = 129032;
+    try std.testing.expect(!use(9, &s));
+    s[0].cap = 131072;
+    for (1..11) |rows| {
+        s[0].rows = @intCast(rows);
+        s[0].len = @intCast(131072 - rows);
+        try std.testing.expect(use(rows, &s));
+        s[0].len += 1;
+        try std.testing.expect(!use(rows, &s));
+    }
+    try std.testing.expect(partial_slots <= 128 * 24 * 64);
+    var shape = @import("cuda_shapes.zig").Shape.init(9, 1, true, false, 16);
+    try std.testing.expectEqual(@as(u16, 16), shape.total);
+    const key = shape.key();
+    shape.paired_attn = true;
+    try std.testing.expectEqual(@as(u32, 1) << 25, key ^ shape.key());
+}
