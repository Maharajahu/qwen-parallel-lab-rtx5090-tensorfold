+extern "C" __global__ void __launch_bounds__(128, 1) tf_q35_attn_paired_tail(
+    Geo geo,
+    const __nv_bfloat16* __restrict__ Q,
+    const Seg* __restrict__ segs,
+    const int* __restrict__ rowseg,
+    const Ancestor* __restrict__ rowanc,
+    int layer,
+    const int* __restrict__ P,
+    float scale,
+    int total,
+    float* __restrict__ PM,
+    float* __restrict__ PL,
+    float* __restrict__ PO) {
+    using namespace tf_q35;
+    using namespace tf_q35_tc;
+
+    static_assert(HD == 256, "tf_q35_attn_paired_tail requires HD=256");
+    static_assert(TK == 32, "tf_q35_attn_paired_tail requires 32-key tiles");
+    static_assert(CH == 32, "tf_q35_attn_paired_tail requires HD/8=32");
+
+    constexpr int QH = 24;
+    constexpr int KVH = 4;
+    constexpr int G = QH / KVH;       // Six queries per KV head.
+    constexpr int C = 63;
+    constexpr int K0 = C * 2048;      // 129024.
+    constexpr unsigned FULL = 0xffffffffu;
+
+    __shared__ __align__(16) uint4 kt[TK * CH];
+    __shared__ __align__(16) uint4 vt[TK * CH];
+    __shared__ float ksc[TK];
+    __shared__ float vsc[TK];
