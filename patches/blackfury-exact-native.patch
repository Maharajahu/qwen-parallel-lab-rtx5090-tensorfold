+                    o[a][n][1] *= a0;
+                    o[a][n][2] *= a1;
+                    o[a][n][3] *= a1;
+                }
+            }
+            auto values = [&](int only) {
+                // pt: this warp's p times each key's value scale, lines of row `only` (-1: all), others zero
+#pragma unroll
+                for (int n = 0; n < 2; n++)
+#pragma unroll
