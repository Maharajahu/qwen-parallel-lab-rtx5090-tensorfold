+                        pt[lb][u] = __float2bfloat16_rn(wb ? s[n][2 + e] * tiles.vscale(u) : 0.0f);
+                    }
+                __syncthreads();
+                const int mq = lane >> 3;
+                const uint4* vt = tiles.values();
