+                    *reinterpret_cast<float2*>(PO + (((size_t)(m0 + j1) * QH + h * G + l1 % G) * MAXCH + c) * HD + d) = make_float2(o[a][n][2], o[a][n][3]);
+            }
+        }
+        __syncthreads();
+    }
+}
+
+
+}  // namespace tf_q35_tc
diff --git a/zig/kernels/cuda/qwen35_attn_paired.cuh b/zig/kernels/cuda/qwen35_attn_paired.cuh
new file mode 100644
index 00000000..cc2b8b66
--- /dev/null
+++ b/zig/kernels/cuda/qwen35_attn_paired.cuh
@@ -0,0 +1,84 @@
+#pragma once
+namespace tf_q35_tc {
+// One allocation shared by both compile-time group specializations.
+struct __align__(16) PairedStaticShared {
+    uint4 kt[2][TK * CH], raw[2][TK * 16];
+    __align__(16) float ksc[2][64];
+    uint2 qs[16][256];
+    unsigned long long barriers[2];
+};
+
+__device__ __forceinline__ PairedStaticShared& paired_static_storage() {
+    __shared__ PairedStaticShared storage;
+    return storage;
+}
+
+template <int GROUP>
+__device__ __forceinline__ void paired_static_sync() {
+    static_assert(GROUP == 0 || GROUP == 1, "two eight-warp groups");
+    asm volatile("bar.sync %0, 256;"::"n"(GROUP + 1):"memory");
+}
+
+template <int GROUP>
+struct PairedStaticTiles {
+    static constexpr int THREADS = 256;
+    static constexpr bool paged_layout = true;
+    static constexpr int PER = TK * 16 / THREADS;
+    TileStore s;
+    uint4* raw;
+    unsigned mb, phase=0;
+    const unsigned char* head;
+    const int* ids;
+    size_t stride;
+    int scale_delta;
+    int code_delta;
+    __device__ PairedStaticTiles(TileStore store, uint4* staging, unsigned long long* barrier, const Seg& sg, int layer, int h)
+        : s(store), raw(staging) {
+        mb=tf_common::smem(barrier);
+        head = reinterpret_cast<const unsigned char*>(sg.kv) + (size_t)layer * 2 * 4 * 128 * (HD + 4);
+        ids = reinterpret_cast<const int*>(sg.pt);
+        stride = sg.ps;
+        scale_delta = 2 * 4 * 128 * HD + h * 128 * 4; code_delta=h*128*HD;
+    }
+    __device__ const unsigned char* base(int pos) {
+        return head + (size_t)ids[pos >> 7] * stride;
+    }
+    __device__ const float* ksp(int pos) {
+        return reinterpret_cast<const float*>(base(pos) + scale_delta) + (pos & 127);
+    }
+    __device__ void shared_fetch(int t0,bool keys){
+        if(threadIdx.x==GROUP*256){
+            const auto pg=base(t0);
+            const auto p=pg+code_delta+(t0&127)*HD+(keys?0:4*128*HD);
+            const auto sc=reinterpret_cast<const float*>(pg+scale_delta)+(t0&127)+(keys?0:512);
+            const unsigned dest=tf_common::smem(raw), scales=tf_common::smem((keys?s.ksc:s.vsc)+(t0&32));
+            asm volatile("mbarrier.arrive.expect_tx.shared::cta.b64 _, [%0], 8320;"::"r"(mb):"memory");
+            asm volatile("cp.async.bulk.shared::cta.global.mbarrier::complete_tx::bytes [%0], [%1], 8192, [%2];"::"r"(dest),"l"(p),"r"(mb):"memory");
+            asm volatile("cp.async.bulk.shared::cta.global.mbarrier::complete_tx::bytes [%0], [%1], 128, [%2];"::"r"(scales),"l"(sc),"r"(mb):"memory");
+        }
+    }
+    __device__ void wait(){
+
+        asm volatile("{ .reg .pred p; wait_loop: mbarrier.try_wait.parity.shared::cta.b64 p, [%0], %1; @!p bra wait_loop; }"::"r"(mb),"r"(phase):"memory");
+
+        phase^=1;
+    }
+    __device__ void put(bool) {
+        const unsigned tid=threadIdx.x-GROUP*256;
+        #pragma unroll
+        for(int v=tid;v<TK*32;v+=THREADS){
+          int u=v/32,part=v%32;
+          const uint2 z=reinterpret_cast<const uint2*>(raw)[v];
+          const uint2 a=widen4_native(z.x),b=widen4_native(z.y);
+          s.kt[swz(u,part)]=make_uint4(a.x,a.y,b.x,b.y);
+        }
+    }
+    __device__ const uint4* keys() const { return s.kt; }
+    __device__ const uint4* values() const { return s.kt; }
+    __device__ float kscale(int u) const { return s.ksc[u]; }
+    __device__ float vscale(int u) const { return s.vsc[u]; }
+    __device__ float key_scale(int pos) { return *ksp(pos); }
+};
+
+
+}
