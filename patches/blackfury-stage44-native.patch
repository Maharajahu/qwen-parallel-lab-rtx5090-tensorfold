+//! Prompt-state fault tests live apart from the production reuse implementation.
+const std = @import("std");
+const cuda = @import("cuda");
+const lanes = @import("lanes");
+const geometry = @import("cuda_geometry.zig");
+const engine = @import("cuda_engine.zig");
+const reuse = @import("cuda_reuse.zig");
+
+const Engine = engine.Engine;
+const Cache = engine.Cache;
+const Geometry = geometry.Geometry;
+const Copy = reuse.Copy;
+const Layout = reuse.Layout;
+const Seen = reuse.Seen;
+const Target = reuse.Target;
+
+fn testGeometry(layers: usize, attention_every: usize, kv_heads: usize) Geometry {
+    var g: Geometry = undefined;
+    g.hidden = 5120;
+    g.k_heads = 16;
+    g.v_heads = 48;
+    g.q_heads = 32;
+    g.kv_heads = kv_heads;
+    g.layers = layers;
+    @memset(&g.linear, false);
+    for (0..layers) |i| g.linear[i] = i % attention_every != attention_every - 1;
+    return g;
+}
+
+test "Qwen engine safety: a restore preflight refusal keeps the engine healthy" {
+    var e: Engine = undefined;
+    e.health = .{};
+    e.kit = null;
+    e.g = testGeometry(8, 4, 4);
+    if (comptime @hasField(Engine, "kv8")) e.kv8 = false;
+    var cache: Cache = undefined;
+    cache.cap = 64;
+    cache.paged = null;
+    const d: u64 = 9;
+    var images = [_]Seen{.{ .at = 2, .id = d }};
+    const l: Layout = .{ .g = e.g, .format = .bf16, .cap = 64, .at = 10 };
+    const host = try std.testing.allocator.alignedAlloc(u8, .@"16", @intCast(l.total()));
+    defer std.testing.allocator.free(host);
+    var copy: Copy = .{ .host = .{ .d = undefined, .bytes = host }, .len = l.total(), .at = 10, .delta = 0, .format = .bf16, .images = &images };
+    const same = [_]Seen{.{ .at = 2, .id = d }};
+    try std.testing.expect(reuse.restorable(&e, &cache, &copy, &same));
+    try std.testing.expect(!reuse.restorable(&e, &cache, &copy, &.{.{ .at = 2, .id = 8 }}));
+    copy.format = .fp8;
+    try std.testing.expect(!reuse.restorable(&e, &cache, &copy, &same));
+    try std.testing.expectError(error.KeptCacheFormat, reuse.restoreCache(&e, &cache, &copy, &same));
+    try std.testing.expect(e.healthy());
+    copy.format = .bf16;
+    copy.len -= 1;
+    try std.testing.expect(!reuse.restorable(&e, &cache, &copy, &same));
+    try std.testing.expectError(error.BadReuse, reuse.restoreCache(&e, &cache, &copy, &same));
+    try std.testing.expect(e.healthy());
+    copy.len += 1;
+    cache.cap = 10;
+    try std.testing.expect(!reuse.restorable(&e, &cache, &copy, &same));
+    try std.testing.expectError(error.BadReuse, reuse.restoreCache(&e, &cache, &copy, &same));
+    try std.testing.expect(e.healthy());
+}
+
+const RestoreFake = struct {
+    var copies: usize = 0;
+    var fail_at: usize = 1;
+    var stuck = true;
+    var pending = false;
+    var context_proofs: usize = 0;
+    var freed: usize = 0;
+
+    fn htod(_: cuda.abi.DevicePtr, _: ?*const anyopaque, _: usize, _: cuda.abi.Stream) callconv(.c) cuda.abi.Result {
+        copies += 1;
+        pending = true;
+        return if (copies - 1 >= fail_at) cuda.abi.error_not_ready else cuda.abi.success;
+    }
+    fn sync(_: cuda.abi.Stream) callconv(.c) cuda.abi.Result {
+        if (stuck) return cuda.abi.error_not_ready;
+        pending = false;
+        return cuda.abi.success;
+    }
+    fn context() callconv(.c) cuda.abi.Result {
+        context_proofs += 1;
+        pending = false;
+        stuck = false;
+        return cuda.abi.success;
+    }
+    fn hostAlloc(p: *?*anyopaque, len: usize, _: c_uint) callconv(.c) cuda.abi.Result {
+        p.* = (std.testing.allocator.alignedAlloc(u8, .@"16", len) catch return 2).ptr;
+        return cuda.abi.success;
+    }
+    fn freeHost(_: ?*anyopaque) callconv(.c) cuda.abi.Result {
+        freed += 1;
+        return cuda.abi.success;
+    }
+};
+
+test "Qwen engine safety: a failed restore poisons its engine and proves completion before its host copy is dropped" {
+    const log_level = std.testing.log_level;
+    std.testing.log_level = .err;
+    defer std.testing.log_level = log_level;
+    var api: cuda.abi.Api = undefined;
+    api.cuMemcpyHtoDAsync_v2 = RestoreFake.htod;
+    api.cuStreamSynchronize = RestoreFake.sync;
+    api.cuCtxSynchronize = RestoreFake.context;
+    api.cuMemHostAlloc = RestoreFake.hostAlloc;
+    api.cuMemFreeHost = RestoreFake.freeHost;
+    const d: cuda.Driver = .{ .lib = undefined, .api = api };
+    for ([_]bool{ false, true }) |stream_stuck| {
+        var e: Engine = undefined;
+        e.health = .{};
+        e.kit = null;
+        e.gpa = std.testing.allocator;
+        e.d = &d;
+        e.g = testGeometry(8, 4, 4);
+        e.stream = .{ .d = &d, .handle = null };
+        if (comptime @hasField(Engine, "kv8")) e.kv8 = false;
+        var cache: Cache = undefined;
+        cache.cap = 64;
+        cache.len = 7;
+        cache.written = 6;
+        cache.last = null;
+        cache.pend = 3;
+        cache.delta = 4;
+        cache.paged = null;
+        cache.kv = .{ .d = &d, .ptr = 0x10000, .len = 0 };
+        cache.state = .{ .d = &d, .ptr = 0x20000, .len = 0 };
+        const l: Layout = .{ .g = e.g, .format = .bf16, .cap = 64, .at = 10 };
+        RestoreFake.copies = 0;
+        RestoreFake.freed = 0;
+        RestoreFake.pending = false;
+        RestoreFake.context_proofs = 0;
+        RestoreFake.stuck = stream_stuck;
+        const copy = try std.testing.allocator.create(Copy);
+        copy.* = .{ .host = try cuda.HostBuffer.alloc(&d, @intCast(l.total())), .len = l.total(), .at = 10, .delta = 0, .format = .bf16, .images = try std.testing.allocator.alloc(Seen, 0) };
+        const pinned = copy.host.bytes;
+        defer std.testing.allocator.free(pinned);
+        try std.testing.expectError(error.NotReady, reuse.restoreCache(&e, &cache, copy, &.{}));
+        try std.testing.expect(!e.healthy());
+        try std.testing.expect(!copy.reading);
+        try std.testing.expectEqual(@as(usize, 2), RestoreFake.copies);
+        try std.testing.expectEqual(@as(usize, @intFromBool(stream_stuck)), RestoreFake.context_proofs);
+        try std.testing.expect(!RestoreFake.pending);
+        try std.testing.expectEqual(@as(usize, 7), cache.len);
+        try std.testing.expectEqual(@as(usize, 6), cache.written);
+        try std.testing.expect(cache.last == null);
+        try std.testing.expectEqual(@as(c_int, 3), cache.pend);
+        try std.testing.expectEqual(@as(i32, 4), cache.delta);
+        try std.testing.expectError(error.QwenEnginePoisoned, reuse.restoreCache(&e, &cache, copy, &.{}));
+        try std.testing.expectEqual(@as(usize, 2), RestoreFake.copies);
+        const before = cuda.copy_source.retained();
+        reuse.dropCopy(&e, copy);
+        try std.testing.expectEqual(@as(usize, 1), RestoreFake.freed);
+        try std.testing.expectEqual(before, cuda.copy_source.retained());
+    }
+}
+
+const DeviceFake = struct {
+    var allocs: usize = 0;
+    var pinned: usize = 0;
+    var frees: usize = 0;
+    var dtod: usize = 0;
+    var host_copies: usize = 0;
+    var fail_copy: ?usize = null;
+
+    fn alloc(p: *cuda.abi.DevicePtr, _: usize) callconv(.c) cuda.abi.Result {
+        allocs += 1;
+        p.* = 0x40000;
+        return cuda.abi.success;
+    }
+    fn free(_: cuda.abi.DevicePtr) callconv(.c) cuda.abi.Result {
+        frees += 1;
+        return cuda.abi.success;
+    }
+    fn hostAlloc(_: *?*anyopaque, _: usize, _: c_uint) callconv(.c) cuda.abi.Result {
+        pinned += 1;
+        return cuda.abi.error_not_ready;
+    }
+    fn copy(_: cuda.abi.DevicePtr, _: cuda.abi.DevicePtr, _: usize, _: cuda.abi.Stream) callconv(.c) cuda.abi.Result {
+        const i = dtod;
+        dtod += 1;
+        return if (fail_copy == i) cuda.abi.error_not_ready else cuda.abi.success;
+    }
+    fn htod(_: cuda.abi.DevicePtr, _: ?*const anyopaque, _: usize, _: cuda.abi.Stream) callconv(.c) cuda.abi.Result {
+        host_copies += 1;
+        return cuda.abi.success;
+    }
+    fn dtoh(_: ?*anyopaque, _: cuda.abi.DevicePtr, _: usize, _: cuda.abi.Stream) callconv(.c) cuda.abi.Result {
+        host_copies += 1;
+        return cuda.abi.success;
+    }
+    fn sync(_: cuda.abi.Stream) callconv(.c) cuda.abi.Result {
+        return cuda.abi.success;
+    }
+};
