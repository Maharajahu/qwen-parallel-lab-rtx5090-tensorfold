+    for ([_]usize{ 9, 10, 1, 8, 9, 10, 11, 16, 10, 9 }) |rows| {
+        segs[0].rows = @intCast(rows);
+        var exact = Shape.init(rows, 1, true, false, 16);
+        exact.mt2 = true;
+        selectSpecialized(&exact, mt2, rows, &segs, false);
+        var packed_shape = exact;
