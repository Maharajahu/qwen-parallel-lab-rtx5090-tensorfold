-/// A `.range` setting's lo and hi, or null when unset or blank.
-pub fn range(name: [:0]const u8, raw: ?[]const u8) Error!?[2]u32 {
-    const n = (try checked(name, raw)) orelse return null;
-    return .{ @intCast(n >> 32), @truncate(n) };
-}
