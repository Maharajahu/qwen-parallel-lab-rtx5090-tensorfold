+//! Native-A4 receipts cover sm120a on sm120; outside all_cuda because min_sm would admit unqualified sm121.
+const std = @import("std");
+const limits = @import("limits.zig");
+pub const sm: u32 = 120;
+pub const Record = struct { launch: limits.CudaLaunch, usage: limits.Usage };
+
+// cuFuncGetAttribute: LAB/candidates/fp4-kernel/driver-attributes.json; static shared=0 excludes reserved 1 KiB.
+pub const records = [_]Record{
+    .{ .launch = .{ .name = "nativeA4 sm120 quantize", .symbol = "tf_nvfp4_quantize", .image = "nvfp4_dense", .threads = 128 }, .usage = .{ .regs = 36, .static = 0, .bound = 128, .local = 0 } },
+    .{ .launch = .{ .name = "nativeA4 sm120 pack words", .symbol = "tf_nvfp4_pack_words", .image = "nvfp4_dense", .threads = 256 }, .usage = .{ .regs = 14, .static = 0, .bound = 256, .local = 0 } },
+    .{ .launch = .{ .name = "nativeA4 sm120 dense partial", .symbol = "tf_nvfp4_dense_partial", .image = "nvfp4_dense", .threads = 128, .dynamic = 23040 }, .usage = .{ .regs = 70, .static = 0, .bound = 128, .local = 0 } },
+    .{ .launch = .{ .name = "nativeA4 sm120 dense ordered reduce", .symbol = "tf_nvfp4_dense_reduce", .image = "nvfp4_dense", .threads = 256 }, .usage = .{ .regs = 40, .static = 0, .bound = 256, .local = 0 } },
+};
+
+test "native A4 recorded launches fit only their measured sm120 scope" {
+    const a = std.testing.allocator;
+    var out: std.ArrayList(u8) = .empty;
+    defer out.deinit(a);
+    const target = limits.target(sm).?;
+    for (records) |r| try std.testing.expectEqual(@as(usize, 0), try limits.cuda(r.launch, r.usage, target, &out, a));
+}
