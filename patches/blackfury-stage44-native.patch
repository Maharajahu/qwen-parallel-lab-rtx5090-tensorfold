+//! One stream-ordered BF16 view of FP8 prompt keys; scratch shares the attention phase's arena ownership.
+const std = @import("std");
+const cuda = @import("cuda");
+const geometry = @import("cuda_geometry.zig");
+const Seg = @import("cuda_cache.zig").Seg;
+
+pub const State = struct {
+    cap: usize = 0,
+    ptr: u64 = 0,
+    kernel: cuda.Function = undefined,
+    tail: cuda.Function = undefined,
+
+    pub fn init(ctx: *const cuda.Context, g: geometry.Geometry, kv8: bool, context: usize) !State {
+        if (!kv8 or !g.kinds.modelopt or !geometry.dense27(g)) return .{};
+        if (try ctx.attribute(.compute_capability_major) != 12 or
+            try ctx.attribute(.compute_capability_minor) != 0 or
+            try ctx.attribute(.multiprocessor_count) != 170) return .{};
+        return .{ .cap = @min(context, 131072) };
+    }
+
+    pub fn bytes(s: State, heads: usize) usize {
+        return s.cap * heads * geometry.head_dim * 4;
+    }
+
+    pub fn resolve(s: *State, mod: cuda.Module) !void {
+        if (s.cap == 0) return;
+        s.kernel = try mod.function("tf_prefill_expand8");
+        s.tail = try mod.function("_ZN20tf_prefill_attention19hpattn_whole_kernelILi256ELi4ELi2ELi2EEEvPK13__nv_bfloat16S3_S3_PS1_iiiiifi");
+        try s.tail.allowDynamicShared(65536);
+    }
+
+    pub fn eligible(s: State, kv8: bool, sg: Seg, rows: usize) bool {
+        if (!kv8 or s.cap == 0 or sg.pt == 0 or sg.ptok != 128 or sg.len < 0 or rows < 128) return false;
+        const cached: usize = @intCast(sg.len);
+        return cached <= s.cap and rows <= s.cap - cached;
+    }
+
+    pub fn run(s: State, e: anytype, sg: Seg, layer: usize, from: usize, rows: usize) !void {
+        const g = e.g;
+        const slab = g.kv_heads * @as(usize, @intCast(sg.ptok));
+        const keys = sg.kv + layer * 2 * slab * (geometry.head_dim + 4);
+        const values = keys + slab * geometry.head_dim;
+        const kscale = values + slab * geometry.head_dim;
+        const bvalues = s.ptr + s.bytes(g.kv_heads) / 2;
+        const len = @as(usize, @intCast(sg.len)) + rows;
+        var expand: cuda.Args = .{};
+        for ([_]u64{ keys, values, kscale, kscale + slab * 4, s.ptr, bvalues, sg.pt }) |v| expand.add(v);
+        expand.add(@as(i64, @intCast(sg.ps)));
+        expand.add(@as(c_int, @intCast(len)));
+        expand.add(@as(c_int, @intCast(s.cap)));
+        try cuda.launch.launch(s.kernel, .{ .grid = .{ .x = @intCast((len + 1) / 2), .y = @intCast(g.kv_heads) }, .block = .{ .x = 256 } }, e.stream, &expand);
+        var a: cuda.Args = .{};
+        const at = from * g.q_heads * geometry.head_dim * 2;
+        for ([_]u64{ e.qn + at, s.ptr, bvalues, e.y + at }) |v| a.add(v);
+        for ([_]usize{ @intCast(sg.len), rows, g.q_heads, g.kv_heads, g.q_heads / g.kv_heads }) |v| a.add(@as(c_int, @intCast(v)));
+        a.add(@as(f32, 1.0 / 16.0));
+        a.add(@as(c_int, @intCast(s.cap)));
+        const short = tailEligible(rows, @intCast(sg.len));
+        const tile: usize = if (short) 32 else 64;
+        const cfg: cuda.Config = .{ .grid = .{ .x = @intCast((rows + tile - 1) / tile), .y = @intCast(g.q_heads / 2) }, .block = .{ .x = if (short) 128 else 256 }, .shared = if (short) 65536 else 98304 };
+        try cuda.launch.launch(if (short) s.tail else e.prompt_attn.bf16_whole, cfg, e.stream, &a);
+    }
+};
+
+pub fn tailEligible(rows: usize, cached: usize) bool {
+    return (rows == 128 or rows == 2048) and cached >= 8192;
+}
+
+test "expanded prompt tail selects only qualified long-context chunks" {
+    try std.testing.expect(tailEligible(128, 8192));
+    try std.testing.expect(tailEligible(128, 130944));
+    try std.testing.expect(!tailEligible(128, 8191));
+    try std.testing.expect(tailEligible(2048, 8192));
+    try std.testing.expect(tailEligible(2048, 129024));
+    try std.testing.expect(!tailEligible(2048, 8191));
+    for ([_]usize{ 0, 1, 32, 64, 127, 129, 2047, 2049, 4096 }) |rows|
+        try std.testing.expect(!tailEligible(rows, 130944));
+}
+
+test "expanded prompt keeps page, dtype and arena capacity boundaries" {
+    const t = std.testing;
+    const s: State = .{ .cap = 131072 };
+    var sg: Seg = std.mem.zeroes(Seg);
+    sg.pt = 256;
+    sg.ptok = 128;
+    sg.len = 130944;
+    try t.expect(s.eligible(true, sg, 128));
+    try t.expect(!s.eligible(true, sg, 129));
+    try t.expect(!s.eligible(true, sg, 127));
+    try t.expect(!s.eligible(false, sg, 128));
+    try t.expect(!(@as(State, .{})).eligible(true, sg, 128));
+    try t.expectEqual(@as(usize, 512 * 1024 * 1024), s.bytes(4));
+    sg.len = 0;
+    try t.expect(s.eligible(true, sg, 4096));
+    sg.ptok = 256;
+    try t.expect(!s.eligible(true, sg, 4096));
+    sg.ptok = 128;
+    sg.pt = 0;
+    try t.expect(!s.eligible(true, sg, 4096));
+}
