diff --git a/zig/src/families/qwen3_5/cuda_fidelity.zig b/zig/src/families/qwen3_5/cuda_fidelity.zig
new file mode 100644
index 00000000..f5eb6fc3
--- /dev/null
+++ b/zig/src/families/qwen3_5/cuda_fidelity.zig
@@ -0,0 +1,279 @@
+//! Opt-in same-state attention diagnostics; the candidate alone continues the model trajectory.
+const std = @import("std");
+const cuda = @import("cuda");
+const E = @import("cuda_engine.zig");
+const prefix = @import("cuda_prefix1645.zig");
+const rows_max = 10;
+const physical_rows = 10;
+const heads = 24;
+const dims = 256;
+const slots = physical_rows * heads * 64;
+const stat_bytes = slots * 4;
+const po_bytes = slots * dims * 4;
+const y_bytes = physical_rows * heads * dims * 2;
+const device_bytes = 2 * stat_bytes + po_bytes + y_bytes;
+const Tensor = struct { dtype: []const u8, shape: []const usize, path: []const u8 };
+const Raw = struct { pm: Tensor, pl: Tensor, po: Tensor };
+const Exact = struct { pm: Tensor, pl: Tensor, po: Tensor, tail: Raw };
+const Candidate = struct { output: Tensor, lse: Tensor, tail: Raw };
+var active: std.atomic.Value(usize) = .init(0);
+
+/// The diagnostic CLI admits one engine; inert host fixtures never read an uninitialized Engine field.
+pub fn get(e: *const E.Engine) ?*State {
+    const address = active.load(.acquire);
+    if (address == 0) return null;
+    const s: *State = @ptrFromInt(address);
+    return if (s.owner == e) s else null;
+}
+
+pub const State = struct {
+    owner: *E.Engine,
+    gpa: std.mem.Allocator,
+    io: std.Io,
+    dir: std.Io.Dir,
+    exact: cuda.DeviceBuffer,
+    host: cuda.HostBuffer,
+    unpacked: []u8,
+    forward_id: u64 = 0,
+    position: usize = 0,
+    rows: usize = 0,
+    scans: u64 = 0,
+    detailed: bool = false,
+    qn_hash: [64]u8 = undefined,
+
+    pub fn deinit(s: *State) void {
+        active.store(0, .release);
+        s.dir.close(s.io);
+        s.host.free();
+        s.exact.free();
+        s.gpa.free(s.unpacked);
+        const gpa = s.gpa;
+        gpa.destroy(s);
+    }
+
+    pub fn begin(s: *State, position: usize, rows: usize) void {
+        s.forward_id += 1;
+        s.position = position;
+        s.rows = rows;
+    }
+
+    fn pm(s: *const State) u64 {
+        return s.exact.ptr;
+    }
+
+    fn pl(s: *const State) u64 {
+        return s.pm() + stat_bytes;
+    }
+
+    fn po(s: *const State) u64 {
+        return s.pl() + stat_bytes;
+    }
+
+    fn y(s: *const State) u64 {
+        return s.po() + po_bytes;
+    }
+
+    /// Both launch sets read the same qn/Seg/ancestor tables, after the layer's single KV write.
+    pub fn shadow(s: *State, e: *E.Engine, segs: u64, rows: u64, anc: u64, layer: c_int, params: u64) !void {
+        if (s.rows == 0 or s.rows > rows_max) return error.FidelityUnsupportedRows;
+        const pair = e.mt2.paired orelse return error.FidelityNeedsPairedExact;
+        const args = .{ e.geo, e.qn, segs, rows, anc, layer, params, @as(f32, 1.0 / 16.0), @as(c_int, 10), s.pm(), s.pl(), s.po() };
+        try e.run(pair.prefix, .{ 2, 21, 4 }, .{ 384, 1, 1 }, args);
+        try e.run(pair.tail, .{ 10, 1, 4 }, .{ 128, 1, 1 }, args);
+        try e.run(pair.merge, .{ 240, 1, 1 }, .{ 256, 1, 1 }, .{ e.geo, s.pm(), s.pl(), s.po(), segs, rows, anc, params, s.y() });
+        try e.stream.synchronize();
+        const qn = try s.read(e, e.qn, s.rows * heads * dims * 2);
+        try finite(qn, 2);
+        s.qn_hash = digest(qn);
+    }
+
+    fn read(s: *State, e: *E.Engine, ptr: u64, bytes: usize) ![]const u8 {
+        if (bytes > s.host.bytes.len) return error.FidelityBufferBounds;
+        const out = s.host.bytes[0..bytes];
+        try e.d.check(e.d.api.cuMemcpyDtoH_v2(out.ptr, ptr, bytes), "fidelity readback");
+        return out;
+    }
+
+    /// Writes no quality verdict; byte inequality only selects the first detailed localization capture.
+    pub fn capture(s: *State, e: *E.Engine, layer: usize, attention: c_int) !void {
+        try e.stream.synchronize();
+        const bytes = s.rows * heads * dims * 2;
+        const qn = digest(try s.read(e, e.qn, bytes));
+        if (!std.mem.eql(u8, &s.qn_hash, &qn)) return error.FidelityQueryChanged;
+        const exact_y = try s.read(e, s.y(), bytes);
+        try finite(exact_y, 2);
+        @memcpy(s.unpacked[0..bytes], exact_y);
+        const candidate_y = try s.read(e, e.y, bytes);
+        try finite(candidate_y, 2);
+        const different = !std.mem.eql(u8, s.unpacked[0..bytes], candidate_y);
+        const reference_hash = digest(s.unpacked[0..bytes]);
+        const candidate_hash = digest(candidate_y);
+        var arena = std.heap.ArenaAllocator.init(s.gpa);
+        defer arena.deinit();
+        const a = arena.allocator();
+        const id = try std.fmt.allocPrint(a, "f{d}-p{d}-l{d}", .{ s.forward_id, s.position, layer });
+        const first_detail = different and !s.detailed;
+        if (first_detail) try s.detail(e, a, id);
+        const scan = .{
+            .schema = "stage25.fidelity.scan",
+            .version = @as(u32, 1),
+            .same_state_id = id,
+            .identity_source = "single_forward_same_qn_seg_before_candidate",
+            .publication = "precommit",
+            .position = s.position,
+            .rows = s.rows,
+            .layer = layer,
+            .attention = attention,
+            .qn_sha256 = qn[0..],
+            .exact_y_sha256 = reference_hash[0..],
+            .candidate_y_sha256 = candidate_hash[0..],
+            .y_bytes_equal = !different,
+            .first_detail = first_detail,
+        };
+        try s.json(a, try std.fmt.allocPrint(a, "{s}-scan.json", .{id}), scan);
+        s.scans += 1;
+        if (first_detail) s.detailed = true;
+    }
+
+    fn detail(s: *State, e: *E.Engine, a: std.mem.Allocator, id: []const u8) !void {
+        _ = try s.tensor(e, a, id, "qn", "bf16", &.{ s.rows, heads, dims }, e.qn, 0);
+        _ = try s.tensor(e, a, id, "exact-y", "bf16", &.{ s.rows, heads, dims }, s.y(), 0);
+        _ = try s.tensor(e, a, id, "candidate-y", "bf16", &.{ s.rows, heads, dims }, e.y, 0);
+        const exact: Exact = .{
+            .pm = try s.tensor(e, a, id, "exact-pm", "f32", &.{ s.rows, heads, 63 }, s.pm(), 1),
+            .pl = try s.tensor(e, a, id, "exact-pl", "f32", &.{ s.rows, heads, 63 }, s.pl(), 1),
+            .po = try s.tensor(e, a, id, "exact-po", "f32", &.{ s.rows, heads, 63, dims }, s.po(), 1),
+            .tail = try s.tail(e, a, id, "exact", s.pm(), s.pl(), s.po()),
+        };
+        const p = e.prefix1645 orelse return error.FidelityNeedsPrefix1645;
+        const candidate: Candidate = .{
+            .output = try s.tensor(e, a, id, "candidate-output", "bf16", &.{ s.rows, heads, 42, dims }, p.partial, 3),
+            .lse = try s.tensor(e, a, id, "candidate-lse", "f32", &.{ s.rows, heads, 42 }, p.lse, 4),
+            .tail = try s.tail(e, a, id, "candidate", e.pm, e.pl, e.po),
+        };
+        try s.json(a, try std.fmt.allocPrint(a, "{s}-attention.json", .{id}), .{
+            .schema = "stage25.fidelity.capture",
+            .version = @as(u32, 1),
+            .attention = .{ .same_state_id = id, .exact = exact, .candidate = candidate },
+        });
+    }
+
+    fn tail(s: *State, e: *E.Engine, a: std.mem.Allocator, id: []const u8, name: []const u8, m: u64, l: u64, o: u64) !Raw {
+        return .{
+            .pm = try s.tensor(e, a, id, try std.fmt.allocPrint(a, "{s}-tail-pm", .{name}), "f32", &.{ s.rows, heads }, m, 2),
+            .pl = try s.tensor(e, a, id, try std.fmt.allocPrint(a, "{s}-tail-pl", .{name}), "f32", &.{ s.rows, heads }, l, 2),
+            .po = try s.tensor(e, a, id, try std.fmt.allocPrint(a, "{s}-tail-po", .{name}), "f32", &.{ s.rows, heads, dims }, o, 2),
+        };
+    }
+
+    fn tensor(s: *State, e: *E.Engine, a: std.mem.Allocator, id: []const u8, name: []const u8, dtype: []const u8, shape: []const usize, ptr: u64, layout: u3) !Tensor {
+        const width: usize = if (std.mem.eql(u8, dtype, "bf16")) 2 else 4;
+        var count: usize = 1;
+        for (shape) |n| count *= n;
+        const packed_queries: usize = if (e.prefix1645_direct_on and s.rows == 10) 60 else 54;
+        const source_bytes: usize = switch (layout) {
+            1, 2 => s.rows * heads * 64 * (if (shape.len == (if (layout == 1) @as(usize, 4) else 3)) dims else @as(usize, 1)) * 4,
+            3 => if (packed_queries == 60) prefix.direct_out_bytes else prefix.out_bytes,
+            4 => if (packed_queries == 60) prefix.direct_lse_bytes else prefix.lse_bytes,
+            else => count * width,
+        };
+        const source = try s.read(e, ptr, source_bytes);
+        const out = s.unpacked[0 .. count * width];
+        try unpack(out, source, s.rows, width, if (shape.len == (if (layout == 2) @as(usize, 3) else 4)) dims else 1, layout, packed_queries);
+        try finite(out, width);
+        const path = try std.fmt.allocPrint(a, "{s}-{s}.bin", .{ id, name });
+        try s.dir.writeFile(s.io, .{ .sub_path = path, .data = out, .flags = .{ .exclusive = true } });
+        return .{ .dtype = dtype, .shape = try a.dupe(usize, shape), .path = path };
+    }
+
+    fn json(s: *State, a: std.mem.Allocator, path: []const u8, value: anytype) !void {
+        const text = try std.json.Stringify.valueAlloc(a, value, .{});
+        try s.dir.writeFile(s.io, .{ .sub_path = path, .data = text, .flags = .{ .exclusive = true } });
+    }
+};
+
+/// The diagnostic reference disables both candidates; a candidate selects exactly one explicit mode.
+pub fn validateMode(candidate: bool, packed_mode: ?[]const u8, direct: ?[]const u8) !void {
+    if (!candidate) {
+        if (packed_mode != null or direct != null) return error.FidelityExactNeedsAbsentPrefixFlag;
+        return;
+    }
+    if (packed_mode != null and direct != null) return error.Prefix1645ConflictingModes;
+    const selected = packed_mode orelse direct orelse return error.FidelityNeedsPrefix1645;
+    if (!std.mem.eql(u8, selected, "1")) return error.FidelityNeedsPrefix1645;
+}
+
+/// Called only by the explicit diagnostic CLI flag, after normal engine initialization and before prefill.
+pub fn configure(e: *E.Engine, io: std.Io, output_dir: []const u8) !void {
+    try e.requireHealthy();
+    if (active.load(.acquire) != 0) return error.FidelityAlreadyConfigured;
+    if (!(e.prefix1645_on or e.prefix1645_direct_on) or e.prefix1645 == null or e.mt2.paired == null or e.g.q_heads != heads or e.g.kv_heads != 4)
+        return error.FidelityNeedsPrefix1645;
+    var parent = try std.Io.Dir.cwd().openDir(io, output_dir, .{});
+    defer parent.close(io);
+    try parent.createDir(io, "attention", .default_dir);
+    const dir = try parent.openDir(io, "attention", .{});
+    errdefer dir.close(io);
+    var exact = try cuda.DeviceBuffer.alloc(e.d, device_bytes);
+    errdefer exact.free();
+    var host = try cuda.HostBuffer.alloc(e.d, po_bytes);
+    errdefer host.free();
+    const unpacked = try e.gpa.alloc(u8, po_bytes);
+    errdefer e.gpa.free(unpacked);
+    const s = try e.gpa.create(State);
+    s.* = .{ .owner = e, .gpa = e.gpa, .io = io, .dir = dir, .exact = exact, .host = host, .unpacked = unpacked };
+    errdefer e.gpa.destroy(s);
+    if (active.cmpxchgStrong(0, @intFromPtr(s), .release, .monotonic) != null) return error.FidelityAlreadyConfigured;
+}
+
+fn digest(bytes: []const u8) [64]u8 {
+    var hash: [32]u8 = undefined;
+    std.crypto.hash.sha2.Sha256.hash(bytes, &hash, .{});
+    return std.fmt.bytesToHex(hash, .lower);
+}
+
+fn finite(bytes: []const u8, width: usize) !void {
+    var i: usize = 0;
+    while (i < bytes.len) : (i += width) {
+        const bits = if (width == 2) @as(u32, std.mem.readInt(u16, bytes[i..][0..2], .little)) << 16 else std.mem.readInt(u32, bytes[i..][0..4], .little);
+        if (!std.math.isFinite(@as(f32, @bitCast(bits)))) return error.FidelityNonfiniteTensor;
+    }
+}
+
+/// Converts native Exact [R,H,64] and packed candidate layouts into the comparator's logical order.
+fn unpack(out: []u8, source: []const u8, rows: usize, width: usize, channels: usize, layout: u3, packed_queries: usize) !void {
+    if (layout == 0) {
+        if (out.len != source.len) return error.FidelityBufferBounds;
+        @memcpy(out, source);
+        return;
+    }
+    const splits: usize = if (layout == 1) 63 else if (layout == 2) 1 else 42;
+    if (out.len != rows * heads * splits * channels * width) return error.FidelityBufferBounds;
+    if (layout >= 3 and ((packed_queries != 54 and packed_queries != 60) or rows * 6 > packed_queries))
+        return error.FidelityBufferBounds;
+    for (0..rows) |r| for (0..heads) |h| for (0..splits) |c| {
+        const q = r * heads + h;
+        const pq = r * 6 + h % 6;
+        const from = switch (layout) {
+            1 => (q * 64 + c) * channels,
+            2 => (q * 64 + 63) * channels,
+            3 => ((c * packed_queries + pq) * 4 + h / 6) * channels,
+            4 => (c * 4 + h / 6) * packed_queries + pq,
+            else => return error.FidelityInvalidLayout,
+        } * width;
+        const to = (q * splits + c) * channels * width;
+        const n = channels * width;
+        if (from + n > source.len) return error.FidelityBufferBounds;
+        @memcpy(out[to..][0..n], source[from..][0..n]);
+    };
+}
+
+test {
+    _ = @import("cuda_fidelity_test.zig");
+}
+
+pub const testing = struct {
+    pub const unpackTensor = unpack;
+    pub const finiteTensor = finite;
+    pub const allocation_offsets = [_]usize{ 0, stat_bytes, 2 * stat_bytes, 2 * stat_bytes + po_bytes, device_bytes };
+};
diff --git a/zig/src/families/qwen3_5/cuda_fidelity_test.zig b/zig/src/families/qwen3_5/cuda_fidelity_test.zig
new file mode 100644
index 00000000..aadbb388
--- /dev/null
+++ b/zig/src/families/qwen3_5/cuda_fidelity_test.zig
@@ -0,0 +1,105 @@
+//! Host-only witnesses for the two native layouts and strict finite tensor serialization.
+const std = @import("std");
+const f = @import("cuda_fidelity.zig").testing;
+const t = std.testing;
+
+test "Qwen engine safety: fidelity workspace owns every fixed-ten-row Exact launch output" {
+    const offsets = f.allocation_offsets;
+    try t.expectEqualSlices(usize, &.{ 0, 10 * 24 * 64 * 4, 2 * 10 * 24 * 64 * 4, 2 * 10 * 24 * 64 * 4 + 10 * 24 * 64 * 256 * 4, 2 * 10 * 24 * 64 * 4 + 10 * 24 * 64 * 256 * 4 + 10 * 24 * 256 * 2 }, &offsets);
+    for (offsets[1..], offsets[0 .. offsets.len - 1]) |end, start| try t.expect(end > start);
+}
+
+fn marked(n: usize) ![]u8 {
+    const bytes = try t.allocator.alloc(u8, n * 4);
+    for (0..n) |i| std.mem.writeInt(u32, bytes[4 * i ..][0..4], @intCast(i), .little);
+    return bytes;
+}
+
+test "Qwen engine safety: fidelity unpacks Exact prefix and tail without comparing different intervals" {
+    const native = try marked(2 * 24 * 64 * 3);
+    defer t.allocator.free(native);
+    const out = try t.allocator.alloc(u8, 2 * 24 * 63 * 3 * 4);
+    defer t.allocator.free(out);
+    try f.unpackTensor(out, native, 2, 4, 3, 1, 54);
+    for (0..48) |q| for (0..63) |s| for (0..3) |d| {
+        const at = ((q * 63 + s) * 3 + d) * 4;
+        try t.expectEqual(@as(u32, @intCast((q * 64 + s) * 3 + d)), std.mem.readInt(u32, out[at..][0..4], .little));
+    };
+    const tail = try t.allocator.alloc(u8, 48 * 3 * 4);
+    defer t.allocator.free(tail);
+    try f.unpackTensor(tail, native, 2, 4, 3, 2, 54);
+    for (0..48) |q| for (0..3) |d| {
+        const at = (q * 3 + d) * 4;
+        try t.expectEqual(@as(u32, @intCast((q * 64 + 63) * 3 + d)), std.mem.readInt(u32, tail[at..][0..4], .little));
+    };
+    try t.expectError(error.FidelityBufferBounds, f.unpackTensor(out[0 .. out.len - 4], native, 2, 4, 3, 1, 54));
+}
+
+test "Qwen engine safety: fidelity separately unpacks q54 and q60 candidate output and LSE head axes" {
+    for ([_]usize{ 54, 60 }) |packed_queries| try candidateLayout(packed_queries);
+}
+
+fn candidateLayout(packed_queries: usize) !void {
+    const native_output = try marked(42 * packed_queries * 4 * 2);
+    defer t.allocator.free(native_output);
+    const native_lse = try marked(42 * 4 * packed_queries);
+    defer t.allocator.free(native_lse);
+    for ([_]usize{ 1, 9, 10 }) |rows| {
+        if (rows * 6 > packed_queries) continue;
+        const output = try t.allocator.alloc(u8, rows * 24 * 42 * 2 * 4);
+        defer t.allocator.free(output);
+        const lse = try t.allocator.alloc(u8, rows * 24 * 42 * 4);
+        defer t.allocator.free(lse);
+        try f.unpackTensor(output, native_output, rows, 4, 2, 3, packed_queries);
+        try f.unpackTensor(lse, native_lse, rows, 4, 1, 4, packed_queries);
+        for (0..rows) |r| for (0..4) |kv| for (0..6) |sub| for (0..42) |split| {
+            const q = r * 24 + kv * 6 + sub;
+            const packed_query = r * 6 + sub;
+            const at = (q * 42 + split) * 4;
+            const expected_lse = (split * 4 + kv) * packed_queries + packed_query;
+            try t.expectEqual(@as(u32, @intCast(expected_lse)), std.mem.readInt(u32, lse[at..][0..4], .little));
+            for (0..2) |d| {
+                const oi = ((q * 42 + split) * 2 + d) * 4;
+                const expected_output = ((split * packed_queries + packed_query) * 4 + kv) * 2 + d;
+                try t.expectEqual(@as(u32, @intCast(expected_output)), std.mem.readInt(u32, output[oi..][0..4], .little));
+            }
+        };
+    }
+}
+
+test "Qwen engine safety: fidelity rejects q60 rows with a q54 stride" {
+    const output = try t.allocator.alloc(u8, 10 * 24 * 42 * 2 * 4);
+    defer t.allocator.free(output);
+    const source = try marked(42 * 60 * 4 * 2);
+    defer t.allocator.free(source);
+    try t.expectError(error.FidelityBufferBounds, f.unpackTensor(output, source, 10, 4, 2, 3, 54));
+}
+
+test "Qwen engine safety: fidelity explicitly selects one candidate and disables both for Exact" {
+    const mode = @import("cuda_fidelity.zig").validateMode;
+    try mode(false, null, null);
+    try mode(true, "1", null);
+    try mode(true, null, "1");
+    try t.expectError(error.FidelityNeedsPrefix1645, mode(true, null, null));
+    try t.expectError(error.FidelityNeedsPrefix1645, mode(true, "0", null));
+    try t.expectError(error.FidelityNeedsPrefix1645, mode(true, null, "bad"));
+    try t.expectError(error.Prefix1645ConflictingModes, mode(true, "1", "1"));
+    try t.expectError(error.FidelityExactNeedsAbsentPrefixFlag, mode(false, "0", null));
+    try t.expectError(error.FidelityExactNeedsAbsentPrefixFlag, mode(false, null, "1"));
+}
+
+test "Qwen engine safety: fidelity refuses nonfinite f32 and BF16 rather than publishing a valid sidecar" {
+    for ([_]u32{ 0, 0x3f800000, 0xbf800000, 0x00000001 }) |bits| {
+        var bytes: [4]u8 = undefined;
+        std.mem.writeInt(u32, &bytes, bits, .little);
+        try f.finiteTensor(&bytes, 4);
+    }
+    for ([_]u32{ 0x7f800000, 0xff800000, 0x7fc00001 }) |bits| {
+        var bytes: [4]u8 = undefined;
+        std.mem.writeInt(u32, &bytes, bits, .little);
+        try t.expectError(error.FidelityNonfiniteTensor, f.finiteTensor(&bytes, 4));
+        var bf16: [2]u8 = undefined;
+        std.mem.writeInt(u16, &bf16, @truncate(bits >> 16), .little);
+        try t.expectError(error.FidelityNonfiniteTensor, f.finiteTensor(&bf16, 2));
+    }
+}
