+//! Direct-page host fixtures record the real CUDA ABI without loading a driver or a model.
+const std = @import("std");
+const cuda = @import("cuda");
+const E = @import("cuda_engine.zig");
+const P = @import("cuda_prefix1645.zig");
+const t = std.testing;
+const D = cuda.paging_test_device.Device;
+
+const Fake = struct {
+    var encodes: usize = 0;
+    var fail_encode: usize = 0;
+    var addresses: [2]u64 = undefined;
+    var launches: usize = 0;
+    var fail_launch: usize = 0;
+    var calls: [6]Call = undefined;
+    var audit: [2]u32 = .{ 16, 0 };
+    var graph_drops: usize = 0;
+    var watched: ?*P.State = null;
+    const Call = struct { id: usize, grid: [3]u32, block: u32, shared: u32, args: [22]u64 = @splat(0), kmap: P.Map = .{}, vmap: P.Map = .{} };
+
+    fn encode(out: *P.Map, dtype: c_int, rank: u32, address: ?*anyopaque, dims: [*]const u64, strides: [*]const u64, box: [*]const u32, steps: [*]const u32, interleave: c_int, swizzle: c_int, l2: c_int, oob: c_int) callconv(.c) c_int {
+        std.debug.assert(dtype == 0 and rank == 5 and interleave == 0 and swizzle == 3 and l2 == 0 and oob == 0);
+        std.debug.assert(std.mem.eql(u64, dims[0..4], &.{ 128, 128, 2, 4 }));
+        std.debug.assert(dims[4] > 0 and dims[4] % 16 == 0);
+        std.debug.assert(std.mem.eql(u64, strides[0..4], &.{ 256, 128, 32768, 266240 }));
+        std.debug.assert(std.mem.eql(u32, box[0..5], &.{ 128, 64, 2, 1, 1 }));
+        std.debug.assert(std.mem.eql(u32, steps[0..5], &.{ 1, 1, 1, 1, 1 }));
+        addresses[encodes % 2] = @intFromPtr(address.?);
+        encodes += 1;
+        out.* = .{};
+        out.words[0] = @intFromPtr(address.?);
+        out.words[1] = dims[4];
+        return if (encodes == fail_encode) cuda.abi.error_not_ready else 0;
+    }
+
+    fn value(comptime T: type, args: ?[*]?*anyopaque, i: usize) T {
+        return @as(*align(1) const T, @ptrCast(args.?[i].?)).*;
+    }
+
+    fn launch(f: cuda.abi.Function, x: c_uint, y: c_uint, z: c_uint, bx: c_uint, by: c_uint, bz: c_uint, shared: c_uint, _: cuda.abi.Stream, args: ?[*]?*anyopaque, _: ?[*]?*anyopaque) callconv(.c) c_int {
+        std.debug.assert(launches < calls.len and by == 1 and bz == 1);
+        const id = @intFromPtr(f.?);
+        var call: Call = .{ .id = id, .grid = .{ x, y, z }, .block = bx, .shared = shared };
+        if (id == 4 or id == 7) {
+            for (0..7) |i| call.args[i] = value(u64, args, i);
+            call.kmap = value(P.Map, args, 7);
+            call.vmap = value(P.Map, args, 8);
+            call.args[9] = value(u64, args, 9);
+            call.args[10] = value(u32, args, 10);
+            call.args[11] = value(u64, args, 11);
+            for (12..15) |i| call.args[i] = value(u32, args, i);
+            for (15..22) |i| call.args[i] = value(u64, args, i);
+        } else if (id == 3) {
+            for (0..4) |i| call.args[i] = value(u64, args, i);
+        } else if (id == 6 or id == 8) {
+            for (0..7) |i| call.args[i] = value(u64, args, i);
+        }
+        calls[launches] = call;
+        launches += 1;
+        return if (launches == fail_launch) cuda.abi.error_not_ready else 0;
+    }
+
+    fn read(out: ?*anyopaque, _: u64, bytes: usize) callconv(.c) c_int {
+        std.debug.assert(bytes == @sizeOf(@TypeOf(audit)));
+        @memcpy(@as([*]u8, @ptrCast(out.?))[0..bytes], std.mem.asBytes(&audit));
+        return 0;
+    }
+
+    fn drop(_: cuda.abi.GraphExec) callconv(.c) c_int {
+        std.debug.assert(!D.pending and watched.?.binding != null);
+        graph_drops += 1;
+        return 0;
+    }
+
+    fn driver() cuda.Driver {
+        var d = D.driver();
+        encodes = 0;
+        fail_encode = 0;
+        launches = 0;
+        fail_launch = 0;
+        graph_drops = 0;
+        watched = null;
+        audit = .{ 16, 0 };
+        d.api.cuLaunchKernel = launch;
+        d.api.cuMemcpyDtoH_v2 = read;
+        d.api.cuGraphExecDestroy = drop;
+        return d;
+    }
+};
+
+fn function(d: *const cuda.Driver, id: usize) cuda.Function {
+    return .{ .d = d, .handle = @ptrFromInt(id) };
+}
+
+fn state(d: *const cuda.Driver) P.State {
+    return .{
+        .prefix_mod = undefined,
+        .adapter_mod = undefined,
+        .prefix = function(d, 4),
+        .direct60 = function(d, 7),
+        .init = function(d, 1),
+        .scales_fn = function(d, 2),
+        .pack_kv = function(d, 9),
+        .pack_q = function(d, 3),
+        .merge = function(d, 6),
+        .merge60 = function(d, 8),
+        .kmap = .{},
+        .vmap = .{},
+        .keys = 0,
+        .values = 0,
+        .queries = 0x200000000,
+        .partial = 0x200010000,
+        .lse = 0x200510000,
+        .scales = 0x200520000,
+        .queue = 0x200520100,
+        .stats = 0x200520200,
+        .encode_fn = Fake.encode,
+    };
+}
+
+fn engine(d: *cuda.Driver) E.Engine {
+    var e: E.Engine = undefined;
+    e.d = d;
+    e.gpa = t.allocator;
+    e.health = .{};
+    e.stream = .{ .d = d, .handle = D.stream };
+    e.graphs = .empty;
+    e.prefix1645_on = false;
+    e.prefix1645_direct_on = true;
+    e.prefix1645 = null;
+    e.kv8 = true;
+    e.window_rows = E.most_window;
+    e.g = .{ .hidden = 5120, .intermediate = 17408, .layers = 64, .vocab = 8, .k_heads = 16, .v_heads = 48, .q_heads = 24, .kv_heads = 4, .eps = 1e-6, .tied = false, .context = 131072, .linear = @splat(true) };
+    for (0..16) |i| e.g.linear[4 * i + 3] = false;
+    e.geo = .{ .hid = 5120, .nk = 16, .nv = 48, .qh = 24, .kvh = 4, .nl = 48 };
+    e.mt2 = .{ .enabled = true, .page128 = true, .paged = function(d, 10), .whole = function(d, 11), .paired = .{ .prefix = function(d, 12), .tail = function(d, 5), .merge = function(d, 13) } };
+    e.qn = 0x600000000;
+    e.pm = 0x610000000;
+    e.pl = 0x620000000;
+    e.po = 0x630000000;
+    e.y = 0x640000000;
+    return e;
+}
+
+test "Qwen attention path: direct-page binding is atomic, owner-specific and rejects rebinding" {
+    var d = Fake.driver();
+    var s = state(&d);
+    const base: u64 = 0x100000000;
+    Fake.fail_encode = 2;
+    try t.expectError(error.NotReady, s.bindWith(&d, Fake.encode, 1, base, P.page_bytes, 2048));
+    try t.expect(s.binding == null);
+    try t.expectEqual(@as(u64, 0), s.kmap.words[0]);
+    Fake.encodes = 0;
+    Fake.fail_encode = 0;
+    try s.bindWith(&d, Fake.encode, 1, base, P.page_bytes, 2048);
+    try t.expectEqualSlices(u64, &.{ base, base + 131072 }, &Fake.addresses);
+    try t.expectEqual(@as(u64, 32768), s.kmap.words[1]);
+    try t.expectError(error.Prefix1645AlreadyBound, s.bindWith(&d, Fake.encode, 2, base, P.page_bytes, 2048));
+    try t.expectEqual(@as(usize, 2), Fake.encodes);
+    s.unbind(2);
+    try t.expectEqual(@as(usize, 1), s.binding.?.owner);
+    s.unbind(1);
+    try t.expect(s.binding == null);
+    for ([_]usize{ 0, @as(usize, std.math.maxInt(i32)) / 16 + 1 }) |count|
+        try t.expectError(error.Prefix1645InvalidBinding, s.bindWith(&d, Fake.encode, 1, base, P.page_bytes, count));
+    try t.expectError(error.Prefix1645InvalidBinding, s.bindWith(&d, Fake.encode, 1, base + 1, P.page_bytes, 2048));
+}
+
+test "Qwen attention path: direct-page preflight refuses missing, alien, truncated or invalid cache pages" {
+    var d = Fake.driver();
+    var e = engine(&d);
+    var s = state(&d);
+    var ids: [1024]u32 = @splat(0);
+    var c: E.Cache = undefined;
+    c.len = 129024;
+    c.cap = 131072;
+    c.paged = .{ .base = 0x100000000, .table = .{ .d = &d, .ptr = 0x180000000, .len = 4096 }, .ids = &ids, .tokens = 128 };
+    const parts = [_]E.Part{.{ .cache = &c, .rows = 9 }};
