+    e.g.q_heads = 24;
+    e.g.intermediate = 17408;
+    e.g.kinds.modelopt = true;
+    e.arena = .{ .d = undefined, .ptr = 0x100000, .len = 1 << 30 };
+    e.arena_at = 0;
+    e.fp8_acts = false;
+    e.fp4_acts = false;
+    const base = try e.scratch(.measure);
+    e.fp8_acts = true;
+    const enabled = try e.scratch(.measure);
+    try t.expectEqual(@as(usize, 4096 * 6144), enabled - base);
+    e.arena_at = 0;
+    try t.expectEqual(enabled, try e.scratch(.allocate));
+    try t.expect(e.ck_rows + 4096 * 6144 <= e.h);
+    try t.expect(e.ck_rows + 4096 * 6144 <= e.gate);
+    e.fp4_acts = true;
+    e.arena_at = 0;
+    const both = try e.scratch(.measure);
+    e.arena.len = both; // the fake arena has exactly the measured capacity, as the real allocation does
+    e.arena_at = 0;
+    try t.expectEqual(both, try e.scratch(.allocate));
+    try t.expectEqual(@as(usize, 4096 * 6144), e.ck_rows_bytes);
+    try t.expectEqual(@as(usize, 2048 * 5120 * 4 * 4), e.fp4_part_bytes);
+    try t.expect(e.ck_rows + e.ck_rows_bytes <= e.fp4_part);
+    try t.expect(e.fp4_part + e.fp4_part_bytes <= e.h);
+}
