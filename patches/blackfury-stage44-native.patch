+/// Three resident blocks help this envelope until a long final wave would undo the gain.
+pub fn useAsync(rows: usize, cached: usize) bool {
+    if (rows < 6 or rows > 10 or cached < 32768) return false;
+    const chunk = @max(@as(usize, 128), ((cached + rows + 8191) / 8192) * 128);
+    const chunks = (cached + rows + chunk - 1) / chunk;
+    const blocks = ((rows + 4) / 5) * chunks * 4;
+    return blocks <= 510 or (cached -| ((chunks - 1) * chunk)) <= chunk / 2;
+}
+
+test "async attention keeps unqualified rows and long final waves on Stage9" {
+    for ([_]usize{ 0, 1, 5, 11, 16, 32 }) |rows| try std.testing.expect(!useAsync(rows, 129024));
+    for ([_]usize{ 8192, 16384, 32767 }) |n| try std.testing.expect(!useAsync(9, n));
+    for ([_]usize{ 32768, 65536, 129024, 130048 }) |n| try std.testing.expect(useAsync(9, n));
+    for ([_]usize{ 130049, 130304, 131040 }) |n| try std.testing.expect(!useAsync(9, n));
