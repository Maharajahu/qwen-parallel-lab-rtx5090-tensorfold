diff --git a/zig/src/families/qwen3_5/cuda_mtp_ops.zig b/zig/src/families/qwen3_5/cuda_mtp_ops.zig
new file mode 100644
index 00000000..a93ffb49
--- /dev/null
+++ b/zig/src/families/qwen3_5/cuda_mtp_ops.zig
@@ -0,0 +1,72 @@
+//! MTP request preflight and drafter dispatch, before any context mutation or CUDA enqueue.
+const std = @import("std");
+const lanes = @import("lanes");
+const dr = lanes.drafter;
+const batched = @import("cuda_mtp_batch.zig");
+const timing = @import("cuda_draft_timing.zig").write;
+const most_window = @import("cuda_engine.zig").most_window;
+const ranks = lanes.shape.ranks;
+
+pub fn absorb(d: anytype, items: []const dr.Absorb) !void {
+    try d.e.requireHealthy();
+    try validateAbsorbs(d, items);
+    const t0 = std.Io.Clock.awake.now(d.io);
+    defer timing("mtp absorb", d.io, t0);
+    // A shared round's streams run in passes; one stream runs the same bits without the batch copies.
+    if (d.batch and !d.trees and items.len > 1) return batched.absorb(d, items);
+    errdefer d.e.poison();
+    for (items) |it| try absorbOne(d, it);
+}
+
+pub fn validateAbsorbs(d: anytype, items: []const dr.Absorb) !void {
+    for (items, 0..) |it, index| {
+        _ = d.streams.get(it.stream) orelse return error.UnknownStream;
+        if (it.features.space != .device or it.features.dtype != .bf16) return error.UnsupportedFeatures;
+        const n = if (it.rows) |rs| rs.len else it.features.rows;
+        if (it.follow.len < n or it.features.offset > std.math.maxInt(i64) -| n) return error.BadDraftRows;
+        if (it.rows) |rs| {
+            if (n > most_window) return error.BadDraftRows;
+            for (rs) |row| if (row >= it.features.rows) return error.BadDraftRows;
+        }
+        for (items[0..index]) |earlier| if (earlier.stream == it.stream) return error.OverlappingDraftContexts;
+    }
+}
+
+/// One stream's absorb, as the serial path runs it.
+pub fn absorbOne(d: anytype, it: dr.Absorb) !void {
+    try d.e.requireHealthy();
+    try validateAbsorbs(d, &.{it});
+    errdefer d.e.poison();
+    const ctx = d.streams.get(it.stream) orelse return error.UnknownStream;
+    if (it.rows) |rs| {
+        try d.absorbRole(ctx, it.features.buffer, it.features.offset, rs.len, rs, it.follow, it.prompt, it.propose);
+    } else try d.absorbRole(ctx, it.features.buffer, it.features.offset, it.features.rows, null, it.follow, it.prompt, it.propose);
+}
+
+pub fn hold(d: anytype, items: []const dr.Hold) !void {
+    try d.e.requireHealthy();
+    try validateHolds(d, items);
+    const t0 = std.Io.Clock.awake.now(d.io);
+    defer timing("mtp hold", d.io, t0);
+    if (d.batch and !d.trees and items.len > 1) return batched.hold(d, items);
+    errdefer d.e.poison();
+    for (items) |it| {
+        const ctx = d.streams.get(it.stream) orelse return error.UnknownStream;
+        try d.hold(ctx, it.pending, it.position - 1, it.depth, it.lanes);
+    }
+}
+
+pub fn validateHolds(d: anytype, items: []const dr.Hold) !void {
+    for (items, 0..) |it, index| {
+        const ctx = d.streams.get(it.stream) orelse return error.UnknownStream;
+        if (it.position == 0 or it.pending >= d.e.g.vocab or ctx.end != it.position - 1) return error.DraftContextBehind;
+        if (it.lanes) |shape| {
+            const n = shape.parents.len;
+            if (n > ctx.held.len or n != shape.depths.len or n != shape.ranks.len) return error.BadLanes;
+            for (shape.parents, shape.depths, shape.ranks, 0..) |parent, depth, rank, row| {
+                if (parent < -1 or parent >= @as(i32, @intCast(row)) or depth >= most_window or rank >= ranks) return error.BadLanes;
+            }
+        }
+        for (items[0..index]) |earlier| if (earlier.stream == it.stream) return error.OverlappingDraftContexts;
+    }
+}
