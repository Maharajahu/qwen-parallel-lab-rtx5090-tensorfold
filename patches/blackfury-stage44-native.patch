+    pack_q: cuda.Function,
+    merge: cuda.Function,
+    merge60: ?cuda.Function = null,
+    kmap: Map,
+    vmap: Map,
+    keys: u64,
+    values: u64,
+    queries: u64,
+    partial: u64,
+    lse: u64,
+    scales: u64,
+    queue: u64,
+    stats: u64,
+    encode_fn: ?Encode = null,
+    binding: ?Binding = null,
+    seen: bool = false,
+    audited_launches: u32 = 0,
+
+    pub fn load(e: *E.Engine) !State {
+        const prefix_image align(8) = @embedFile("prefix1645.cubin").*;
+        const direct54_image align(8) = @embedFile("prefix1645_direct_q54.cubin").*;
+        const direct60_image align(8) = @embedFile("prefix1645_direct_q60.cubin").*;
+        const direct_adapter_image align(8) = @embedFile("prefix1645_direct_adapter.fatbin").*;
+        const adapter_image align(8) = @embedFile("prefix1645_adapter.fatbin").*;
+        const direct = e.prefix1645_direct_on;
+        var prefix_mod = try cuda.Module.load(e.d, if (direct) &direct54_image else &prefix_image);
+        errdefer prefix_mod.unload();
+        var adapter_mod = try cuda.Module.load(e.d, &adapter_image);
+        errdefer adapter_mod.unload();
+        const name = if (direct) @import("prefix1645_direct_symbols.zig").q54 else @import("prefix1645_symbol.zig").name;
+        const prefix = try prefix_mod.function(name);
+        try prefix.allowDynamicShared(32792);
+        try prefix.setAttribute(.preferred_shared_memory_carveout, 100);
+        var direct60_mod: ?cuda.Module = null;
+        errdefer if (direct60_mod) |*m| m.unload();
+        var direct_adapter_mod: ?cuda.Module = null;
+        errdefer if (direct_adapter_mod) |*m| m.unload();
+        var direct60: ?cuda.Function = null;
+        var merge60: ?cuda.Function = null;
+        if (direct) {
+            direct60_mod = try cuda.Module.load(e.d, &direct60_image);
+            direct60 = try direct60_mod.?.function(@import("prefix1645_direct_symbols.zig").q60);
+            try direct60.?.allowDynamicShared(32792);
+            try direct60.?.setAttribute(.preferred_shared_memory_carveout, 100);
+            direct_adapter_mod = try cuda.Module.load(e.d, &direct_adapter_image);
+            merge60 = try direct_adapter_mod.?.function("tf_p1645d_merge60");
+        }
+        const keys = if (direct) 0 else e.prefix1645_workspace;
+        const values = if (direct) 0 else keys + kv_bytes;
+        const queries = if (direct) e.prefix1645_workspace else values + kv_bytes;
+        const partial = queries + @as(u64, if (direct) direct_q_bytes else q_bytes);
+        const lse = partial + @as(u64, if (direct) direct_out_bytes else out_bytes);
+        const scales = lse + E.aligned(if (direct) direct_lse_bytes else lse_bytes);
+        const queue = scales + 256;
+        const stats = queue + 256;
+        try e.d.check(e.d.api.cuMemsetD8_v2(stats, 0, 12), "prefix1645 initialize audit counters");
+        var library = e.d.lib;
+        const encode_fn = if (direct) library.lookup(Encode, "cuTensorMapEncodeTiled") orelse return error.MissingSymbol else null;
+        return .{
+            .prefix_mod = prefix_mod,
+            .adapter_mod = adapter_mod,
+            .direct60_mod = direct60_mod,
+            .direct_adapter_mod = direct_adapter_mod,
+            .prefix = prefix,
+            .direct60 = direct60,
+            .init = try adapter_mod.function("tf_p1645_init"),
+            .scales_fn = try adapter_mod.function("tf_p1645_scales"),
+            .pack_kv = try adapter_mod.function("tf_p1645_pack_kv"),
+            .pack_q = try adapter_mod.function("tf_p1645_pack_q"),
+            .merge = try adapter_mod.function("tf_p1645_merge"),
+            .merge60 = merge60,
+            .kmap = if (direct) .{} else try encode(e, keys),
+            .vmap = if (direct) .{} else try encode(e, values),
+            .keys = keys,
+            .values = values,
+            .queries = queries,
+            .partial = partial,
+            .lse = lse,
+            .scales = scales,
+            .queue = queue,
+            .stats = stats,
+            .encode_fn = encode_fn,
+        };
+    }
+
+    pub fn deinit(s: *State) void {
+        if (s.direct_adapter_mod) |*m| m.unload();
+        if (s.direct60_mod) |*m| m.unload();
+        s.prefix_mod.unload();
+        s.adapter_mod.unload();
+    }
+
+    /// Both maps are built locally; failed encoding never publishes a partially bound owner.
+    pub fn bind(s: *State, e: *E.Engine, owner: usize, base: u64, bytes: usize, pages: usize) !void {
+        const fun = s.encode_fn orelse return error.MissingSymbol;
+        try s.bindWith(e.d, fun, owner, base, bytes, pages);
+    }
+
+    pub fn bindWith(s: *State, d: *const cuda.Driver, fun: Encode, owner: usize, base: u64, bytes: usize, pages: usize) !void {
+        if (s.binding != null) return error.Prefix1645AlreadyBound;
+        if (owner == 0 or base == 0 or base % 256 != 0 or bytes != page_bytes or pages == 0 or pages > std.math.maxInt(i32) / 16) return error.Prefix1645InvalidBinding;
+        if (pages > (std.math.maxInt(u64) - base) / bytes) return error.Prefix1645InvalidBinding;
+        const kmap = try encodeDirect(d, fun, base, pages);
+        const vmap = try encodeDirect(d, fun, base + 131072, pages);
+        s.kmap = kmap;
+        s.vmap = vmap;
+        s.binding = .{ .owner = owner, .base = base, .bytes = bytes, .pages = pages };
+    }
+
+    /// Caller has drained the stream and destroyed every captured reference to this owner.
+    pub fn unbind(s: *State, owner: usize) void {
+        if (s.binding) |b| if (b.owner == owner) {
+            s.binding = null;
+            s.kmap = .{};
+            s.vmap = .{};
+        };
+    }
+
+    /// Host-only refusal leaves the request on Exact before the first cache mutation or enqueue.
+    pub fn compatible(s: *const State, e: *const E.Engine, parts: []const E.Part, rows: usize, record: bool) bool {
+        if (!record or !e.prefix1645_direct_on or !e.kv8 or !@import("cuda_geometry.zig").dense27(e.g)) return false;
+        if (e.g.q_heads != 24 or e.g.kv_heads != 4 or e.g.attentions() != 16) return false;
+        if (!e.mt2.enabled or !e.mt2.page128 or e.mt2.paired == null) return false;
+        const b = s.binding orelse return false;
+        if (parts.len != 1 or rows == 0 or rows > 10 or parts[0].rows != rows) return false;
+        const c = parts[0].cache;
+        const p = c.paged orelse return false;
+        if (p.tokens != 128 or p.base != b.base or p.table.ptr == 0 or b.bytes != page_bytes) return false;
+        if (c.len < 129024 or c.len > 131072 - rows or c.cap < c.len + rows) return false;
+        if (p.elems(e.g, true) != page_bytes) return false;
+        const needed = (c.len + rows + 127) / 128;
+        if (p.ids.len < needed or p.table.len / 4 < needed) return false;
+        for (p.ids[0..needed]) |id| if (id >= b.pages) return false;
+        return true;
+    }
+
+    pub fn runDirect(s: *const State, e: *E.Engine, kind: DirectKind, segs: u64, rows: u64, anc: u64, layer: c_int, params: u64) !void {
+        std.debug.assert(kind != .none);
+        const cfg = cuda.launch.Config;
+        const width: u32 = if (kind == .q60) 60 else 54;
+        const b = s.binding.?;
+        try go(s.init, e.stream, cfg{ .grid = .{ .x = 1 }, .block = .{ .x = 32 } }, .{ s.scales, s.queue, s.stats });
+        try go(s.scales_fn, e.stream, cfg{ .grid = .{ .x = 2016 }, .block = .{ .x = 256 } }, .{ segs, layer, s.scales, s.stats });
+        try go(s.pack_q, e.stream, cfg{ .grid = .{ .x = width, .y = 4 }, .block = .{ .x = 256 } }, .{ e.qn, params, s.queries, s.stats });
+        try go(if (kind == .q60) s.direct60.? else s.prefix, e.stream, cfg{ .grid = .{ .x = 1, .y = 42, .z = 4 }, .block = .{ .x = 256 }, .shared = 32792 }, .{ s.queries, b.base, b.base + 131072, s.partial, s.lse, s.queue, s.stats + 8, s.kmap, s.vmap, segs, layer, s.stats, @as(f32, std.math.log2e / 16.0), @as(f32, 1), @as(i32, 1), s.scales, s.scales + 4, s.scales + 8, @as(u64, 0), @as(u64, 0), @as(u64, 0), @as(u64, 0) });
+        try go(e.mt2.paired.?.tail, e.stream, cfg{ .grid = .{ .x = 10, .y = 1, .z = 4 }, .block = .{ .x = 128 } }, .{ e.geo, e.qn, segs, rows, anc, layer, params, @as(f32, 1.0 / 16.0), @as(c_int, 10), e.pm, e.pl, e.po });
+        try go(if (kind == .q60) s.merge60.? else s.merge, e.stream, cfg{ .grid = .{ .x = if (kind == .q60) 240 else 216 }, .block = .{ .x = 256 } }, .{ s.partial, s.lse, e.pm, e.pl, e.po, params, e.y });
+    }
+
+    pub fn run(s: *const State, e: *E.Engine, segs: u64, rows: u64, anc: u64, layer: c_int, params: u64) !void {
+        const cfg = cuda.launch.Config;
+        try go(s.init, e.stream, cfg{ .grid = .{ .x = 1 }, .block = .{ .x = 32 } }, .{ s.scales, s.queue, s.stats });
+        try go(s.scales_fn, e.stream, cfg{ .grid = .{ .x = 2016 }, .block = .{ .x = 256 } }, .{ segs, layer, s.scales, s.stats });
+        try go(s.pack_kv, e.stream, cfg{ .grid = .{ .x = 4032, .y = 4 }, .block = .{ .x = 256 } }, .{ segs, layer, s.scales, s.keys, s.values, s.stats });
+        try go(s.pack_q, e.stream, cfg{ .grid = .{ .x = 54, .y = 4 }, .block = .{ .x = 256 } }, .{ e.qn, params, s.queries, s.stats });
+        try go(s.prefix, e.stream, cfg{ .grid = .{ .x = 1, .y = 42, .z = 4 }, .block = .{ .x = 256 }, .shared = 32792 }, .{ s.queries, s.keys, s.values, s.partial, s.lse, s.queue, s.stats + 8, s.kmap, s.vmap, @as(f32, std.math.log2e / 16.0), @as(f32, 1), @as(i32, 1), s.scales, s.scales + 4, s.scales + 8, @as(u64, 0), @as(u64, 0), @as(u64, 0), @as(u64, 0) });
+        try go(e.mt2.paired.?.tail, e.stream, cfg{ .grid = .{ .x = 10, .y = 1, .z = 4 }, .block = .{ .x = 128 } }, .{ e.geo, e.qn, segs, rows, anc, layer, params, @as(f32, 1.0 / 16.0), @as(c_int, 10), e.pm, e.pl, e.po });
+        try go(s.merge, e.stream, cfg{ .grid = .{ .x = 216 }, .block = .{ .x = 256 } }, .{ s.partial, s.lse, e.pm, e.pl, e.po, params, e.y });
+    }
+
+    pub fn audit(s: *State, e: *E.Engine) !void {
+        var counts: [2]u32 = undefined;
+        // The audit is ordering, not overlap: finish the stream before copying into pageable stack memory.
+        try e.stream.synchronize();
+        try e.d.check(e.d.api.cuMemcpyDtoH_v2(&counts, s.stats, @sizeOf(@TypeOf(counts))), "prefix1645 audit");
+        const expected = try std.math.add(u32, s.audited_launches, @intCast(e.g.attentions()));
+        if (counts[0] != expected or counts[1] != 0) {
+            std.log.err("prefix1645 refused: launches={d}, expected={d}, invalid_or_clipped={d}", .{ counts[0], expected, counts[1] });
+            return error.Prefix1645InvalidInput;
+        }
+        s.audited_launches = counts[0];
+        if (!s.seen or counts[0] % 4096 == 0)
+            std.log.info("prefix1645 executed: launches={d}, invalid_or_clipped=0", .{counts[0]});
+        s.seen = true;
+    }
+};
+
+fn encodeDirect(d: *const cuda.Driver, fun: Encode, address: u64, pages: usize) !Map {
+    var map: Map = .{};
+    const dims = [_]u64{ 128, 128, 2, 4, pages * 16 };
+    const strides = [_]u64{ 256, 128, 32768, 266240 };
+    const box = [_]u32{ 128, 64, 2, 1, 1 };
+    const steps = [_]u32{ 1, 1, 1, 1, 1 };
+    try d.check(fun(&map, 0, 5, @ptrFromInt(address), &dims, &strides, &box, &steps, 0, 3, 0, 0), "cuTensorMapEncodeTiled(prefix1645 direct)");
+    return map;
+}
+
+fn go(f: cuda.Function, stream: cuda.Stream, cfg: cuda.launch.Config, values: anytype) !void {
+    var args: cuda.Args = .{};
+    inline for (values) |v| args.add(v);
+    try cuda.launch.launch(f, cfg, stream, &args);
+}
+
+fn encode(e: *E.Engine, address: u64) !Map {
+    var library = e.d.lib;
+    const fun = library.lookup(Encode, "cuTensorMapEncodeTiled") orelse return error.MissingSymbol;
+    var map: Map = .{};
+    const dims = [_]u64{ 128, 129024, 2, 4, 1 };
+    const strides = [_]u64{ 1024, 128, 256, kv_bytes };
+    const box = [_]u32{ 128, 64, 2, 1, 1 };
+    const steps = [_]u32{ 1, 1, 1, 1, 1 };
+    try e.d.check(fun(&map, 0, 5, @ptrFromInt(address), &dims, &strides, &box, &steps, 0, 3, 0, 0), "cuTensorMapEncodeTiled(prefix1645)");
+    return map;
+}
+
+test {
+    _ = @import("cuda_prefix1645_test.zig");
+}
diff --git a/zig/src/families/qwen3_5/cuda_prefix1645_test.zig b/zig/src/families/qwen3_5/cuda_prefix1645_test.zig
new file mode 100644
index 00000000..aecd194b
--- /dev/null
+++ b/zig/src/families/qwen3_5/cuda_prefix1645_test.zig
