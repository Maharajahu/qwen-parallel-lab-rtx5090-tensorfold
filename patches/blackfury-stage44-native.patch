+// Experimental GPU adapter for the preserved per-tensor FP8 prefix kernel.
+#include <cuda_fp8.h>
+#include "qwen35.cuh"
+using namespace tf_q35;
+constexpr int PREFIX = 129024;
+constexpr int PACKED_Q = 54;
+constexpr int SPLITS = 42;
+
+struct SourceRow { const unsigned char *k, *v; const float *ks, *vs; };
+__device__ SourceRow source_row(const Seg& sg, int layer, int head, int pos) {
+    const auto* base = reinterpret_cast<const unsigned char*>(sg.kv);
+    const int page = reinterpret_cast<const int*>(sg.pt)[pos / 128];
+    base += size_t(page) * sg.ps + size_t(layer) * 2 * 4 * 128 * (256 + 4);
+    const size_t row = size_t(head) * 128 + pos % 128;
+    const auto* values = base + 4 * 128 * 256;
+    const auto* scales = reinterpret_cast<const float*>(values + 4 * 128 * 256);
+    return {base + row * 256, values + row * 256, scales + row, scales + 4 * 128 + row};
+}
+
+extern "C" __global__ void tf_p1645_init(float* scales, int* queue, unsigned* stats) {
+    if (threadIdx.x == 0) {
+        scales[0] = 1.0f / 16.0f;
+        scales[1] = scales[2] = 0.0f;
+        atomicAdd(stats, 1u);
+        stats[2] = PREFIX;
+    }
+    if (threadIdx.x < 4) queue[threadIdx.x] = 1848;
+}
+
+extern "C" __global__ void tf_p1645_scales(const Seg* segs, int layer, float* scales, unsigned* stats) {
+    __shared__ float sk[256], sv[256];
+    const int t = threadIdx.x, i = blockIdx.x * 256 + t;
+    float a = 0, b = 0;
+    if (i < PREFIX * 4) {
+        const SourceRow row = source_row(segs[0], layer, i % 4, i / 4);
+        a = *row.ks; b = *row.vs;
+        if (!(isfinite(a) && isfinite(b) && a >= 0 && b >= 0)) atomicAdd(stats + 1, 1u);
+        if (!isfinite(a) || a < 0) a = 0;
+        if (!isfinite(b) || b < 0) b = 0;
+    }
+    sk[t] = a; sv[t] = b;
+    __syncthreads();
+    for (int width = 128; width; width >>= 1) {
+        if (t < width) { sk[t] = fmaxf(sk[t], sk[t + width]); sv[t] = fmaxf(sv[t], sv[t + width]); }
+        __syncthreads();
+    }
+    if (t == 0) {
+        atomicMax(reinterpret_cast<unsigned*>(scales + 1), __float_as_uint(fmaxf(sk[0], 0x1p-24f)));
+        atomicMax(reinterpret_cast<unsigned*>(scales + 2), __float_as_uint(fmaxf(sv[0], 0x1p-24f)));
+    }
+}
+
+extern "C" __global__ void tf_p1645_pack_kv(const Seg* segs, int layer, const float* scales,
+                                            unsigned char* keys, unsigned char* values, unsigned* stats) {
+    const int head = blockIdx.y, d = threadIdx.x;
+    for (int j = 0; j < 32; ++j) {
+        const int pos = blockIdx.x * 32 + j;
+        const SourceRow row = source_row(segs[0], layer, head, pos);
+        const float k = __half2float(__half(__nv_cvt_fp8_to_halfraw(row.k[d], __NV_E4M3))) * *row.ks;
+        const float v = __half2float(__half(__nv_cvt_fp8_to_halfraw(row.v[d], __NV_E4M3))) * *row.vs;
+        if (!isfinite(k) || !isfinite(v)) atomicAdd(stats + 1, 1u);
+        const size_t out = (size_t(pos) * 4 + head) * 256 + d;
+        keys[out] = __nv_cvt_float_to_fp8(isfinite(k) ? k / scales[1] : 0.0f, __NV_SATFINITE, __NV_E4M3);
+        values[out] = __nv_cvt_float_to_fp8(isfinite(v) ? v / scales[2] : 0.0f, __NV_SATFINITE, __NV_E4M3);
+    }
+}
+
+extern "C" __global__ void tf_p1645_pack_q(const __nv_bfloat16* q, const int* params,
+                                           unsigned char* packed, unsigned* stats) {
+    const int pq = blockIdx.x, head = blockIdx.y, d = threadIdx.x;
+    const int row = pq / 6, subhead = pq % 6;
+    const float value = row < params[2] ? bf(q[(size_t(row) * 24 + head * 6 + subhead) * 256 + d]) : 0;
+    if (!isfinite(value) || fabsf(value) > 28.0f) atomicAdd(stats + 1, 1u);
+    packed[(size_t(pq) * 4 + head) * 256 + d] = __nv_cvt_float_to_fp8(isfinite(value) ? value * 16.0f : 0.0f, __NV_SATFINITE, __NV_E4M3);
+}
+
+extern "C" __global__ void tf_p1645_merge(const __nv_bfloat16* prefix, const float* lse,
+    const float* pm, const float* pl, const float* po, const int* params, __nv_bfloat16* output) {
+    __shared__ float weights[SPLITS + 1], denominator;
+    const int q = blockIdx.x, row = q / 24, head = (q % 24) / 6, pq = row * 6 + q % 6;
+    const int d = threadIdx.x;
+    if (row >= params[2]) return;
+    const size_t tail = size_t(q) * 64 + 63;
+    if (d == 0) {
+        float mx = -INFINITY;
+        for (int s = 0; s < SPLITS; ++s) {
+            weights[s] = lse[(s * 4 + head) * PACKED_Q + pq];
+            mx = fmaxf(mx, weights[s]);
+        }
+        weights[SPLITS] = pl[tail] > 0 ? pm[tail] + logf(pl[tail]) : -INFINITY;
+        mx = fmaxf(mx, weights[SPLITS]);
+        float den = 0;
+        for (int s = 0; s <= SPLITS; ++s) { weights[s] = expf(weights[s] - mx); den += weights[s]; }
+        denominator = den;
+    }
+    __syncthreads();
+    float acc = 0;
+    for (int s = 0; s < SPLITS; ++s)
+        acc = fmaf(weights[s], bf(prefix[((size_t(s) * PACKED_Q + pq) * 4 + head) * 256 + d]), acc);
+    if (pl[tail] > 0) acc = fmaf(weights[SPLITS], po[tail * 256 + d] / pl[tail], acc);
+    output[size_t(q) * 256 + d] = __float2bfloat16_rn(acc / denominator);
+}
