--- /dev/null
+++ b/zig/src/families/qwen3_5/cuda_draft_timing.zig
@@ -0,0 +1,15 @@
+//! Optional wall-clock diagnostics shared by DFlash, MTP and verification.
+const std = @import("std");
+
+pub fn enabled() bool {
+    return @import("cuda_round_timing.zig").enabled();
+}
+
+/// TF_TIMING=1: each call's wall time on stderr.
+pub fn write(what: []const u8, io: std.Io, t0: std.Io.Timestamp) void {
+    if (!enabled()) return;
+    const now = std.Io.Clock.awake.now(io);
+    const ns: f64 = @floatFromInt(t0.durationTo(now).toNanoseconds());
+    const at: f64 = @floatFromInt(@mod(now.toNanoseconds(), 1_000_000_000_000));
+    std.debug.print("[timing] {s} {d:.2} ms at {d:.1}\n", .{ what, ns / 1e6, at / 1e6 });
+}
