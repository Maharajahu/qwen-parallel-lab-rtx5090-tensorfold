+            try std.testing.expect(direct.key() != packed_shape.key());
+        } else try std.testing.expectEqual(exact.key(), direct.key());
+        if (rows == 9 or rows == 10) {
+            const index: usize = if (rows == 9) 0 else 1;
+            if (keys[index]) |key| try std.testing.expectEqual(key, direct.key());
+            keys[index] = direct.key();
+        }
+        selectDirect(&direct, rows, &segs, true, false);
+        try std.testing.expectEqual(DirectKind.none, direct.direct_kind);
+        try std.testing.expectEqual(exact.key(), direct.key());
+        selectDirect(&packed_shape, rows, &segs, false, true);
+        try std.testing.expectEqual(DirectKind.none, packed_shape.direct_kind);
+        try std.testing.expectEqual(rows <= 9, packed_shape.prefix1645);
+    }
+    try std.testing.expect(keys[0].? != keys[1].?);
+    for (1..11) |rows| {
+        segs[0].rows = @intCast(rows);
+        for ([_]i32{ 129024, @intCast(131072 - rows) }) |cached| {
+            segs[0].len = cached;
+            var shape = Shape.init(rows, 1, true, false, 16);
+            shape.mt2 = true;
+            selectSpecialized(&shape, mt2, rows, &segs, true);
