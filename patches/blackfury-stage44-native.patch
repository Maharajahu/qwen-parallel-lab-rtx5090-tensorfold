+    const float* pm, const float* pl, const float* po, const int* params, __nv_bfloat16* output) {
+    __shared__ float weights[SPLITS + 1], denominator;
+    const int q = blockIdx.x, row = q / 24, head = (q % 24) / 6, pq = row * 6 + q % 6;
+    const int d = threadIdx.x;
+    if (row >= params[2]) return;
+    const size_t tail = size_t(q) * 64 + 63;
+    if (d == 0) {
+        float mx = -INFINITY;
+        for (int s = 0; s < SPLITS; ++s) {
+            weights[s] = lse[(s * 4 + head) * PACKED_Q + pq];
+            mx = fmaxf(mx, weights[s]);
+        }
+        weights[SPLITS] = pl[tail] > 0 ? pm[tail] + logf(pl[tail]) : -INFINITY;
+        mx = fmaxf(mx, weights[SPLITS]);
+        float den = 0;
+        for (int s = 0; s <= SPLITS; ++s) { weights[s] = expf(weights[s] - mx); den += weights[s]; }
+        denominator = den;
+    }
+    __syncthreads();
+    float acc = 0;
+    for (int s = 0; s < SPLITS; ++s)
+        acc = fmaf(weights[s], bf(prefix[((size_t(s) * PACKED_Q + pq) * 4 + head) * 256 + d]), acc);
+    if (pl[tail] > 0) acc = fmaf(weights[SPLITS], po[tail * 256 + d] / pl[tail], acc);
+    output[size_t(q) * 256 + d] = __float2bfloat16_rn(acc / denominator);
+}
