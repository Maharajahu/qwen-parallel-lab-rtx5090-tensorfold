+}
+
+/// Select measured specializations from real row counts before using the captured window bucket.
+pub fn selectSpecialized(shape: anytype, mt2: anytype, rows: usize, segs: anytype, prefix1645: bool) void {
+    shape.async_attn = shape.mt2 and mt2.async_paged != null and useAsync(rows, @intCast(segs[0].len));
+    shape.paired_attn = shape.mt2 and mt2.paired != null and @import("cuda_paired.zig").use(rows, segs);
+    shape.prefix1645 = prefix1645 and shape.paired_attn and rows <= 9;
+}
+
+/// Run after selectSpecialized; compatible is the binding's preflight, before any captured graph lookup.
+pub fn selectDirect(shape: anytype, rows: usize, segs: anytype, enabled: bool, compatible: bool) void {
+    shape.direct_kind = .none;
+    if (!enabled) return;
+    // A refused direct request retains Exact paired attention, never the approximate packed prefix.
+    shape.prefix1645 = false;
+    shape.paired_attn = shape.mt2 and shape.paired_attn and @import("cuda_paired.zig").use(rows, segs);
+    if (!compatible or !shape.paired_attn) return;
+    shape.direct_kind = if (rows <= 9) .q54 else .q60;
+}
