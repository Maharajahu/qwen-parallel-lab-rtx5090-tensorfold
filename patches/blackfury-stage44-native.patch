diff --git a/tools/tests/test_prefix1645_direct_adapter.py b/tools/tests/test_prefix1645_direct_adapter.py
new file mode 100644
index 00000000..8977af39
--- /dev/null
+++ b/tools/tests/test_prefix1645_direct_adapter.py
@@ -0,0 +1,66 @@
+"""Host/source checks only; CUDA compilation and numerical device gates are separate."""
+import re
+import unittest
+from pathlib import Path
+
+
+ROOT = Path(__file__).resolve().parents[2]
+CUDA = ROOT / "zig" / "kernels" / "cuda"
+LEGACY_SYMBOL = "tf_p1645_merge"
+DIRECT_SYMBOL = "tf_p1645d_merge60"
+ENTRY = re.compile(r'extern\s+"C"\s+__global__\s+void\s+(\w+)\s*\(')
+
+
+def tokens(source):
+    source = re.sub(r"//[^\n]*|/\*.*?\*/", "", source, flags=re.S)
+    return re.findall(r'\w+|[^\s\w]', source)
+
+
+def entry(source, name):
+    matches = [match for match in ENTRY.finditer(source) if match.group(1) == name]
+    if len(matches) != 1:
+        raise AssertionError(f"Expected exactly one {name} entry, found {len(matches)}")
+    start = matches[0].start()
+    body = source.index("{", matches[0].end())
+    depth = 1
+    for end in range(body + 1, len(source)):
+        depth += (source[end] == "{") - (source[end] == "}")
+        if depth == 0:
+            return source[start:end + 1]
+    raise AssertionError(f"Unclosed {name} entry")
+
+
+class Prefix1645DirectAdapterTests(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.legacy = (CUDA / "qwen35_prefix1645.cu").read_text(encoding="utf-8")
+        cls.direct = (CUDA / "qwen35_prefix1645_direct.cu").read_text(encoding="utf-8")
+
+    def test_only_direct_merge_is_exported(self):
+        self.assertEqual([match.group(1) for match in ENTRY.finditer(self.direct)], [DIRECT_SYMBOL])
+
+    def test_only_symbol_and_packed_query_stride_differ_from_stage24(self):
+        legacy_merge = entry(self.legacy, LEGACY_SYMBOL).replace(LEGACY_SYMBOL, DIRECT_SYMBOL, 1)
+        expected = '#include "qwen35.cuh"\nusing namespace tf_q35;\n'
+        expected += "constexpr int PACKED_Q = 60;\nconstexpr int SPLITS = 42;\n" + legacy_merge
+        self.assertEqual(tokens(self.direct), tokens(expected))
+        self.assertRegex(self.legacy, r"constexpr\s+int\s+PACKED_Q\s*=\s*54\s*;")
+        self.assertRegex(self.legacy, r"constexpr\s+int\s+SPLITS\s*=\s*42\s*;")
+
+    def test_q60_host_envelope_covers_tenth_row_and_final_elements(self):
+        cases = {
+            0: (0, 0, 0), 5: (0, 0, 5), 6: (0, 1, 0), 23: (0, 3, 5),
+            24: (1, 0, 6), 215: (8, 3, 53), 216: (9, 0, 54), 239: (9, 3, 59),
+        }
+        for query, expected in cases.items():
+            row, within_row = divmod(query, 24)
+            head, subhead = divmod(within_row, 6)
+            self.assertEqual((row, head, row * 6 + subhead), expected)
+        self.assertEqual(240, (60 // 6) * 24)
+        self.assertEqual(((41 * 60 + 59) * 4 + 3) * 256 + 255, 42 * 60 * 4 * 256 - 1)
+        self.assertEqual((41 * 4 + 3) * 60 + 59, 42 * 4 * 60 - 1)
+        self.assertLess((41 * 4 + 3) * 54 + 59, 42 * 4 * 60 - 1)
+
+
+if __name__ == "__main__":
+    unittest.main()
