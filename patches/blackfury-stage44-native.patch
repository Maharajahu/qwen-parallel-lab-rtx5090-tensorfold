+//! DFlash copy and acceptance policy, independent of device state.
+const lanes = @import("lanes");
+const geometry = @import("cuda_geometry.zig");
+
+/// Acceptance by depth until a stream has its own (the reference's chat text: measured, see the commit).
+pub const prior = [_]f64{ 0.75, 0.65, 0.58, 0.52, 0.47, 0.43, 0.4, 0.37, 0.35, 0.33, 0.31, 0.29, 0.28, 0.27, 0.26 };
+
+/// The dense 27B leaves short copies to its drafts and copies after long_match (20).
+pub fn copyMatch(g: anytype) i64 {
+    return if (geometry.dense27(g)) lanes.windows.long_match else 0;
+}
+
+/// Only dense 27B DFlash2 opts into short copies; other drafter kinds retain their existing policy.
+pub fn copyMatchWithFlag(g: anytype, dflash2: bool, enabled: bool) i64 {
+    return if (dflash2 and enabled and geometry.dense27(g)) 6 else copyMatch(g);
+}
