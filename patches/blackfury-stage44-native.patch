 //! A batch with a paged stream keys its captured graph apart; the kernels read each stream through its own layout.
 const std = @import("std");
 
+/// The fixed page geometry is checked before graph lookup; incompatible layouts retain the generic path.
+pub fn usePage128Mt2(enabled: bool, fp8: bool, prompt: bool, rows: usize, segs: anytype) bool {
+    return enabled and fp8 and !prompt and rows > 0 and rows <= 16 and segs.len == 1 and
+        segs[0].pt != 0 and segs[0].ptok == 128 and segs[0].len >= 8192;
+}
+
+test "Qwen attention path: page128 MT2 dispatch boundaries and fallbacks" {
+    const Seg = struct { pt: u64 = 1, ptok: i32 = 128, len: i32 = 8192 };
+    var segs = [_]Seg{.{}};
+    for ([_]i32{ 8192, 65536, 129024, 131071 }) |n| {
+        segs[0].len = n;
+        try std.testing.expect(usePage128Mt2(true, true, false, 16, &segs));
+    }
+    segs[0].len = 8191;
+    try std.testing.expect(!usePage128Mt2(true, true, false, 16, &segs));
+    segs[0].len = 8192;
+    for ([_]usize{ 0, 17, 32 }) |rows| try std.testing.expect(!usePage128Mt2(true, true, false, rows, &segs));
+    try std.testing.expect(!usePage128Mt2(false, true, false, 1, &segs));
+    try std.testing.expect(!usePage128Mt2(true, false, false, 1, &segs));
+    try std.testing.expect(!usePage128Mt2(true, true, true, 1, &segs));
+    try std.testing.expect(!usePage128Mt2(true, true, false, 1, @as([]const Seg, &.{})));
+    try std.testing.expect(!usePage128Mt2(true, true, false, 2, @as([]const Seg, &.{ .{}, .{} })));
+    for ([_]i32{ 16, 32, 64, 256 }) |ptok| {
+        segs[0].ptok = ptok;
+        try std.testing.expect(!usePage128Mt2(true, true, false, 1, &segs));
+    }
+    segs[0].ptok = 128;
+    segs[0].pt = 0;
+    try std.testing.expect(!usePage128Mt2(true, true, false, 1, &segs));
+}
+
 pub fn hasPages(segs: anytype) bool {
     for (segs) |sg| if (sg.pt != 0) return true;
     return false;
 }
 
+/// At most 4,096 keys need 32 of the existing 128-key partial chunks and no row tiles.
+pub fn fits32(segs: anytype) bool {
+    for (segs) |sg| if (@as(i64, sg.len) + sg.rows > 4096) return false;
+    return segs.len != 0;
+}
