+//! The local SM120a page-128 specialization; other chips and compilers remain unmeasured.
+const std = @import("std");
+const reg = @import("registry.zig");
+pub const records = [_]reg.CudaRecord{
+    .{ .launch = .{ .name = "tf_q35_attn_rows8_mt2_q27", .symbol = "tf_q35_attn_rows8_mt2_q27", .image = "qwen35_kv8", .threads = 128, .min_sm = 120 }, .usage = reg.none, .later_pending = true },
+    .{ .launch = .{ .name = "tf_q35_attn_rows8_mt2_q27_async", .symbol = "tf_q35_attn_rows8_mt2_q27_async", .image = "qwen35_kv8", .threads = 128, .min_sm = 120 }, .usage = reg.none, .later_pending = true },
+    .{ .launch = .{ .name = "tf_q35_attn_paired_prefix", .symbol = "tf_q35_attn_paired_prefix", .image = "qwen35_kv8", .threads = 384, .min_sm = 120 }, .usage = reg.none, .later_pending = true },
+    .{ .launch = .{ .name = "tf_q35_attn_paired_tail", .symbol = "tf_q35_attn_paired_tail", .image = "qwen35_kv8", .threads = 128, .min_sm = 120 }, .usage = reg.none, .later_pending = true },
+    .{ .launch = .{ .name = "tf_q35_attn_paired_merge", .symbol = "tf_q35_attn_paired_merge", .image = "qwen35_kv8", .threads = 256, .min_sm = 120 }, .usage = reg.none, .later_pending = true },
+};
+test "q27 page128 resource receipt only qualifies the measured compiler and chip" {
+    const r = records[0];
+    const u = reg.usageFor(r, .{ .major = 13, .minor = 3 });
+    try std.testing.expectEqual(@as(u32, 240), u[3].regs);
+    try std.testing.expectEqual(@as(u32, 36992), u[3].static);
+    try std.testing.expectEqual(@as(u32, 128), u[3].bound);
+    for ([_]usize{ 0, 1, 2, 4 }) |i| try std.testing.expectEqual(@as(u32, 0), u[i].regs);
+    try std.testing.expectEqual(reg.none, reg.usageFor(r, .{ .major = 13, .minor = 2 }));
+    var found: usize = 0;
+    for (reg.all_cuda) |active| if (std.mem.eql(u8, active.launch.name, r.launch.name)) {
+        found += 1;
+    };
+    try std.testing.expectEqual(@as(usize, 1), found);
+}
+
+test "async q27 launch uses its measured three-block resource envelope" {
+    const u = reg.usageFor(records[1], .{ .major = 13, .minor = 3 });
+    try std.testing.expectEqual(@as(u32, 168), u[3].regs);
+    try std.testing.expectEqual(@as(u32, 32896), u[3].static);
+    try std.testing.expectEqual(@as(u32, 128), u[3].bound);
+    for ([_]usize{ 0, 1, 2, 4 }) |i| try std.testing.expectEqual(@as(u32, 0), u[i].regs);
+}
