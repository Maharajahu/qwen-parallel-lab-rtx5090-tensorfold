+// Same FP4 row sums; the two projections share one launch and separate CTAs.
+
+extern "C" __global__ void __launch_bounds__(128) tf_qmmf_fp4_pair(
+        const __nv_bfloat16* x, const unsigned char* w0, const uint8_t* s0,
+        const unsigned char* w1, const uint8_t* s1,
+        void* y0, void* y1, float scale0, float scale1,
+        int M, int N, int K, int npad, int ldx, int group) {
+    constexpr int MODE=FP4,BM=16,BN=64,WM=1,WN=4,STAGES=4;
