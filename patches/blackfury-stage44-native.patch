+    const bool active=query<30&&m0+query/6<total;
+    const size_t qindex=active?size_t((m0+query/6)*24+h*6+query%6):0;
+    const uint32_t* q=reinterpret_cast<const uint32_t*>(Q+qindex*256);
+#pragma unroll
+    for(int k=0;k<16;++k){uint2 z=make_uint2(active?q[8*k+qd]:0,active?q[8*k+qd+4]:0);if(k<8)qs[k][tid]=z;else qa[k-8]=z;}
+    float out[16][4] = {};
+    float mx[2] = {-INFINITY, -INFINITY}, sum[2] = {};
+    tiles.shared_fetch(c * 2048, true);
+    for (int pos = c * 2048; pos < (c + 1) * 2048; pos += 64) {
+        float s[4][4],alpha[2][2];
+#pragma unroll
+        for(int half=0;half<2;++half){
+            triple_sync<GROUP>(); tiles.wait(); tiles.put(true); triple_sync<GROUP>();
+            if(half==0)tiles.shared_fetch(pos+32,true);else tiles.shared_fetch(pos,false);
+#pragma unroll
+            for(int k=0;k<16;++k){
+                const uint2 qr = k<8?qs[k][tid]:qa[k-8];
+                const uint32_t qa0=qr.x,qa1=qr.y;
+#pragma unroll
+                for(int j=0;j<2;++j){uint32_t a[4];qmm_frag::ldmatrix4(a,kt+swz(16*j+lane%16,2*k+lane/16));
+                    if(k==0)qmm_frag::mma0(s[2*half+j],a,qa0,qa1);else qmm_frag::mma(s[2*half+j],a,qa0,qa1);
+                }
+            }
+#pragma unroll
+            for(int j=0;j<2;++j){
+#pragma unroll
+                for(int e=0;e<2;++e){
+                    s[2*half+j][e]=s[2*half+j][e]*ksc[32*half+16*j+g]*scale;
+                    s[2*half+j][2+e]=s[2*half+j][2+e]*ksc[32*half+16*j+g+8]*scale;
+                }
+            }
+#pragma unroll
+            for (int e = 0; e < 2; ++e) {
+                const int j0 = 2 * half;
+                const float hm0 = fmaxf(s[j0][e], s[j0][2 + e]);
+                const float hm1 = fmaxf(s[j0 + 1][e], s[j0 + 1][2 + e]);
+                float tm = fmaxf(hm0, hm1);
+                tm = fmaxf(tm, __shfl_xor_sync(0xffffffffu, tm, 4));
+                tm = fmaxf(tm, __shfl_xor_sync(0xffffffffu, tm, 8));
+                tm = fmaxf(tm, __shfl_xor_sync(0xffffffffu, tm, 16));
+                const float next = fmaxf(mx[e], tm);
+                alpha[half][e] = mx[e] == -INFINITY ? 0.0f : texp(mx[e] - next);
+                float hs[2];
+#pragma unroll
+                for (int j = 0; j < 2; ++j) {
+                    const int at = j0 + j;
+                    s[at][e] = texp(s[at][e] - next);
+                    s[at][2 + e] = texp(s[at][2 + e] - next);
+                    const float b = __shfl_xor_sync(0xffffffffu, s[at][e], 4);
+                    const float f = __shfl_xor_sync(0xffffffffu, s[at][2 + e], 4);
+                    float v = ((s[at][e] + b) + s[at][2 + e]) + f;
+                    v += __shfl_xor_sync(0xffffffffu, v, 8);
+                    v += __shfl_xor_sync(0xffffffffu, v, 16);
+                    hs[j] = v;
+                }
+                float subtotal = hs[0] + hs[1];
+                subtotal = __shfl_sync(0xffffffffu, subtotal, qd);
+                sum[e] = fmaf(sum[e], alpha[half][e], subtotal);
+                mx[e] = next;
+            }
+        }
+#pragma unroll
+        for(int half=0;half<2;++half){
+            // Rescale between the two PV updates, preserving the original rounding points.
+            if(__any_sync(0xffffffffu,alpha[half][0]!=1.0f||alpha[half][1]!=1.0f)){
+#pragma unroll
+                for(int n=0;n<16;++n){transpose_mul2(out[n][0],out[n][1],alpha[half][0],alpha[half][1]);transpose_mul2(out[n][2],out[n][3],alpha[half][0],alpha[half][1]);}
+            }
+            triple_sync<GROUP>();tiles.wait();tiles.put(false);triple_sync<GROUP>();
+            if(half==0)tiles.shared_fetch(pos+32,false);
+            else if(pos+64<(c+1)*2048)tiles.shared_fetch(pos+64,true);
+#pragma unroll
+            for(int j=0;j<2;++j){
+                const uint32_t p0=pack_bf16(s[2*half+j][0]*ksc[32*half+16*j+g],s[2*half+j][1]*ksc[32*half+16*j+g]);
+                const uint32_t p1=pack_bf16(s[2*half+j][2]*ksc[32*half+16*j+g+8],s[2*half+j][3]*ksc[32*half+16*j+g+8]);
+                const int lo=8*qd+g/2, hi=lo+4;const unsigned sel=(g&1)?0x7632:0x5410;
+                uint32_t b[2];
+                b[0]=__byte_perm(__shfl_sync(0xffffffffu,p0,lo),__shfl_sync(0xffffffffu,p0,hi),sel);
+                b[1]=__byte_perm(__shfl_sync(0xffffffffu,p1,lo),__shfl_sync(0xffffffffu,p1,hi),sel);
+#pragma unroll
+                for(int n=0;n<16;++n){uint32_t a[4];qmm_frag::ldmatrix4t(a,kt+swz(16*j+(lane%8)+8*(lane/16),2*n+((lane/8)%2)));qmm_frag::mma(out[n],a,b[0],b[1]);}
+            }
+        }
+    }
+    if (true) {
+#pragma unroll
+        for (int e = 0; e < 2; e++) {
+            const int iq = warp * 8 + 2 * qd + e;
+            if (iq < 30 && m0 + iq / 6 < total) {
+                const size_t slot = ((m0 + iq / 6) * 24 + h * 6 + iq % 6) * 64 + c;
+                if (g == 0) { PM[slot] = mx[e]; PL[slot] = sum[e]; }
+#pragma unroll
+                for (int n = 0; n < 16; n++) {
+                    PO[slot * 256 + 16 * n + g] = out[n][e];
+                    PO[slot * 256 + 16 * n + g + 8] = out[n][2 + e];
+                }
+            }
+        }
+    }
+}
+
+extern "C" __global__ void __launch_bounds__(384,1) tf_q35_attn_paired_prefix(
+    Geo geo,const __nv_bfloat16* Q,const Seg* segs,const int* rowseg,const Ancestor* rowanc,
+    int layer,const int* P,float scale,int total,float* PM,float* PL,float* PO){
+    using namespace tf_q35_tc;auto& shared=triple64_storage();
+    if(blockIdx.x>=2||blockIdx.y>=21)return;
+    if(P)total=min(total,P[2]);if(int(blockIdx.x)*5>=total)return;
+    const int tid=threadIdx.x;
+    if(tid==0||tid==128||tid==256){const unsigned mb=tf_common::smem(&shared.barriers[tid/128]);
+        asm volatile("mbarrier.init.shared::cta.b64 [%0],1;"::"r"(mb):"memory");
+        asm volatile("fence.proxy.async.shared::cta;":::"memory");}
+    __syncthreads();
+    if(tid<128)triple64_body<0>(Q,segs,layer,scale,total,PM,PL,PO);
+    else if(tid<256)triple64_body<1>(Q,segs,layer,scale,total,PM,PL,PO);
+    else triple64_body<2>(Q,segs,layer,scale,total,PM,PL,PO);
+}
+extern "C" __global__ void __launch_bounds__(128, 1) tf_q35_attn_paired_tail(
+    Geo geo,
+    const __nv_bfloat16* __restrict__ Q,
+    const Seg* __restrict__ segs,
+    const int* __restrict__ rowseg,
+    const Ancestor* __restrict__ rowanc,
+    int layer,
+    const int* __restrict__ P,
+    float scale,
+    int total,
+    float* __restrict__ PM,
+    float* __restrict__ PL,
+    float* __restrict__ PO) {
+    using namespace tf_q35;
+    using namespace tf_q35_tc;
+
+    static_assert(HD == 256, "tf_q35_attn_paired_tail requires HD=256");
+    static_assert(TK == 32, "tf_q35_attn_paired_tail requires 32-key tiles");
+    static_assert(CH == 32, "tf_q35_attn_paired_tail requires HD/8=32");
+
+    constexpr int QH = 24;
+    constexpr int KVH = 4;
+    constexpr int G = QH / KVH;       // Six queries per KV head.
+    constexpr int C = 63;
+    constexpr int K0 = C * 2048;      // 129024.
+    constexpr unsigned FULL = 0xffffffffu;
+
+    __shared__ __align__(16) uint4 kt[TK * CH];
+    __shared__ __align__(16) uint4 vt[TK * CH];
+    __shared__ float ksc[TK];
+    __shared__ float vsc[TK];
+
+    const int tid = threadIdx.x;
+    const int warp = tid >> 5;
+    const int lane = tid & 31;
+    const int g = lane >> 2;
+    const int qd = lane & 3;
+    const int m = static_cast<int>(blockIdx.x);
+    const int h = static_cast<int>(blockIdx.z);
+
+    // Use P[2] without reading unused per-row metadata.
+    int active_rows = total;
+    if (P != nullptr) active_rows = min(active_rows, P[2]);
+
+    if (blockIdx.y != 0 || m >= active_rows || h >= KVH) return;
+
+    const Seg sg = segs[rowseg[m]];
+    const Ancestor anc = rowanc[m];
+    const int keys = sg.len + rows_seen(anc);
+    const int k1 = min(K0 + 2048, keys);
+
+    if (K0 >= k1) {
+        if (tid < G) {
+            const size_t slot =
+                ((size_t(m) * QH + h * G + tid) * MAXCH) + C;
+            PM[slot] = -INFINITY;
+            PL[slot] = 0.0f;
+        }
+        return;
+    }
+
+    // Each warp caches eight transposed queries; queries six and seven remain padding.
+    uint2 qa[HD / 16];
+    const bool real_q = g < G;
+    const uint32_t* q = nullptr;
+    if (real_q) {
+        const size_t qi = size_t(m) * QH + h * G + g;
+        q = reinterpret_cast<const uint32_t*>(Q + qi * HD);
+    }
+
+#pragma unroll
+    for (int k = 0; k < HD / 16; ++k) {
+        uint32_t q0 = 0u;
+        uint32_t q1 = 0u;
+        if (real_q) {
+            q0 = q[8 * k + qd];
+            q1 = q[8 * k + qd + 4];
+        }
+        qa[k] = make_uint2(q0, q1);
+    }
+
+    // Each warp owns 64 output dimensions: four groups of 16.
+    float out[4][4];
+#pragma unroll
+    for (int n = 0; n < 4; ++n) {
+        out[n][0] = 0.0f;
+        out[n][1] = 0.0f;
+        out[n][2] = 0.0f;
+        out[n][3] = 0.0f;
+    }
+
+    // Two queries per qd lane.
+    float mx[2] = {-INFINITY, -INFINITY};
+    float sum[2] = {0.0f, 0.0f};
+
+    Paged27Tiles<128> tiles(
+        TileStore{kt, vt, ksc, vsc}, sg, layer, KVH, h);
+
+    // Check the logical bound before accessing ancestor metadata.
+    auto rowof = [&](int t) -> int {
+        if (t >= k1) return -1;
+        return t < sg.len
+            ? t
+            : sg.len + seen_row(anc, t - sg.len);
+    };
+
+    // Register-prefetch the first tile.
+    tiles.fetch(K0, rowof);
+
+    for (int t0 = K0; t0 < k1; t0 += TK) {
+        // Finish reading the old tile before overwriting shared K/V.
+        __syncthreads();
+        tiles.put(true);  // Paged27Tiles also installs V and both scales.
+        __syncthreads();
+
+        // Prefetch only into registers while shared K/V serves the current tile.
+        if (t0 + TK < k1) tiles.fetch(t0 + TK, rowof);
+
+        float s[2][4];
+
+        // Each warp repeats the same transposed QK calculation.
+#pragma unroll
+        for (int k = 0; k < HD / 16; ++k) {
+            const uint32_t q0 = qa[k].x;
+            const uint32_t q1 = qa[k].y;
+
+#pragma unroll
+            for (int j = 0; j < 2; ++j) {
+                uint32_t a[4];
+                qmm_frag::ldmatrix4(
+                    a,
+                    kt + swz(
+                        16 * j + lane % 16,
+                        2 * k + lane / 16));
+
+                if (k == 0)
+                    qmm_frag::mma0(s[j], a, q0, q1);
+                else
+                    qmm_frag::mma(s[j], a, q0, q1);
+            }
+        }
+
+        // Preserve FP32 rounding at QK * key_scale, then * attention_scale.
+#pragma unroll
+        for (int j = 0; j < 2; ++j) {
+#pragma unroll
+            for (int e = 0; e < 2; ++e) {
+                const int u0 = 16 * j + g;
+                const int u1 = u0 + 8;
+
+                s[j][e] = t0 + u0 < k1
+                    ? s[j][e] * ksc[u0] * scale
+                    : -INFINITY;
+
+                s[j][2 + e] = t0 + u1 < k1
+                    ? s[j][2 + e] * ksc[u1] * scale
+                    : -INFINITY;
+            }
+        }
+
+        float alpha[2];
+
+#pragma unroll
+        for (int e = 0; e < 2; ++e) {
+            // Preserve the original maximum across both 16-key halves.
+            const float hm0 = fmaxf(s[0][e], s[0][2 + e]);
+            const float hm1 = fmaxf(s[1][e], s[1][2 + e]);
+            float tm = fmaxf(hm0, hm1);
+
+            tm = fmaxf(tm, __shfl_xor_sync(FULL, tm, 4));
+            tm = fmaxf(tm, __shfl_xor_sync(FULL, tm, 8));
+            tm = fmaxf(tm, __shfl_xor_sync(FULL, tm, 16));
+
+            const bool act = tm != -INFINITY;
+            const float next = act ? fmaxf(mx[e], tm) : mx[e];
+
+            alpha[e] = act
+                ? (mx[e] == -INFINITY ? 0.0f : texp(mx[e] - next))
+                : 1.0f;
+
+            float hs[2];
+
+#pragma unroll
+            for (int j = 0; j < 2; ++j) {
+                s[j][e] = act && s[j][e] != -INFINITY
+                    ? texp(s[j][e] - next)
+                    : 0.0f;
+
+                s[j][2 + e] = act && s[j][2 + e] != -INFINITY
+                    ? texp(s[j][2 + e] - next)
+                    : 0.0f;
+
+                // Original sum tree: (((k0+k1)+k8)+k9), then g=2/3, then g=4..7.
+                const float b =
+                    __shfl_xor_sync(FULL, s[j][e], 4);
+                const float f =
+                    __shfl_xor_sync(FULL, s[j][2 + e], 4);
+
+                float v =
+                    ((s[j][e] + b) + s[j][2 + e]) + f;
+                v += __shfl_xor_sync(FULL, v, 8);
+                v += __shfl_xor_sync(FULL, v, 16);
+                hs[j] = v;
+            }
+
+            // This is the original red[0] + red[1] rounding point.
+            float subtotal = hs[0] + hs[1];
+            subtotal =
+                __shfl_sync(FULL, subtotal, qd);
+
+            sum[e] = fmaf(sum[e], alpha[e], subtotal);
+            mx[e] = next;
+        }
+
+        // Preserve the original per-tile output-rescale rounding point.
+#pragma unroll
+        for (int n = 0; n < 4; ++n) {
+            transpose_mul2(
+                out[n][0], out[n][1], alpha[0], alpha[1]);
+            transpose_mul2(
+                out[n][2], out[n][3], alpha[0], alpha[1]);
+        }
+
+        // PV. Each warp evaluates only its 64-dimensional slice.
+#pragma unroll
+        for (int j = 0; j < 2; ++j) {
+            const int u0 = 16 * j + g;
+            const int u1 = u0 + 8;
+
+            // Multiply the V scale in FP32 before rounding to BF16.
+            const uint32_t p0 = pack_bf16(
+                s[j][0] * vsc[u0],
+                s[j][1] * vsc[u0]);
+
+            const uint32_t p1 = pack_bf16(
+                s[j][2] * vsc[u1],
+                s[j][3] * vsc[u1]);
+
+            const int lo = 8 * qd + g / 2;
+            const int hi = lo + 4;
+            const unsigned sel = (g & 1) ? 0x7632u : 0x5410u;
+
+            uint32_t p[2];
+            p[0] = __byte_perm(
+                __shfl_sync(FULL, p0, lo),
+                __shfl_sync(FULL, p0, hi),
+                sel);
+            p[1] = __byte_perm(
+                __shfl_sync(FULL, p1, lo),
+                __shfl_sync(FULL, p1, hi),
+                sel);
+
+#pragma unroll
+            for (int n = 0; n < 4; ++n) {
+                const int gn = 4 * warp + n;
+                uint32_t vfrag[4];
+
+                qmm_frag::ldmatrix4t(
+                    vfrag,
+                    vt + swz(
+                        16 * j + lane % 8 + 8 * (lane / 16),
+                        2 * gn + ((lane / 8) & 1)));
+
+                qmm_frag::mma(
+                    out[n], vfrag, p[0], p[1]);
+            }
+        }
+    }
+
+    // One copy of the identical statistics is sufficient.
+    if (warp == 0 && g == 0) {
+#pragma unroll
+        for (int e = 0; e < 2; ++e) {
+            const int iq = 2 * qd + e;
+            if (iq < G) {
+                const size_t slot =
+                    ((size_t(m) * QH + h * G + iq) * MAXCH) + C;
+                PM[slot] = mx[e];
+                PL[slot] = sum[e];
+            }
+        }
+    }
+
+    // Warps own disjoint 64-dimensional regions, so PO has no races.
+#pragma unroll
+    for (int e = 0; e < 2; ++e) {
+        const int iq = 2 * qd + e;
+        if (iq < G) {
+            const size_t slot =
+                ((size_t(m) * QH + h * G + iq) * MAXCH) + C;
+
+#pragma unroll
+            for (int n = 0; n < 4; ++n) {
+                const int d = 16 * (4 * warp + n) + g;
+                PO[slot * HD + d] = out[n][e];
+                PO[slot * HD + d + 8] = out[n][2 + e];
+            }
+        }
+    }
+}
+
+extern "C" __global__ void __launch_bounds__(256) tf_q35_attn_paired_merge(
+    Geo geo,const float* PM,const float* PL,const float* PO,const Seg* segs,
+    const int* rowseg,const Ancestor* rowanc,const int* P,__nv_bfloat16* OUT){
+    __shared__ float pm[64],pl[64],weights[64],maximum;
+    const int d=threadIdx.x,q=blockIdx.x,m=q/geo.qh;
+    if(past_rows(P,m))return;
+    const int keys=segs[rowseg[m]].len+rows_seen(rowanc[m]);
+    const int ck=chunk_keys(keys),nch=(keys+ck-1)/ck;const size_t base=size_t(q)*64;
+    if(d<nch){pm[d]=PM[base+d];pl[d]=PL[base+d];}
+    __syncthreads();
+    if(d==0){float mx=-INFINITY;for(int c=0;c<nch;++c)if(pl[c]>0.0f)mx=fmaxf(mx,pm[c]);maximum=mx;}
+    __syncthreads();
+    if(d<nch)weights[d]=pl[d]>0.0f?__expf(pm[d]-maximum):0.0f;
+    __syncthreads();
+    float acc=0.0f,lsum=0.0f;
+    for(int c=0;c<nch;++c){if(!(pl[c]>0.0f))continue;const float e=weights[c];
+        lsum=fmaf(pl[c],e,lsum);acc=fmaf(PO[(base+c)*256+d],e,acc);}
+    OUT[size_t(q)*256+d]=__float2bfloat16_rn(acc/lsum);
+}
