+        var direct = packed_shape;
+        selectDirect(&direct, rows, &segs, true, true);
+        const kind: DirectKind = if (rows <= 9) .q54 else if (rows == 10) .q60 else .none;
+        try std.testing.expectEqual(kind, direct.direct_kind);
