diff --git a/zig/src/families/qwen3_5/cuda_scratch_test.zig b/zig/src/families/qwen3_5/cuda_scratch_test.zig
new file mode 100644
index 00000000..b2f09043
--- /dev/null
+++ b/zig/src/families/qwen3_5/cuda_scratch_test.zig
@@ -0,0 +1,185 @@
+//! Host-only scratch proofs use synthetic device addresses; no driver calls or device memory are needed.
+const std = @import("std");
+const E = @import("cuda_engine.zig");
+const cuda = @import("cuda");
+const geo = @import("cuda_geometry.zig");
+const scratch = @import("cuda_scratch.zig").scratch;
+const R = E.max_rows;
+const V = E.most_verify;
+const Range = struct { at: u64, bytes: usize };
+
+fn of(e: *const E.Engine, comptime name: []const u8, bytes: usize) Range {
+    return .{ .at = @field(e, name), .bytes = bytes };
+}
+
+fn size(ranges: []const Range) usize {
+    var bytes: usize = 0;
+    for (ranges) |r| bytes += E.aligned(r.bytes);
+    return bytes;
+}
+
+fn separate(a: Range, b: Range) !void {
+    if (a.bytes == 0 or b.bytes == 0) return;
+    try std.testing.expect(a.at + a.bytes <= b.at or b.at + b.bytes <= a.at);
+}
+
+fn phase(e: *const E.Engine, live: []const Range, persistent: []const Range) !void {
+    for (live, 0..) |a, i| {
+        if (a.bytes == 0) continue;
+        try std.testing.expectEqual(@as(u64, 0), a.at % 256);
+        try std.testing.expect(a.at >= e.arena.ptr and a.at + a.bytes <= e.arena.ptr + e.arena_at);
+        for (live[0..i]) |b| try separate(a, b);
+        for (persistent) |b| try separate(a, b);
+    }
+}
+
+fn shape(large: bool) geo.Geometry {
+    return .{
+        .hidden = if (large) 5120 else 2048,
+        .intermediate = if (large) 17408 else 6144,
+        .layers = if (large) 64 else 24,
+        .vocab = 248320,
+        .k_heads = 16,
+        .v_heads = if (large) 48 else 16,
+        .q_heads = if (large) 24 else 8,
+        .kv_heads = if (large) 4 else 2,
+        .eps = 1e-6,
+        .tied = !large,
+        .context = 65536,
+        .linear = @splat(true),
+    };
+}
+
+fn prove(g: geo.Geometry, compact: bool, quant: u2, start: usize, expand: bool) !usize {
+    var e: E.Engine = undefined;
+    e.g = g;
+    e.compact_scratch = compact;
+    e.fp8_acts = quant == 1;
+    e.fp4_acts = quant == 2;
+    e.prefix1645_on = false;
+    e.prefix1645_direct_on = false;
+    e.prompt_expand = .{ .cap = if (expand) 131072 else 0 };
+    e.arena_at = start;
+    e.arena.ptr = 0x100000000;
+    const measured = try scratch(&e, .measure);
+    try std.testing.expectEqual(start, e.arena_at);
+    e.arena.len = start + measured;
+    try std.testing.expectEqual(measured, try scratch(&e, .allocate));
+    try std.testing.expectEqual(measured, E.aligned(e.arena_at) - start);
+    const wide = @max(g.valueWidth(), g.attnWidth(), g.hidden);
+    const partials = V * g.q_heads * E.max_chunks;
+    const persistent = [_]Range{
+        of(&e, "ck_rows", e.ck_rows_bytes), of(&e, "fp4_part", e.fp4_part_bytes),
+        of(&e, "h", R * g.hidden * 2),      of(&e, "x", R * g.hidden * 2),
+        of(&e, "r", R * g.hidden * 2),      of(&e, "xs", R * (@max(g.intermediate, wide) / 64) * 4),
+    };
+    const tails = [_]Range{
+        of(&e, "amax", V * E.argmaxSlices(g.vocab) * 8), of(&e, "picks", V * cuda.sample.Draws.row_scratch),
+    };
+    const outside = persistent ++ tails;
+    try phase(&e, &outside, &.{});
+    const delta = [_]Range{
+        of(&e, "y", R * wide * 2),               of(&e, "mix", R * wide * 2),
+        of(&e, "z", R * wide * 2),               of(&e, "v", R * wide * 2),
+        of(&e, "q", R * g.k_heads * geo.dk * 2), of(&e, "k", R * g.k_heads * geo.dk * 2),
+        of(&e, "qkv", R * g.convWidth() * 2),    of(&e, "a", R * g.v_heads * 2),
+        of(&e, "b", R * g.v_heads * 2),          of(&e, "beta", R * g.v_heads * 2),
+        of(&e, "g_", R * g.v_heads * 4),
+    };
+    const attention = [_]Range{
+        of(&e, "y", R * wide * 2),                         of(&e, "mix", R * wide * 2),
+        of(&e, "qraw", R * 2 * g.attnWidth() * 2),         of(&e, "qn", R * g.attnWidth() * 2),
+        of(&e, "kraw", R * g.kv_heads * geo.head_dim * 2), of(&e, "vraw", R * g.kv_heads * geo.head_dim * 2),
+        of(&e, "kn", R * g.kv_heads * geo.head_dim * 2),   .{ .at = e.prompt_expand.ptr, .bytes = e.prompt_expand.bytes(g.kv_heads) },
+    };
+    const part = [_]Range{
+        of(&e, "pm", partials * 4), of(&e, "pl", partials * 4), of(&e, "po", partials * geo.head_dim * 4),
+    };
+    const mlp = [_]Range{
+        of(&e, "gate", R * g.intermediate * 2), of(&e, "up", R * g.intermediate * 2),
+        of(&e, "act", R * g.intermediate * 2),
+    };
+    const logits = [_]Range{of(&e, "logits", V * g.vocab * 2)};
+    try phase(&e, &delta, &outside);
+    try phase(&e, &(attention ++ part), &outside);
+    try phase(&e, &mlp, &outside);
+    try phase(&e, &logits, &outside);
+    const shared = if (compact)
+        @max(size(&delta), size(&attention) + size(&part), size(&mlp), size(&logits))
+    else
+        @max(size(&delta), size(&attention), size(&mlp)) + size(&part) + size(&logits);
+    try std.testing.expectEqual(size(&persistent) + shared + size(&tails), measured);
+    if (compact) {
+        try std.testing.expectEqual(e.y, e.logits);
+        try std.testing.expectEqual(e.y, e.gate);
+        try std.testing.expect(e.pm >= e.kn + R * g.kv_heads * geo.head_dim * 2);
+    } else {
+        for (part ++ logits) |a| for (delta ++ attention ++ mlp) |b| try separate(a, b);
+    }
+    const addresses = [_]u64{ e.y, e.qn, e.pm, e.gate, e.logits, e.picks };
+    e.arena_at = start;
+    try std.testing.expectEqual(measured, try scratch(&e, .allocate));
+    try std.testing.expectEqualSlices(u64, &addresses, &.{ e.y, e.qn, e.pm, e.gate, e.logits, e.picks });
+    return measured;
+}
+
+test "served scratch: compact phases stay disjoint and measure matches the actual carve at dense geometries" {
+    for ([_]bool{ false, true }) |large| for ([_]usize{ 0, 13 * 256 }) |start| {
+        var g = shape(large);
+        for ([_]u2{ 0, 1, 2 }) |quant| {
+            g.kinds.modelopt = quant != 0;
+            const baseline = try prove(g, false, quant, start, false);
+            const compact = try prove(g, true, quant, start, false);
+            try std.testing.expect(compact < baseline);
+            if (large) try std.testing.expectEqual(@as(usize, 214564864), baseline - compact);
+        }
+    };
+}
+
+test "served scratch: expanded prompt fits measured arena and stays disjoint from live buffers" {
+    for ([_]bool{ false, true }) |compact| {
+        _ = try prove(shape(true), compact, 0, 256, true);
+    }
+}
+
+test "served scratch: compact refuses MoE before changing the arena or scratch pointers" {
+    var e: E.Engine = undefined;
+    e.g = shape(false);
+    e.g.experts = 256;
+    e.compact_scratch = true;
+    e.arena_at = 256;
+    e.logits = 1234;
+    for ([_]@import("cuda_scratch.zig").Mode{ .measure, .allocate }) |mode|
+        try std.testing.expectError(error.CompactScratchNeedsDenseQwen, scratch(&e, mode));
+    try std.testing.expectEqual(@as(usize, 256), e.arena_at);
+    try std.testing.expectEqual(@as(u64, 1234), e.logits);
+}
+
+test "served scratch: direct-page reserves q60 capacity without packed key or value storage" {
+    const prefix = @import("cuda_prefix1645.zig");
+    try std.testing.expectEqual(@as(usize, 5263616), prefix.direct_workspace_bytes);
+    var sizes: [3]usize = undefined;
+    for (0..3) |mode| {
+        var e: E.Engine = undefined;
+        e.g = shape(true);
+        e.compact_scratch = true;
+        e.fp8_acts = false;
+        e.fp4_acts = false;
+        e.prefix1645_on = mode == 1;
+        e.prefix1645_direct_on = mode == 2;
+        e.prompt_expand = .{};
+        e.arena_at = 0;
+        e.arena.ptr = 0x100000000;
+        sizes[mode] = try scratch(&e, .measure);
+        e.arena.len = sizes[mode];
+        try std.testing.expectEqual(sizes[mode], try scratch(&e, .allocate));
+        if (mode != 0) {
+            const bytes = if (mode == 2) prefix.direct_workspace_bytes else prefix.workspace_bytes;
+            try std.testing.expect(e.prefix1645_workspace + bytes <= e.amax);
+            try std.testing.expectEqual(@as(u64, 0), e.prefix1645_workspace % 256);
+        } else try std.testing.expectEqual(@as(u64, 0), e.prefix1645_workspace);
+    }
+    try std.testing.expectEqual(E.aligned(prefix.workspace_bytes), sizes[1] - sizes[0]);
+    try std.testing.expectEqual(E.aligned(prefix.direct_workspace_bytes), sizes[2] - sizes[0]);
+    try std.testing.expect(sizes[1] - sizes[2] > 250 * 1024 * 1024);
+}
