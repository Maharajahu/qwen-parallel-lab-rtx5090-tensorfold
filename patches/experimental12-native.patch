diff --git a/zig/tests/cuda/nvfp4_dense_chunks.zig b/zig/tests/cuda/nvfp4_dense_chunks.zig
new file mode 100644
index 00000000..81787d94
--- /dev/null
+++ b/zig/tests/cuda/nvfp4_dense_chunks.zig
@@ -0,0 +1,89 @@
+//! Bounded BF16-input A4 scratch must produce the full quantize+matmulQuantized oracle's exact bytes.
+const std = @import("std");
+const cuda = @import("cuda");
+const core = @import("core");
+const check = @import("check.zig");
+const rig_ = @import("contract_rig.zig");
+const native = cuda.nvfp4_dense;
+
+pub fn run(gpu: check.Gpu, stream: cuda.Stream, packer: *const cuda.modelopt.Packer, kernels: *const native.Kernels) !usize {
+    var comparisons: usize = 0;
+    for ([_]usize{ native.max_rows - 1, native.max_rows, native.max_rows + 1 }) |rows| {
+        comparisons += try one(gpu, stream, packer, kernels, rows);
+    }
+    return comparisons;
+}
+
+fn one(gpu: check.Gpu, stream: cuda.Stream, packer: *const cuda.modelopt.Packer, kernels: *const native.Kernels, rows: usize) !usize {
+    const n: usize = 192;
+    const k: usize = 576;
+    const ldx: usize = k + 16;
+    const npad = cuda.modelopt.padded(n);
+    var arena = std.heap.ArenaAllocator.init(gpu.gpa);
+    defer arena.deinit();
+    const a = arena.allocator();
+    var rig: rig_.Rig = .{ .gpu = gpu, .s = stream };
+    defer rig.deinit();
+    const input = try a.alloc(u8, rows * ldx * 2);
+    for (0..rows) |r| for (0..ldx) |j| {
+        const value: f32 = if (j >= k) std.math.nan(f32) else @as(f32, @floatFromInt(@as(i32, @intCast((r * 37 + j * 13) % 127)) - 63)) * 0.03125;
+        std.mem.writeInt(u16, input[(r * ldx + j) * 2 ..][0..2], core.quant.convert.bf16(value), .little);
+    };
+    const raw = try a.alloc(u8, n * k / 2);
+    const scales = try a.alloc(u8, n * k / 16);
+    for (raw, 0..) |*v, i| v.* = @truncate(i * 73 + i / 11);
+    for (scales, 0..) |*v, i| v.* = @intCast(0x20 + i % 40);
+    const zeros = try a.alloc(u8, npad * k / 2);
+    @memset(zeros, 0);
+    const x = try rig.input(input);
+    const wr = try rig.input(raw);
+    const sr = try rig.input(scales);
+    const w: native.Weight = .{
+        .mode = .fp4,
+        .codes = try rig.input(zeros),
+        .scales = try rig.input(zeros[0 .. npad * k / 16]),
+        .n = n,
+        .k = k,
+        .npad = @intCast(npad),
+        .act = 0.375,
+        .scale = 0.03125,
+    };
+    try packer.fp4Lane(stream, wr, sr, w.codes, w.scales, n, k);
+    try kernels.packWords(stream, wr, w);
+    const capacity_rows = @min(rows, native.max_rows);
+    const quant_bytes = try native.quantBytes(capacity_rows, k);
+    const partial_bytes = try native.partialBytes(capacity_rows, w);
+    const bounded: native.Scratch = .{
+        .quant = try rig.scratch(quant_bytes),
+        .quant_bytes = quant_bytes,
+        .partial = try rig.scratch(partial_bytes),
+        .partial_bytes = partial_bytes,
+    };
+    const full_quant = try native.quantBytes(rows, k);
+    const full_partial = try native.partialBytes(rows, w);
+    const oracle: native.Scratch = .{
+        .quant = try rig.scratch(full_quant),
+        .quant_bytes = full_quant,
+        .partial = try rig.scratch(full_partial),
+        .partial_bytes = full_partial,
+    };
+    try stream.synchronize();
+    const before = try a.dupe(u8, try rig.inputBytes());
+    // The reference deliberately bypasses matmul's new chunk loop and keeps one full-M quantized plane.
+    try kernels.quantize(stream, x, ldx, rows, k, w.act, oracle.quant, oracle.quant_bytes);
+    for ([_]native.Out{ .bf16, .f32 }) |kind| {
+        const bytes = rows * n * (if (kind == .f32) @as(usize, 4) else 2);
+        const want = try rig.output(bytes);
+        const got = try rig.output(bytes);
+        try kernels.matmulQuantized(stream, w, oracle.quant, rows, want, kind, oracle);
+        try kernels.matmul(stream, w, x, ldx, rows, got, kind, bounded);
+        const reference = try a.dupe(u8, try rig.bytes(want, bytes));
+        try check.sameBytes("nativeA4 bounded chunks versus full-M oracle", try rig.bytes(got, bytes), reference);
+        try check.expect(try rig.intact(), "nativeA4 bounded chunk guards changed", .{});
+        try check.sameBytes("nativeA4 chunk inputs unchanged", try rig.inputBytes(), before);
+        check.pass("nativeA4 chunks M{d} N{d} K{d} {s}: exact full-M bytes, scratch {d} rows, guards/inputs", .{
+            rows, n, k, @tagName(kind), capacity_rows,
+        });
+    }
+    return 2;
+}
diff --git a/zig/tests/cuda/qmmf_narrow32_tests.zig b/zig/tests/cuda/qmmf_narrow32_tests.zig
new file mode 100644
index 00000000..49b7ea7c
--- /dev/null
+++ b/zig/tests/cuda/qmmf_narrow32_tests.zig
@@ -0,0 +1,125 @@
+//! Exact narrow/wide column comparisons at the dense 27B's dimensions, then paired GPU-event timings.
+const std = @import("std");
+const cuda = @import("cuda");
+const core = @import("core");
+const check = @import("check.zig");
+const Rig = @import("contract_rig.zig").Rig;
+const q = cuda.qmmf;
+const row_edges = [_]usize{ 16, 17, 31, 32, 33 };
+const shapes = [_]struct { name: []const u8, n: usize, k: usize }{
+    .{ .name = "gate/up", .n = 17408, .k = 5120 },
+    .{ .name = "down", .n = 5120, .k = 17408 },
+    .{ .name = "qkv", .n = 10240, .k = 5120 },
+    .{ .name = "z", .n = 6144, .k = 5120 },
+};
+
+pub fn run(gpu: check.Gpu) !void {
+    const cap = try gpu.ctx.capability();
+    try check.expect(cap == 120, "narrow32 experimental qualification requires sm120; got sm{d}", .{cap});
+    var stream = try cuda.Stream.init(gpu.d, false);
+    defer stream.deinit();
+    var lane = try q.Lane.load(gpu.d, cap / 10);
+    defer lane.unload();
+    var comparisons: usize = 0;
+    for ([_]q.Mode{ .fp4, .fp8 }) |mode| for (shapes) |shape| {
+        comparisons += try one(gpu, stream, lane, mode, shape.name, shape.n, shape.k);
+    };
+    std.debug.print("SUMMARY qmmf narrow32: {d} exact comparisons; BF16 activations, unchanged SK, guards/inputs; PASS\n", .{comparisons});
+}
+
+fn digest(rig: *Rig) ![32]u8 {
+    var out: [32]u8 = undefined;
+    std.crypto.hash.sha2.Sha256.hash(try rig.inputBytes(), &out, .{});
+    return out;
+}
+
+fn weight(a: std.mem.Allocator, rig: *Rig, mode: q.Mode, n: usize, k: usize) !q.Weight {
+    const npad = cuda.modelopt.padded(n);
+    if (mode == .fp8) {
+        const raw = try a.alloc(u8, n * k);
+        for (raw, 0..) |*v, i| v.* = @as(u8, @intCast(0x20 + (i * 13 + i / 17) % 48)) | @as(u8, if (i % 3 == 0) 0x80 else 0);
+        const codes = try a.alloc(u8, npad * k);
+        cuda.fp8.packCodes(codes, raw, n, k);
+        return cuda.modelopt.fp8Weight(try rig.input(codes), 0.03125, n, k);
+    }
+    const raw = try a.alloc(u8, n * k / 2);
+    const scales = try a.alloc(u8, n * k / 16);
+    for (raw, 0..) |*v, i| v.* = @truncate(i * 73 + i / 11);
+    for (scales, 0..) |*v, i| v.* = @intCast(0x20 + i % 40);
+    const codes = try a.alloc(u32, npad * k / 8);
+    const tiles = try a.alloc(u8, npad * k / 16);
+    cuda.nvfp4.packWords(codes, raw, n, k);
+    cuda.nvfp4.packScales(tiles, scales, n, k);
+    return cuda.nvfp4.weight(try rig.input(std.mem.sliceAsBytes(codes)), try rig.input(tiles), 0.03125, n, k);
+}
+
+fn one(gpu: check.Gpu, stream: cuda.Stream, lane: q.Lane, mode: q.Mode, name: []const u8, n: usize, k: usize) !usize {
+    var arena = std.heap.ArenaAllocator.init(gpu.gpa);
+    defer arena.deinit();
+    const a = arena.allocator();
+    var rig: Rig = .{ .gpu = gpu, .s = stream };
+    defer rig.deinit();
+    const ldx = k + 16; // poison the stride gap so a contiguous-row assumption changes the result
+    const input = try a.alloc(u16, 33 * ldx);
+    for (0..33) |r| for (0..ldx) |j| {
+        const v: f32 = if (j >= k) std.math.nan(f32) else @as(f32, @floatFromInt(@as(i32, @intCast((r * 37 + j * 13) % 127)) - 63)) * 0.03125;
+        input[r * ldx + j] = core.quant.convert.bf16(v);
+    };
+    var xs: [row_edges.len]u64 = undefined;
+    for (row_edges, &xs) |m, *x| x.* = try rig.input(std.mem.sliceAsBytes(input[0 .. (m - 1) * ldx + k]));
+    const w = try q.pinned(try weight(a, &rig, mode, n, k), q.splitK(n, k));
+    const before = try digest(&rig);
+    var comparisons: usize = 0;
+    for ([_]bool{ false, true }) |clusters| for ([_]q.Out{ .bf16, .f32 }) |out| {
+        var base = lane;
+        base.clusters = clusters;
+        base.narrow32 = false;
+        var narrow = base;
+        narrow.narrow32 = true;
+        for (row_edges, xs) |m, x| {
+            try check.expect(narrow.usesNarrow32(m, w) == (m > 16 and m <= 32), "narrow32 row dispatch M{d}", .{m});
+            const bytes = m * n * @as(usize, if (out == .f32) 4 else 2);
+            const want = try rig.output(bytes);
+            const got = try rig.output(bytes);
+            const part_bytes = base.partBytes(m, w);
+            try check.expect(part_bytes == narrow.partBytes(m, w), "narrow32 changed scratch bounds", .{});
+            const part = if (part_bytes > 0) try rig.scratch(part_bytes) else 0;
+            const narrow_part = if (part_bytes > 0) try rig.scratch(part_bytes) else 0;
+            try base.matmulOut(stream, x, ldx, m, w, want, out, part);
+            try narrow.matmulOut(stream, x, ldx, m, w, got, out, narrow_part);
+            const reference = try a.dupe(u8, try rig.bytes(want, bytes));
+            const actual = try rig.bytes(got, bytes);
+            try check.sameBytes("qmmf narrow32 versus default", actual, reference);
+            for (0..m * n) |i| try check.expect(std.math.isFinite(core.contract.spec.read(if (out == .f32) .f32 else .bf16, actual, i)), "narrow32 unwritten/nonfinite output {d}", .{i});
+            comparisons += 1;
+            check.pass("narrow32 {s} {s} {s} M{d} N{d} K{d} SK{d} clusters={}: exact", .{ name, @tagName(mode), @tagName(out), m, n, k, q.slices(w), clusters });
+            if (m == 32) try timing(gpu, stream, base, narrow, x, ldx, w, want, got, out, part, narrow_part);
+        }
+    };
+    try check.expect(try rig.intact(), "narrow32 output/input/scratch guards changed", .{});
+    const after = try digest(&rig);
+    try check.expect(std.mem.eql(u8, &before, &after), "narrow32 mutated inputs or packed weights", .{});
+    return comparisons;
+}
+
+fn timing(gpu: check.Gpu, stream: cuda.Stream, base: q.Lane, narrow: q.Lane, x: u64, ldx: usize, w: q.Weight, y0: u64, y1: u64, out: q.Out, p0: u64, p1: u64) !void {
+    var start = try cuda.Event.init(gpu.d, true);
+    defer start.deinit();
+    var end = try cuda.Event.init(gpu.d, true);
+    defer end.deinit();
+    const per = 16;
+    var samples: [2][5]f64 = undefined;
+    // Two warm rounds, then five paired samples, with AB/BA ordering on the same stream and buffers.
+    for (0..7) |round| for (0..2) |turn| {
+        const which = (turn + round) % 2;
+        const lane = if (which == 0) base else narrow;
+        try start.record(stream);
+        for (0..per) |_| try lane.matmulOut(stream, x, ldx, 32, w, if (which == 0) y0 else y1, out, if (which == 0) p0 else p1);
+        try end.record(stream);
+        try end.synchronize();
+        if (round >= 2) samples[which][round - 2] = @as(f64, try cuda.Event.elapsedMs(start, end)) * 1000 / per;
+    };
+    const old = check.median(&samples[0]);
+    const new = check.median(&samples[1]);
+    std.debug.print("TIMING narrow32 {s} {s} M32 N{d} K{d} SK{d} clusters={}: baseline {d:.3} us, narrow {d:.3} us, ratio {d:.4}; paired 5x16 GPU events\n", .{ @tagName(w.mode), @tagName(out), w.n, w.k, q.slices(w), base.clusters, old, new, old / new });
+}
diff --git a/zig/tests/cuda/quant_activation_main.zig b/zig/tests/cuda/quant_activation_main.zig
new file mode 100644
index 00000000..85a40ea3
--- /dev/null
+++ b/zig/tests/cuda/quant_activation_main.zig
@@ -0,0 +1,122 @@
+//! Focused quantized-activation runner: native catalog images only, no family or full-runner suites.
+const std = @import("std");
+const cuda = @import("cuda");
+const core = @import("core");
+const check = @import("check.zig");
+const dense = @import("contract_nvfp4_dense.zig");
+const chunks = @import("nvfp4_dense_chunks.zig");
+const rows = @import("contract_rows.zig");
+const g = core.contract.gates;
+const controls align(16) = @embedFile("fatbin_contract_controls").*;
+
+pub fn main(init: std.process.Init) !u8 {
+    const args = try init.minimal.args.toSlice(init.arena.allocator());
+    if (args.len < 2) {
+        std.debug.print("usage: tf-quant-activation checkpoint | nativeA4-chunks | kernel-contract [nativeA4] | qmmf-narrow32 | qmmf-narrow32-contract\n", .{});
+        return 2;
+    }
+    var driver = try cuda.Driver.open();
+    defer driver.close();
+    var ctx = try cuda.Context.init(&driver, 0);
+    defer ctx.deinit();
+    const gpu: check.Gpu = .{ .d = &driver, .ctx = &ctx, .gpa = init.gpa, .io = init.io };
+    run(gpu, args[1], args[2..]) catch |err| {
+        std.debug.print("FAIL {s}: {t}\n", .{ args[1], err });
+        return 1;
+    };
+    return 0;
+}
+
+fn run(gpu: check.Gpu, command: []const u8, args: []const [:0]const u8) !void {
+    if (std.mem.eql(u8, command, "qmmf-narrow32") and args.len == 0) return @import("qmmf_narrow32_tests.zig").run(gpu);
+    if (std.mem.eql(u8, command, "qmmf-narrow32-contract") and args.len == 0) return @import("contract_qmmf_narrow32.zig").run(gpu);
+    if (std.mem.eql(u8, command, "checkpoint") and args.len == 0) return @import("ck_tests.zig").run(gpu);
+    if (std.mem.eql(u8, command, "nativeA4-chunks") and args.len == 0) return chunkChecks(gpu);
+    if (!std.mem.eql(u8, command, "kernel-contract") or args.len > 1 or
+        (args.len == 1 and !std.mem.eql(u8, args[0], "nativeA4"))) return error.BadCommand;
+    try contract(gpu);
+}
+
+fn contract(gpu: check.Gpu) !void {
+    const cap = try gpu.ctx.capability();
+    try check.expect(cap == 120, "nativeA4 focused contract requires sm120; got sm{d}", .{cap});
+    var stream = try cuda.Stream.init(gpu.d, false);
+    defer stream.deinit();
+    var packer = try cuda.modelopt.Packer.load(gpu.d);
+    defer packer.unload();
+    var registered: std.ArrayList(g.Kernel) = .empty;
+    defer registered.deinit(gpu.gpa);
+    const native_group = (try dense.Group.create(gpu.gpa, gpu, stream, &.{"nativeA4"}, &packer, &registered)) orelse
+        return error.NativeA4RegistrationMissing;
+    defer native_group.destroy();
+    try check.expect(registered.items.len == 2, "nativeA4 group must register both output forms", .{});
+    var norms = try cuda.norms.Norms.load(gpu.d);
+    defer norms.unload();
+    var ctl = try cuda.Module.load(gpu.d, &controls);
+    defer ctl.unload();
+    const kinds = [_]rows.Which{ .fmax_max, .atomic_sum, .scribble_sum, .tail_sum, .half_dot };
+    var planted: [kinds.len]rows.Row = undefined;
+    var count: usize = 0;
+    defer for (planted[0..count]) |*item| item.deinit();
+    for (kinds, &planted) |kind, *item| {
+        item.* = try rows.Row.init(gpu, stream, &norms, ctl, kind);
+        count += 1;
+        try registered.append(gpu.gpa, item.kernel());
+    }
+    var tally: g.Tally = .{};
+    try g.runAll(gpu.gpa, registered.items, 0x6b63, &tally);
+    const chunk_comparisons = try chunks.run(gpu, stream, &packer, &native_group.kernels);
+    const native_limits = try @import("contract_nvfp4_dense_limits.zig").live(gpu, &.{"nativeA4"});
+    const ctl_limits = try limitControls(gpu, ctl);
+    const problems = native_limits + ctl_limits.problems;
+    std.debug.print("SUMMARY nativeA4 sm120: {d} kernels, {d} pass gates1-4, {d} fail; {d} controls, {d} red, {d} missed; {d} limit problems; {d} exact chunk comparisons\n", .{
+        tally.kernels,                     tally.passed, tally.failed,      tally.controls + 2, tally.caught + ctl_limits.red,
+        tally.missed + 2 - ctl_limits.red, problems,     chunk_comparisons,
+    });
+    try check.expect(tally.problems() + problems == 0, "nativeA4 focused contract failed", .{});
+}
+
+fn chunkChecks(gpu: check.Gpu) !void {
+    const cap = try gpu.ctx.capability();
+    try check.expect(cap == 120, "nativeA4 chunk checks require sm120; got sm{d}", .{cap});
+    var stream = try cuda.Stream.init(gpu.d, false);
+    defer stream.deinit();
+    var packer = try cuda.modelopt.Packer.load(gpu.d);
+    defer packer.unload();
+    var kernels = try cuda.nvfp4_dense.Kernels.load(gpu.d, cuda.kernels.nvfp4_dense, cap);
+    defer kernels.unload();
+    const comparisons = try chunks.run(gpu, stream, &packer, &kernels);
+    std.debug.print("SUMMARY nativeA4 chunks: {d} exact comparisons, bounded 2048-row scratch; PASS\n", .{comparisons});
+}
+
+fn limitControls(gpu: check.Gpu, mod: cuda.Module) !struct { red: usize, problems: usize } {
+    const limits = core.contract.limits;
+    const target = limits.target(120).?;
+    var red: usize = 0;
+    var problems: usize = 0;
+    const threads: u32 = @intCast(try gpu.ctx.attribute(.max_threads_per_block));
+    const shared: u32 = @intCast(try gpu.ctx.attribute(.max_shared_memory_per_block_optin));
+    if (threads != target.threads or shared != target.smem_optin) problems += 1;
+    std.debug.print("{s} limits physical sm120: threads {d}/{d}, shared {d}/{d}\n", .{
+        if (problems == 0) "PASS" else "FAIL", threads, target.threads, shared, target.smem_optin,
+    });
+    for (core.contract.registry.cuda_controls) |record| {
+        const symbol = try gpu.gpa.dupeSentinel(u8, record.launch.symbol, 0);
+        defer gpu.gpa.free(symbol);
+        const f = try mod.function(symbol);
+        const usage: limits.Usage = .{
+            .regs = @intCast(try f.attribute(.num_regs)),
+            .static = @intCast(try f.attribute(.shared_size_bytes)),
+            .bound = @intCast(try f.attribute(.max_threads_per_block)),
+            .local = @intCast(try f.attribute(.local_size_bytes)),
+        };
+        var explanation: std.ArrayList(u8) = .empty;
+        defer explanation.deinit(gpu.gpa);
+        const failures = try limits.cuda(record.launch, usage, target, &explanation, gpu.gpa);
+        if (failures == 0) problems += 1 else red += 1;
+        std.debug.print("{s} limits {s}: {s}\n", .{
+            if (failures != 0) "CONTROL RED" else "CONTROL MISSED", record.launch.name, explanation.items,
+        });
+    }
+    return .{ .red = red, .problems = problems };
+}
