+//! A family's admission hint may account for a reusable text prefix before reserving its pages.
+const std = @import("std");
+const api = @import("engine_api.zig");
+
+pub const Admit = struct {
+    ctx: *anyopaque,
+    fits: *const fn (ctx: *anyopaque, prompt: u32, max_tokens: u32) bool,
+    fits_prompt: ?*const fn (ctx: *anyopaque, prompt: []const u32, max_tokens: u32) bool = null,
+
+    pub fn accepts(a: Admit, request: *const api.Request) bool {
+        if (request.images.len == 0 and request.chunks.len == 0) if (a.fits_prompt) |f|
+            return f(a.ctx, request.prompt, request.max_tokens);
+        return a.fits(a.ctx, @intCast(request.prompt.len), request.max_tokens);
+    }
+};
+
+test "prefix admission receives token identities and skips image or explicit chunk requests" {
+    const Probe = struct {
+        calls: usize = 0,
+        fn fits(_: *anyopaque, _: u32, _: u32) bool {
+            return false;
+        }
+        fn prefix(ctx: *anyopaque, ids: []const u32, max_tokens: u32) bool {
+            const p: *@This() = @ptrCast(@alignCast(ctx));
+            p.calls += 1;
+            return std.mem.eql(u32, ids, &.{ 7, 9 }) and max_tokens == 4;
+        }
+    };
+    var probe: Probe = .{};
+    const a: Admit = .{ .ctx = &probe, .fits = Probe.fits, .fits_prompt = Probe.prefix };
+    var request: api.Request = .{ .prompt = &.{ 7, 9 }, .max_tokens = 4 };
+    try std.testing.expect(a.accepts(&request));
+    request.prompt = &.{ 7, 8 };
+    try std.testing.expect(!a.accepts(&request));
+    request.prompt = &.{ 7, 9 };
+    request.chunks = &.{2};
+    try std.testing.expect(!a.accepts(&request));
+    request.chunks = &.{};
+    var image: api.Image = undefined;
+    request.images = @as(*[1]api.Image, @ptrCast(&image));
+    try std.testing.expect(!a.accepts(&request));
+    try std.testing.expectEqual(@as(usize, 2), probe.calls);
+}
