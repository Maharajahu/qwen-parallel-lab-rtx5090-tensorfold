index 00000000..31c251c0
--- /dev/null
+++ b/zig/src/families/qwen3_5/cuda_taps.zig
@@ -0,0 +1,76 @@
+//! Target tap-ring geometry; compact storage is specific to DFlash2 and keeps a whole prompt launch distinct.
+const std = @import("std");
+
+pub const legacy_rows = 6144;
+pub const compact_rows = 4096;
+
+pub fn capacity(dflash2: bool, compact: bool) usize {
+    return if (dflash2 and compact) compact_rows else legacy_rows;
+}
+
+test "compact target taps are opt-in and never select MTP or DSpine storage" {
+    try std.testing.expectEqual(@as(usize, 6144), capacity(true, false));
+    try std.testing.expectEqual(@as(usize, 6144), capacity(false, true));
+    try std.testing.expectEqual(@as(usize, 4096), capacity(true, true));
+    try std.testing.expectEqual(@as(usize, 100 * 1024 * 1024), (legacy_rows - compact_rows) * 5 * 5120 * 2);
+}
+
+const Ring = struct {
+    rows: [legacy_rows]u64 = @splat(0),
+    cap: usize,
+
+    fn write(r: *Ring, start: usize, count: usize, lane: usize, epoch: usize) void {
+        for (start..start + count) |p| r.rows[p % r.cap] = (lane + 1) * 1000000 + epoch * 100000 + p;
+    }
+
+    fn same(a: *const Ring, b: *const Ring, start: usize, count: usize) !void {
+        for (start..start + count) |p| try std.testing.expectEqual(a.rows[p % a.cap], b.rows[p % b.cap]);
+    }
+};
+
+test "a maximum prefill launch writes unique slots at every ring alignment" {
+    for (0..compact_rows) |start| {
+        var slots: [compact_rows]bool = @splat(false);
+        for (start..start + 4096) |p| {
+            try std.testing.expect(!slots[p % compact_rows]);
+            slots[p % compact_rows] = true;
+        }
+    }
+}
+
+test "compact taps preserve prompt tails, verification paths and rejected-window rewrites per stream" {
+    var old: [4]Ring = @splat(.{ .cap = legacy_rows });
+    var compact: [4]Ring = @splat(.{ .cap = compact_rows });
+    for (0..4) |lane| {
+        // A resumed prefix has no taps: only rows actually forwarded after its boundary may be gathered.
+        const resumed: usize = switch (lane) {
+            1 => 8192,
+            3 => 53248,
+            else => 0,
+        };
+        var end = resumed;
+        for ([_]usize{ 4096, 4096, 2087, 1 }) |chunk| {
+            old[lane].write(end, chunk, lane, 0);
+            compact[lane].write(end, chunk, lane, 0);
+            end += chunk;
+            const full = @min(@as(usize, 2048), chunk);
+            try old[lane].same(&compact[lane], end - full, full);
+            // The final prompt row may be excluded by Drafted.take: preserve the same 2048 preceding rows too.
+            const count = @min(@as(usize, 2048), chunk -| 1);
+            try old[lane].same(&compact[lane], end - 1 - count, count);
+        }
+        // A verify can write 128 rows before only zero, one, a partial path or the entire window is accepted.
+        for ([_]usize{ 0, 1, 17, 128 }) |kept| {
+            old[lane].write(end, 128, lane, kept + 1);
+            compact[lane].write(end, 128, lane, kept + 1);
+            try old[lane].same(&compact[lane], end - 2048, 2048 + 128);
+            const path = [_]usize{ 0, 3, 17, 63, 127 };
+            for (path) |p| try old[lane].same(&compact[lane], end + p, 1);
+            end += kept;
+        }
+    }
+    // Reusing one released lane cannot affect any other stream's retained rows.
+    const saved = compact[1].rows;
+    compact[0].write(0, compact_rows, 0, 99);
+    try std.testing.expectEqualSlices(u64, &saved, &compact[1].rows);
+}
