+//! Explicit hints survive chat preparation without changing any rendered token and refuse invalid final boundaries.
+const std = @import("std");
+const json = @import("json");
+const chat = @import("chat.zig");
+const openai = @import("openai.zig");
+const Cx = @import("errors.zig").Cx;
+const Server = @import("server.zig").Server;
+const Never = struct {
+    pub fn check(_: @This()) bool {
+        return false;
+    }
+};
+
+test "explicit shared hints reach the native request and preserve rendered prompt IDs" {
+    const t = std.testing;
+    const fixture = @import("late_system_test.zig");
+    var text: fixture.DropLate = .{};
+    var backend: fixture.Capture = .{};
+    const srv = try Server.init(t.allocator, t.io, backend.engine(), text.text(), .{
+        .served_name = "m",
+        .model_ids = &.{"m"},
+        .enable_thinking = false,
+    }, null);
+    defer srv.deinit();
+    var arena = std.heap.ArenaAllocator.init(t.allocator);
+    defer arena.deinit();
+    var cx: Cx = .{ .a = arena.allocator() };
+    const plain = (try json.parse(cx.a, "{\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}],\"max_tokens\":1}")).ok;
+    const normal = try chat.prepare(srv, &cx, try openai.chatInput(srv, &cx, plain), Never{});
+    defer srv.release(normal.preparing, normal.request);
+    try t.expectEqualSlices(u32, &.{}, normal.request.shared_prefixes);
+    const hinted = (try json.parse(cx.a, "{\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}],\"max_tokens\":1,\"shared_prefixes\":[4,0,4,2]}")).ok;
+    const prepared = try chat.prepare(srv, &cx, try openai.chatInput(srv, &cx, hinted), Never{});
+    defer srv.release(prepared.preparing, prepared.request);
+    try t.expectEqualSlices(u32, normal.request.prompt, prepared.request.prompt);
+    try t.expectEqualSlices(u32, &.{ 0, 2, 4 }, prepared.request.shared_prefixes);
+    var invalid = try openai.chatInput(srv, &cx, plain);
+    invalid.shared_prefixes = &.{@intCast(normal.prompt_len)};
+    try t.expectError(error.Refused, chat.prepare(srv, &cx, invalid, Never{}));
+    try t.expectEqual(@as(u16, 400), cx.status());
+    try t.expect(std.mem.indexOf(u8, cx.message, "shared_prefixes") != null);
+}
diff --git a/zig/tests/cuda/ck_fp8_qwen_tests.zig b/zig/tests/cuda/ck_fp8_qwen_tests.zig
new file mode 100644
index 00000000..c3c7cd7b
--- /dev/null
+++ b/zig/tests/cuda/ck_fp8_qwen_tests.zig
@@ -0,0 +1,195 @@
+//! Qwen FP8 activation rows: nonunit quantization, Linear wiring, tile seams and guarded cold-prefill scratch.
+const std = @import("std");
+const cuda = @import("cuda");
+const core = @import("core");
+const check = @import("check.zig");
+const Rig = @import("quant_ref_tests.zig").RigT;
+const e4m3 = core.quant.fp8.e4m3;
+const guard_bytes = 128;
+const scales = [_]f32{ 0.1121651828289032, 0.0322265625 };
+
+const Guard = struct {
+    base: u64,
+    ptr: u64,
+    len: usize,
+
+    fn init(r: *Rig, len: usize) !Guard {
+        const host = try r.a.alloc(u8, len + 2 * guard_bytes);
+        @memset(host, 0xa5);
+        @memset(host[guard_bytes..][0..len], 0xff);
+        const base = try r.dev(host);
+        return .{ .base = base, .ptr = base + guard_bytes, .len = len };
+    }
+
+    fn intact(g: Guard, r: *Rig) !void {
+        const want: [guard_bytes]u8 = @splat(0xa5);
+        try check.sameBytes("FP8 leading guard", try r.back(g.base, guard_bytes), &want);
+        try check.sameBytes("FP8 trailing guard", try r.back(g.ptr + g.len, guard_bytes), &want);
+    }
+};
+
+fn free(r: *Rig) void {
+    for (r.bufs.items) |*b| b.free();
+    r.bufs.deinit(r.gpu.gpa);
+}
+
+/// BF16 rows with NaN stride padding, signs, zeros and finite spikes that must saturate after scaling.
+fn inputs(r: *Rig, m: usize, k: usize, ldx: usize) ![]u16 {
+    const x = try r.a.alloc(u16, m * ldx);
+    @memset(x, 0x7fc1);
+    for (0..m) |row| {
+        for (0..k) |i| {
+            const magnitude: u16 = @intCast(0x3c01 + (i * 37 + row * 19) % 0x0500);
+            x[row * ldx + i] = magnitude | if ((i + row) % 3 == 0) @as(u16, 0x8000) else 0;
+        }
+        x[row * ldx] = 0x4980;
+        x[row * ldx + 1] = 0xc980;
+        x[row * ldx + 2] = 0;
+        x[row * ldx + 3] = 0x8000;
+    }
+    return x;
+}
+
+/// Independent finite e4m3 encoder: exhaustive nearest value, ties to even, finite saturation and signed zero.
+fn nearest(x: f32) u8 {
+    const sign: u8 = if (@as(u32, @bitCast(x)) >> 31 != 0) 0x80 else 0;
+    const value: f64 = @abs(x);
+    var best: u8 = 0;
+    var distance = std.math.inf(f64);
+    for (0..127) |i| {
+        const code: u8 = @intCast(i);
+        const d = @abs(value - e4m3(code));
+        if (d < distance or (d == distance and code & 1 == 0)) {
+            best = code;
+            distance = d;
+        }
+    }
+    return sign | best;
+}
+
+/// Check quant8 itself; comparing only prompt/decode could let both share the same wrong scale or swizzle.
+fn quantReference(gpu: check.Gpu, s: cuda.Stream, ck: *const cuda.ck.Ck) !void {
+    var arena: std.heap.ArenaAllocator = .init(gpu.gpa);
+    defer arena.deinit();
+    var prng = std.Random.DefaultPrng.init(0x8f80);
+    var r: Rig = .{ .gpu = gpu, .a = arena.allocator(), .s = s, .rng = prng.random() };
+    defer free(&r);
+    const m = 3;
+    const k = 64;
+    const ldx = k + 16;
+    const host = try inputs(&r, m, k, ldx);
+    const src = try r.dev(std.mem.sliceAsBytes(host));
+    const out = try Guard.init(&r, m * k);
+    const want = try r.a.alloc(u8, m * k);
+    for (scales) |scale| {
+        const inv: f32 = 1.0 / scale;
+        var rounded: usize = 0;
+        var saturated: usize = 0;
+        for (0..m) |row| for (0..k) |i| {
+            const value: f32 = @bitCast(@as(u32, host[row * ldx + i]) << 16);
+            const scaled: f32 = value * inv;
+            const code = nearest(scaled);
+            rounded += @intFromBool(@abs(scaled) <= 448 and e4m3(code) != @as(f64, scaled));
+            saturated += @intFromBool(@abs(scaled) > 448);
+            const within = i % 16;
+            const fragment = 4 * ((within % 8) / 2) + within % 2 + 2 * (within / 8);
+            want[row * k + i / 16 * 16 + fragment] = code;
+        };
+        try check.expect(rounded > 0 and saturated >= 2 * m, "FP8 quant fixture rounds and saturates", .{});
+        try ck.quant8(s, src, ldx, m, k, scale, out.ptr);
+        try check.sameBytes(
+            "FP8 nonunit quant8 vs independent nearest-code reference",
+            try r.back(out.ptr, m * k),
+            want,
+        );
+        try out.intact(&r);
+    }
+    try check.sameBytes(
+        "FP8 quant8 leaves strided BF16 input unchanged",
+        try r.back(src, host.len * 2),
+        std.mem.sliceAsBytes(host),
+    );
+    check.pass("checkpoint FP8 quant8: two nonunit scales, rounding, saturation, stride, signed zeros and guards", .{});
+}
+
+/// One bounded shape; resources are released between cases, including the 4096-row scratch case.
+fn rows(
+    gpu: check.Gpu,
+    s: cuda.Stream,
+    ck: *const cuda.ck.Ck,
+    packer: *const cuda.modelopt.Packer,
+    n: usize,
+    k: usize,
+    counts: []const usize,
+) !void {
+    var arena: std.heap.ArenaAllocator = .init(gpu.gpa);
+    defer arena.deinit();
+    var prng = std.Random.DefaultPrng.init(0x8f81 + n + k);
+    var r: Rig = .{ .gpu = gpu, .a = arena.allocator(), .s = s, .rng = prng.random() };
+    defer free(&r);
+    const mmax = counts[counts.len - 1];
+    const ldx = k + 16;
+    const host = try inputs(&r, mmax, k, ldx);
+    const src = try r.dev(std.mem.sliceAsBytes(host));
+    const codes = try r.a.alloc(u8, n * k);
+    for (codes) |*v| {
+        const magnitude = 0x10 + r.rng.uintLessThan(u8, 0x39);
+        v.* = magnitude | if (r.rng.boolean()) @as(u8, 0x80) else 0;
+    }
+    const raw = try r.dev(codes);
+    const weight = try Guard.init(&r, cuda.modelopt.padded(n) * k);
+    try packer.fp8Lane(s, raw, weight.ptr, n, k);
+    const x8 = try Guard.init(&r, mmax * k);
+    const batch = try Guard.init(&r, mmax * n * 2);
+    const prompt = try Guard.init(&r, mmax * n * 2);
+    const solo = try Guard.init(&r, n * 2);
+    const sk = cuda.qmmf.splitK(n, k);
+    const part = if (!ck.clusters and sk > 1) try r.zeros(sk * mmax * n * 4) else 0;
+    const lin: cuda.qlinear.Linear = .{ .ck = ck, .ck_rows = x8.ptr, .ck_part = part };
+    var w = cuda.modelopt.fp8Weight(weight.ptr, 0.00390625, n, k);
+    for (scales) |scale| {
+        w.act = scale;
+        const view: cuda.qlinear.Weight = .{ .fp8 = w };
+        for (counts) |m| {
+            const in: cuda.qlinear.Rows = .{ .x = src, .ldx = ldx };
+            try lin.decode(s, view, in, batch.ptr, m);
+            try lin.prompt(s, view, in, prompt.ptr, m);
+            const got = try r.back(batch.ptr, m * n * 2);
+            try check.sameBytes("Qwen FP8 Linear prompt == decode", try r.back(prompt.ptr, got.len), got);
+            for (0..m * n) |i| {
+                const bits = std.mem.readInt(u16, got[i * 2 ..][0..2], .little);
+                try check.expect(bits & 0x7f80 != 0x7f80, "Qwen FP8 wrote finite output at {d}", .{i});
+            }
+            const selected = [_]usize{ 0, m / 2, m - 1 };
+            for (selected, 0..) |row, at| {
+                if (std.mem.indexOfScalar(usize, selected[0..at], row) != null) continue;
+                const one: cuda.qlinear.Rows = .{ .x = src + row * ldx * 2, .ldx = ldx };
+                try lin.decode(s, view, one, solo.ptr, 1);
+                try check.sameBytes(
+                    "Qwen FP8 selected solo row == batch",
+                    try r.back(solo.ptr, n * 2),
+                    got[row * n * 2 ..][0 .. n * 2],
+                );
+            }
+            try x8.intact(&r);
+            try batch.intact(&r);
+            try prompt.intact(&r);
+            try solo.intact(&r);
+            check.pass(
+                "Qwen FP8 Linear: {d} rows x [{d}, {d}], act={d}, prompt/decode/solo equal",
+                .{ m, n, k, scale },
+            );
+        }
+    }
+    try weight.intact(&r);
+}
+
+pub fn run(gpu: check.Gpu, s: cuda.Stream, ck: *const cuda.ck.Ck) !void {
+    var packer = try cuda.modelopt.Packer.load(gpu.d);
+    defer packer.unload();
+    try quantReference(gpu, s, ck);
+    const counts = [_]usize{ 1, 16, 31, 32, 33, 64, 128, 129 };
+    try rows(gpu, s, ck, &packer, 10240, 5120, &counts);
+    try rows(gpu, s, ck, &packer, 5120, 6144, &counts);
+    try rows(gpu, s, ck, &packer, 192, 6144, &.{4096});
+}
