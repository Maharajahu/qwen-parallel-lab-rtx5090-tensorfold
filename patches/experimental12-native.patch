diff --git a/zig/tests/cuda/contract_nvfp4_dense.zig b/zig/tests/cuda/contract_nvfp4_dense.zig
new file mode 100644
index 00000000..21878ae3
--- /dev/null
+++ b/zig/tests/cuda/contract_nvfp4_dense.zig
@@ -0,0 +1,258 @@
+//! Native-A4 sm120 contract starts at encoded inputs; nvfp4_dense_test.cu qualifies quantization independently.
+const std = @import("std");
+const cuda = @import("cuda");
+const core = @import("core");
+const rig_ = @import("contract_rig.zig");
+const c = core.contract.spec;
+const g = core.contract.gates;
+const native = cuda.nvfp4_dense;
+const check = @import("check.zig");
+const fp4 = blk: {
+    var values: [16]f64 = undefined;
+    for (&values, 0..) |*v, i| v.* = core.quant.nvfp4.e2m1(@intCast(i));
+    break :blk values;
+};
+const fp8 = blk: {
+    @setEvalBranchQuota(1000000);
+    var values: [256]f64 = undefined;
+    for (&values, 0..) |*v, i| v.* = core.quant.fp8.e4m3(@intCast(i));
+    break :blk values;
+};
+
+fn depth(s: c.Shape) usize {
+    // Upper bound for every shape-only split: up to K/64 MMA links, the products within one, and eight partials.
+    return s.k / 64 + 64 + 8;
+}
+
+pub fn spec(kind: native.Out) c.Spec {
+    return .{
+        .name = if (kind == .f32) "cuda nativeA4 sm120 dense f32" else "cuda nativeA4 sm120 dense bf16",
+        .accum = .f32,
+        .depth = depth,
+        .ops = 1,
+        .out = if (kind == .f32) .f32 else .bf16,
+        .tiles = .{ .{ .size = 32 }, .{ .size = 128, .step = 64, .min = 64 }, .{ .size = 64, .step = 64, .min = 64 } },
+        // The first max-K shape keeps gate 4 small. Real Qwen widths are still checked against FP64 at one row.
+        .served = &.{ .{ .rows = 1, .n = 64, .k = 512 }, .{ .rows = 1, .n = 64, .k = 17408 }, .{ .rows = 1, .n = 17408, .k = 5120 }, .{ .rows = 1, .n = 5120, .k = 17408 }, .{ .rows = 33, .n = 192, .k = 576 } },
+    };
+}
+
+/// Owns the optional native image and its adapters for the main runner, with no load on other capabilities.
+pub const Group = struct {
+    allocator: std.mem.Allocator,
+    kernels: native.Kernels,
+    cases: [2]Dense,
+    count: usize = 0,
+
+    pub fn create(a: std.mem.Allocator, gpu: check.Gpu, stream: cuda.Stream, only: []const []const u8, packer: *const cuda.modelopt.Packer, registered: *std.ArrayList(g.Kernel)) !?*Group {
+        var selected = only.len == 0;
+        for (only) |text| for ([_]native.Out{ .f32, .bf16 }) |kind| {
+            if (std.mem.indexOf(u8, spec(kind).name, text) != null) selected = true;
+        };
+        if (!selected) return null;
+        const cap = try gpu.ctx.capability();
+        if (cap != 120) {
+            std.debug.print("N/A  nativeA4 dense: its image is qualified only for sm120, this GPU is sm{d}\n", .{cap});
+            return null;
+        }
+        const self = try a.create(Group);
+        errdefer a.destroy(self);
+        self.* = .{ .allocator = a, .kernels = try native.Kernels.load(gpu.d, cuda.kernels.nvfp4_dense, cap), .cases = undefined };
+        errdefer {
+            for (self.cases[0..self.count]) |*item| item.deinit();
+            self.kernels.unload();
+        }
+        for ([_]native.Out{ .f32, .bf16 }, &self.cases) |kind, *item| {
+            item.* = .{ .rig = .{ .gpu = gpu, .s = stream }, .kernels = &self.kernels, .packer = packer, .kind = kind };
+            self.count += 1;
+            try registered.append(a, item.kernel());
+        }
+        return self;
+    }
+
+    pub fn destroy(self: *Group) void {
+        for (self.cases[0..self.count]) |*item| item.deinit();
+        self.kernels.unload();
+        self.allocator.destroy(self);
+    }
+};
+
+pub const Dense = struct {
+    rig: rig_.Rig,
+    kernels: *const native.Kernels,
+    packer: *const cuda.modelopt.Packer,
+    kind: native.Out,
+    shape: c.Shape = undefined,
+    x: []u8 = &.{},
+    w: []u8 = &.{},
+    ws: []u8 = &.{},
+    weight: native.Weight = undefined,
+    xd: u64 = 0,
+    solo_x: u64 = 0,
+    solo_stride: usize = 0,
+    solo_out: u64 = 0,
+    out: u64 = 0,
+    scratch: native.Scratch = undefined,
+
+    pub fn deinit(self: *Dense) void {
+        self.free();
+        self.rig.deinit();
+    }
+
+    fn free(self: *Dense) void {
+        const a = self.rig.gpu.gpa;
+        a.free(self.x);
+        a.free(self.w);
+        a.free(self.ws);
+        self.x = &.{};
+        self.w = &.{};
+        self.ws = &.{};
+    }
+
+    const vt = g.hooks(Dense);
+    pub fn kernel(self: *Dense) g.Kernel {
+        return .{ .spec = spec(self.kind), .ctx = self, .vt = &vt };
+    }
+
+    fn put(codes: []u8, i: usize, nib: u8) void {
+        const b = &codes[i / 2];
+        b.* = if (i % 2 == 0) (b.* & 0xf0) | nib else (b.* & 0x0f) | nib << 4;
+    }
+
+    pub fn prepare(self: *Dense, shape: c.Shape, fill: g.Fill, seed: u64) !bool {
+        if (shape.rows == 0 or shape.n == 0 or shape.k == 0 or shape.n % 64 != 0 or shape.k % 64 != 0) return false;
+        self.free();
+        self.rig.reset();
+        self.shape = shape;
+        const a = self.rig.gpu.gpa;
+        const k = shape.k;
+        self.x = try a.alloc(u8, try native.quantBytes(shape.rows, k));
+        self.w = try a.alloc(u8, shape.n * k / 2);
+        self.ws = try a.alloc(u8, shape.n * k / 16);
+        var prng = std.Random.DefaultPrng.init(seed);
+        const rng = prng.random();
+        const xs = self.x[shape.rows * k / 2 ..];
+        rng.bytes(self.x[0 .. shape.rows * k / 2]);
+        rng.bytes(self.w);
+        for (xs) |*v| v.* = 0x20 + rng.uintLessThan(u8, 0x28);
+        for (self.ws) |*v| v.* = 0x20 + rng.uintLessThan(u8, 0x28);
+        const npad = cuda.modelopt.padded(shape.n);
+        self.weight = .{ .mode = .fp4, .codes = 0, .scales = 0, .n = @intCast(shape.n), .k = @intCast(k), .npad = @intCast(npad), .act = 0.5, .scale = 0.03125 };
+        switch (fill) {
+            .random => {},
+            // e2m1/e4m3 have no infinity encoding. NaN scales poison an activation row and one weight row.
+            .nonfinite => {
+                const poison_row = @min(@as(usize, 1), shape.rows - 1);
+                const poison_col = @min(@as(usize, 5), shape.n - 1);
+                xs[poison_row * (k / 16)] = 0x7f;
+                self.ws[poison_col * (k / 16) + k / 32] = 0xff;
+            },
+            .stress => self.stress(rng),
+        }
+        self.xd = try self.rig.input(self.x);
+        const wr = try self.rig.input(self.w);
+        const sr = try self.rig.input(self.ws);
+        // Packing destinations are guarded immutable inputs for the matmul; prepare completes before gate 2 snapshots.
+        const zeros = try a.alloc(u8, npad * k / 2);
+        defer a.free(zeros);
+        @memset(zeros, 0);
+        self.weight.codes = try self.rig.input(zeros);
+        self.weight.scales = try self.rig.input(zeros[0 .. npad * k / 16]);
+        try self.packer.fp4Lane(self.rig.s, wr, sr, self.weight.codes, self.weight.scales, shape.n, k);
+        try self.kernels.packWords(self.rig.s, wr, self.weight);
+        // cp.async reads activation codes in 16-byte units; every independent solo base must retain that alignment.
+        const solo_stride = std.mem.alignForward(usize, try native.quantBytes(1, k), 16);
+        self.solo_stride = solo_stride;
+        const solo = try a.alloc(u8, try std.math.mul(usize, shape.rows, solo_stride));
+        defer a.free(solo);
+        @memset(solo, 0);
+        for (0..shape.rows) |r| {
+            @memcpy(solo[r * solo_stride ..][0 .. k / 2], self.x[r * k / 2 ..][0 .. k / 2]);
+            @memcpy(solo[r * solo_stride + k / 2 ..][0 .. k / 16], xs[r * k / 16 ..][0 .. k / 16]);
+        }
+        self.solo_x = try self.rig.input(solo);
+        if (self.solo_x % 16 != 0) return error.NativeA4MisalignedFixture;
+        const outbytes = c.size(spec(self.kind).out);
+        self.out = try self.rig.output(shape.rows * shape.n * outbytes);
+        self.solo_out = try self.rig.scratch(shape.n * outbytes);
+        const partial_bytes = try native.partialBytes(shape.rows, self.weight);
+        self.scratch = .{ .quant = 0, .quant_bytes = 0, .partial = try self.rig.scratch(partial_bytes), .partial_bytes = partial_bytes };
+        try self.rig.s.synchronize();
+        return true;
+    }
+
+    fn stress(self: *Dense, rng: std.Random) void {
+        const k = self.shape.k;
+        const xs = self.x[self.shape.rows * k / 2 ..];
+        @memset(xs, 0x58); // 16
+        @memset(self.ws, 0x48); // 4: largest term 4*4*16*4 = 1024; partials stay below 2^24 at K17408.
+        self.weight.act = 1;
+        self.weight.scale = 1;
+        for (0..self.shape.rows) |r| for (0..k / 2) |i| {
+            const v = 5 + rng.uintLessThan(u8, 2);
+            put(self.x[r * k / 2 ..], i, v);
+            put(self.x[r * k / 2 ..], k / 2 + i, if (i < 8) v - 1 else v);
+        };
+        for (0..self.shape.n) |j| for (0..k / 2) |i| {
+            const v = 5 + rng.uintLessThan(u8, 2);
+            put(self.w[j * k / 2 ..], i, v);
+            put(self.w[j * k / 2 ..], k / 2 + i, v | 8);
+        };
+    }
+
+    pub fn run(self: *Dense) !void {
+        try self.kernels.matmulQuantized(self.rig.s, self.weight, self.xd, self.shape.rows, self.out, self.kind, self.scratch);
+        const rowbytes = self.shape.n * c.size(spec(self.kind).out);
+        const rows = try self.rig.gpu.gpa.dupe(u8, try self.rig.bytes(self.out, self.shape.rows * rowbytes));
+        defer self.rig.gpu.gpa.free(rows);
+        // Same row, weight and SK, changing only M; each solo [codes][scales] plane needs its own scales.
+        for (0..self.shape.rows) |r| {
+            try self.kernels.matmulQuantized(self.rig.s, self.weight, self.solo_x + r * self.solo_stride, 1, self.solo_out, self.kind, self.scratch);
+            if (!std.mem.eql(u8, rows[r * rowbytes ..][0..rowbytes], try self.rig.bytes(self.solo_out, rowbytes))) return error.NativeA4RowCountChangedBits;
+        }
+    }
+
+    pub fn count(self: *Dense) usize {
+        return self.shape.rows * self.shape.n;
+    }
+
+    fn value(codes: []const u8, scales: []const u8, row: usize, k: usize, i: usize) f64 {
+        const b = codes[row * k / 2 + i / 2];
+        const nib = if (i % 2 == 0) b & 0xf else b >> 4;
+        return fp4[nib] * fp8[scales[row * k / 16 + i / 16]];
+    }
+
+    fn terms(self: *Dense, row: usize, col: usize, t: []f64) void {
+        const k = self.shape.k;
+        const xs = self.x[self.shape.rows * k / 2 ..];
+        for (t, 0..) |*v, i| v.* = value(self.x, xs, row, k, i) * value(self.w, self.ws, col, k, i);
+    }
+
+    pub fn reference(self: *Dense, want: []f64, mag: []f64) !void {
+        const t = try self.rig.gpu.gpa.alloc(f64, self.shape.k);
+        defer self.rig.gpu.gpa.free(t);
+        // The wrapper performs alpha's multiplication in FP32 once before passing it to the ordered merge.
+        const alpha: f64 = self.weight.act * self.weight.scale;
+        for (0..self.shape.rows) |r| for (0..self.shape.n) |j| {
+            self.terms(r, j, t);
+            var sum: f64 = 0;
+            var abs: f64 = 0;
+            for (t) |v| {
+                sum += v;
+                abs += @abs(v);
+            }
+            want[r * self.shape.n + j] = sum * alpha;
+            mag[r * self.shape.n + j] = abs * @abs(alpha);
+        };
+    }
+
+    pub fn simulate(self: *Dense, acc: c.Accum, order: g.Order, out: []f64) !void {
+        const t = try self.rig.gpu.gpa.alloc(f64, self.shape.k);
+        defer self.rig.gpu.gpa.free(t);
+        const alpha: f64 = self.weight.act * self.weight.scale;
+        for (0..self.shape.rows) |r| for (0..self.shape.n) |j| {
+            self.terms(r, j, t);
+            out[r * self.shape.n + j] = core.contract.rows.sumIn(acc, order, t) * alpha;
+        };
+    }
+};
diff --git a/zig/tests/cuda/contract_nvfp4_dense_limits.zig b/zig/tests/cuda/contract_nvfp4_dense_limits.zig
new file mode 100644
index 00000000..fe18a9b4
--- /dev/null
+++ b/zig/tests/cuda/contract_nvfp4_dense_limits.zig
@@ -0,0 +1,49 @@
+//! Gate 5 for the experimental sm120-only image. Global CUDA controls still run in contract_limits.live.
+const std = @import("std");
+const cuda = @import("cuda");
+const core = @import("core");
+const check = @import("check.zig");
+const records = core.contract.nvfp4_dense_records;
+
+pub fn live(gpu: check.Gpu, only: []const []const u8) !usize {
+    const sm: u32 = @intCast(try gpu.ctx.capability());
+    if (sm != records.sm) return 0;
+    var selected = only.len == 0;
+    for (only) |text| {
+        for (records.records) |r| if (std.mem.indexOf(u8, r.launch.name, text) != null) {
+            selected = true;
+        };
+        for ([_]cuda.nvfp4_dense.Out{ .f32, .bf16 }) |kind|
+            if (std.mem.indexOf(u8, @import("contract_nvfp4_dense.zig").spec(kind).name, text) != null) {
+                selected = true;
+            };
+    }
+    if (!selected) return 0;
+    var mod = try cuda.Module.load(gpu.d, cuda.kernels.nvfp4_dense);
+    defer mod.unload();
+    const target = core.contract.limits.target(sm).?;
+    var problems: usize = 0;
+    for (records.records) |r| {
+        const symbol = try gpu.gpa.dupeSentinel(u8, r.launch.symbol, 0);
+        defer gpu.gpa.free(symbol);
+        const f = try mod.function(symbol);
+        const binary: u32 = @intCast(try f.attribute(.binary_version));
+        const got: core.contract.limits.Usage = .{
+            .regs = @intCast(try f.attribute(.num_regs)),
+            .static = @intCast(try f.attribute(.shared_size_bytes)),
+            .bound = @intCast(try f.attribute(.max_threads_per_block)),
+            .local = @intCast(try f.attribute(.local_size_bytes)),
+        };
+        var out: std.ArrayList(u8) = .empty;
+        defer out.deinit(gpu.gpa);
+        const bad = try core.contract.limits.cuda(r.launch, got, target, &out, gpu.gpa);
+        const same = binary == records.sm and std.meta.eql(got, r.usage);
+        if (bad != 0 or !same) problems += 1;
+        std.debug.print("{s} limits live sm120 {s}: regs {d}, static {d}, dynamic {d}, bound {d}, local {d}; receipt {s}\n", .{
+            if (bad == 0 and same) "PASS" else "FAIL", r.launch.name, got.regs, got.static, r.launch.dynamic, got.bound, got.local,
+            if (same) "matches" else "differs",
+        });
+        if (bad != 0) std.debug.print("{s}", .{out.items});
+    }
+    return problems;
+}
diff --git a/zig/tests/cuda/contract_qmmf_narrow32.zig b/zig/tests/cuda/contract_qmmf_narrow32.zig
new file mode 100644
index 00000000..d8c657d5
--- /dev/null
+++ b/zig/tests/cuda/contract_qmmf_narrow32.zig
@@ -0,0 +1,136 @@
+//! The existing packed projection FP64/stress fixture, restricted to the experimental 32x32 instances.
+const std = @import("std");
+const cuda = @import("cuda");
+const core = @import("core");
+const check = @import("check.zig");
+const Product = @import("contract_projection_f32.zig").Product;
+const Rig = @import("contract_rig.zig").Rig;
+const c = core.contract.spec;
+const g = core.contract.gates;
+const q = cuda.qmmf;
+const served = [_]c.Shape{
+    .{ .rows = 17, .n = 70, .k = 1024 },
+    .{ .rows = 31, .n = 96, .k = 5120 },
+    .{ .rows = 32, .n = 64, .k = 17408 },
+    .{ .rows = 32, .n = 128, .k = 6144 },
+};
+
+const Entry = struct {
+    product: Product,
+    rig: *Rig = undefined,
+    name: []const u8,
+    control: bool = false,
+
+    fn kernel(self: *Entry) g.Kernel {
+        self.rig = &self.product.rig;
+        var k = self.product.kernel();
+        k.spec.name = self.name;
+        k.spec.served = &served;
+        k.spec.tiles[0] = .{ .size = 32, .min = 17 };
+        k.spec.tiles[1] = .{ .size = 32 };
+        k.ctx = self;
+        k.vt = &vt;
+        k.control = if (self.control) .shapes else null;
+        return k;
+    }
+
+    const vt = g.hooks(Entry);
+
+    pub fn prepare(self: *Entry, given: c.Shape, fill: g.Fill, seed: u64) !bool {
+        var shape = given;
+        // The generic harness shrinks nonfinite to 5..8 rows and stress to four. Exercise the new tile instead.
+        if (fill == .nonfinite or fill == .stress) shape.rows = 17;
+        if (shape.rows <= 16 or shape.rows > 32) return false;
+        return self.product.prepare(shape, fill, seed);
+    }
+
+    pub fn run(self: *Entry) !void {
+        const keep = self.product.weight.scale;
+        defer self.product.weight.scale = keep;
+        if (self.control) self.product.weight.scale *= 1.5;
+        try self.product.run();
+    }
+
+    pub fn count(self: *Entry) usize {
+        return self.product.count();
+    }
+
+    pub fn reference(self: *Entry, want: []f64, mag: []f64) !void {
+        try self.product.reference(want, mag);
+    }
+
+    pub fn simulate(self: *Entry, acc: c.Accum, order: g.Order, out: []f64) !void {
+        try self.product.simulate(acc, order, out);
+    }
+};
+
+pub fn run(gpu: check.Gpu) !void {
+    const cap = try gpu.ctx.capability();
+    try check.expect(cap == 120, "narrow32 experimental contract requires sm120; got sm{d}", .{cap});
+    var s = try cuda.Stream.init(gpu.d, false);
+    defer s.deinit();
+    var lane = try q.Lane.load(gpu.d, cap / 10);
+    defer lane.unload();
+    lane.narrow32 = true;
+    var reduced = lane;
+    reduced.clusters = false;
+    var entries: [10]Entry = undefined;
+    var kernels: [10]g.Kernel = undefined;
+    inline for (.{ q.Mode.fp4, q.Mode.fp8 }, 0..) |mode, mi| inline for (.{ q.Out.bf16, q.Out.f32 }, 0..) |out, oi| inline for (.{ false, true }, 0..) |cluster, ci| {
+        const i = mi * 4 + oi * 2 + ci;
+        entries[i] = .{
+            .product = .{ .rig = .{ .gpu = gpu, .s = s }, .lane = if (cluster) &lane else &reduced, .mode = mode, .clusters = cluster, .out_kind = out },
+            .name = std.fmt.comptimePrint("qmmf narrow32 {s} {s} {s}", .{ @tagName(mode), @tagName(out), if (cluster) "cluster" else "reduce" }),
+        };
+    };
+    inline for (.{ q.Out.bf16, q.Out.f32 }, 0..) |out, i| {
+        entries[8 + i] = .{
+            .product = .{ .rig = .{ .gpu = gpu, .s = s }, .lane = &lane, .mode = .fp4, .clusters = true, .out_kind = out },
+            .name = "control: qmmf narrow32 FP4 " ++ @tagName(out) ++ " scale 1.5x",
+            .control = true,
+        };
+    }
+    defer for (&entries) |*entry| entry.product.deinit();
+    for (&entries, &kernels) |*entry, *kernel| kernel.* = entry.kernel();
+    var tally: g.Tally = .{};
+    try g.runAll(gpu.gpa, &kernels, 0x3232, &tally);
+    const problems = try liveLimits(gpu, lane);
+    std.debug.print("SUMMARY qmmf narrow32 contract: {d} kernels, {d} pass gates1-4, {d} fail; {d} controls, {d} red, {d} missed; {d} live limit problems\n", .{
+        tally.kernels, tally.passed, tally.failed, tally.controls, tally.caught, tally.missed, problems,
+    });
+    try check.expect(tally.problems() + problems == 0, "narrow32 focused contract failed", .{});
+}
+
+fn liveLimits(gpu: check.Gpu, lane: q.Lane) !usize {
+    const limits = core.contract.limits;
+    const target = limits.target(120).?;
+    var problems: usize = 0;
+    inline for (.{ q.Mode.fp4, q.Mode.fp8 }) |mode| inline for (.{ false, true }) |wide| inline for (.{ false, true }) |cluster| {
+        const symbol = q.narrow32Symbol(mode, cluster, wide);
+        const f = try lane.mod.function(symbol);
+        const usage: limits.Usage = .{
+            .regs = @intCast(try f.attribute(.num_regs)),
+            .static = @intCast(try f.attribute(.shared_size_bytes)),
+            .bound = @intCast(try f.attribute(.max_threads_per_block)),
+            .local = @intCast(try f.attribute(.local_size_bytes)),
+        };
+        const launch: limits.CudaLaunch = .{
+            .name = "qmmf narrow32 " ++ @tagName(mode),
+            .symbol = symbol,
+            .image = "qmmf",
+            .threads = 128,
+            .dynamic = q.narrow32Shared(mode),
+            .cluster = if (cluster) 8 else 1,
+            .min_sm = if (cluster) 90 else 80,
+        };
+        var why: std.ArrayList(u8) = .empty;
+        defer why.deinit(gpu.gpa);
+        const bad = try limits.cuda(launch, usage, target, &why, gpu.gpa);
+        if (bad != 0) problems += 1;
+        std.debug.print("{s} limits sm120 {s} f32={} cluster={}: regs {d}, static {d}, dynamic {d}, bound {d}, local {d}\n", .{
+            if (bad == 0) "PASS" else "FAIL", launch.name, wide, cluster, usage.regs, usage.static, launch.dynamic, usage.bound, usage.local,
+        });
+        if (bad != 0) std.debug.print("{s}", .{why.items});
+    };
+    return problems;
+}
