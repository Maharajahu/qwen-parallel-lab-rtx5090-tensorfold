+        of(&e, "h", R * g.hidden * 2),      of(&e, "x", R * g.hidden * 2),
+        of(&e, "r", R * g.hidden * 2),      of(&e, "xs", R * (@max(g.intermediate, wide) / 64) * 4),
+    };
+    const tails = [_]Range{
+        of(&e, "amax", V * E.argmaxSlices(g.vocab) * 8), of(&e, "picks", V * cuda.sample.Draws.row_scratch),
+    };
+    const outside = persistent ++ tails;
+    try phase(&e, &outside, &.{});
+    const delta = [_]Range{
+        of(&e, "y", R * wide * 2),               of(&e, "mix", R * wide * 2),
+        of(&e, "z", R * wide * 2),               of(&e, "v", R * wide * 2),
+        of(&e, "q", R * g.k_heads * geo.dk * 2), of(&e, "k", R * g.k_heads * geo.dk * 2),
+        of(&e, "qkv", R * g.convWidth() * 2),    of(&e, "a", R * g.v_heads * 2),
+        of(&e, "b", R * g.v_heads * 2),          of(&e, "beta", R * g.v_heads * 2),
+        of(&e, "g_", R * g.v_heads * 4),
+    };
+    const attention = [_]Range{
+        of(&e, "y", R * wide * 2),                         of(&e, "mix", R * wide * 2),
+        of(&e, "qraw", R * 2 * g.attnWidth() * 2),         of(&e, "qn", R * g.attnWidth() * 2),
+        of(&e, "kraw", R * g.kv_heads * geo.head_dim * 2), of(&e, "vraw", R * g.kv_heads * geo.head_dim * 2),
+        of(&e, "kn", R * g.kv_heads * geo.head_dim * 2),
+    };
+    const part = [_]Range{
+        of(&e, "pm", partials * 4), of(&e, "pl", partials * 4), of(&e, "po", partials * geo.head_dim * 4),
+    };
+    const mlp = [_]Range{
+        of(&e, "gate", R * g.intermediate * 2), of(&e, "up", R * g.intermediate * 2),
+        of(&e, "act", R * g.intermediate * 2),
+    };
+    const logits = [_]Range{of(&e, "logits", V * g.vocab * 2)};
+    try phase(&e, &delta, &outside);
+    try phase(&e, &(attention ++ part), &outside);
+    try phase(&e, &mlp, &outside);
+    try phase(&e, &logits, &outside);
+    const shared = if (compact)
+        @max(size(&delta), size(&attention) + size(&part), size(&mlp), size(&logits))
+    else
+        @max(size(&delta), size(&attention), size(&mlp)) + size(&part) + size(&logits);
+    try std.testing.expectEqual(size(&persistent) + shared + size(&tails), measured);
+    if (compact) {
+        try std.testing.expectEqual(e.y, e.logits);
+        try std.testing.expectEqual(e.y, e.gate);
+        try std.testing.expect(e.pm >= e.kn + R * g.kv_heads * geo.head_dim * 2);
+    } else {
+        for (part ++ logits) |a| for (delta ++ attention ++ mlp) |b| try separate(a, b);
+    }
+    const addresses = [_]u64{ e.y, e.qn, e.pm, e.gate, e.logits, e.picks };
+    e.arena_at = start;
+    try std.testing.expectEqual(measured, try scratch(&e, .allocate));
+    try std.testing.expectEqualSlices(u64, &addresses, &.{ e.y, e.qn, e.pm, e.gate, e.logits, e.picks });
+    return measured;
+}
+
+test "served scratch: compact phases stay disjoint and measure matches the actual carve at dense geometries" {
+    for ([_]bool{ false, true }) |large| for ([_]usize{ 0, 13 * 256 }) |start| {
+        var g = shape(large);
+        for ([_]u2{ 0, 1, 2 }) |quant| {
+            g.kinds.modelopt = quant != 0;
+            const baseline = try prove(g, false, quant, start);
+            const compact = try prove(g, true, quant, start);
+            try std.testing.expect(compact < baseline);
+            if (large) try std.testing.expectEqual(@as(usize, 214564864), baseline - compact);
+        }
+    };
+}
+
+test "served scratch: compact refuses MoE before changing the arena or scratch pointers" {
+    var e: E.Engine = undefined;
+    e.g = shape(false);
+    e.g.experts = 256;
+    e.compact_scratch = true;
+    e.arena_at = 256;
+    e.logits = 1234;
+    for ([_]@import("cuda_scratch.zig").Mode{ .measure, .allocate }) |mode|
+        try std.testing.expectError(error.CompactScratchNeedsDenseQwen, scratch(&e, mode));
+    try std.testing.expectEqual(@as(usize, 256), e.arena_at);
+    try std.testing.expectEqual(@as(u64, 1234), e.logits);
+}
