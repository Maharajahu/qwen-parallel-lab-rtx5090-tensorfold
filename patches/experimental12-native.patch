+    try t.expectEqual(@as(u64, 4926210048), try maximumSnapshotBytes(g, 32));
+    const Huge = struct {
+        fn stateBytes(_: @This()) u64 {
+            return std.math.maxInt(u64);
+        }
+    };
+    try t.expectError(error.Overflow, maximumSnapshotBytes(Huge{}, 2));
+}
+
+test "GPU prefix snapshot stays live when evicted during a pending resume and makes no host copy" {
+    const t = std.testing;
+    const F = SnapshotTest;
+    var d = F.driver();
+    var e: Engine = undefined;
+    e.d = &d;
+    e.stream = .{ .d = &d, .handle = F.D.stream };
+    e.g = F.geometry();
+    var cache: Cache = undefined;
+    cache.pend = 0;
+    cache.state = try cuda.DeviceBuffer.alloc(&d, e.g.stateBytes());
+    defer cache.state.free();
+    var x: Prefix = undefined;
+    x.gpa = t.allocator;
+    x.e = &e;
+    x.fine = false;
+    var owner: Owner = .{ .cache = &cache };
+    defer x.discardPending(&owner);
+    const before = cuda.usage(false);
+    var saved: ?radix.Saved = try Prefix.save(&x, &owner, 4096);
+    defer if (saved) |s| Prefix.drop(&x, s);
+    const snapshot: *Snap = @ptrCast(@alignCast(saved.?));
+    try t.expectEqual(before.device + e.g.stateBytes(), cuda.usage(false).device);
+    try t.expectEqual(before.host, cuda.usage(false).host);
+    try t.expectEqual(cache.state.ptr, F.src);
+    try t.expectEqual(snapshot.device.ptr, F.dst);
+    try t.expectEqual(e.g.stateBytes(), F.size);
+    try Prefix.restore(&x, &owner, saved.?);
+    Prefix.drop(&x, saved.?);
+    saved = null;
+    try t.expectEqual(@as(usize, 1), snapshot.refs);
+    try x.put(&owner);
+    try t.expect(owner.pending == null);
+    try t.expectEqual(before.device, cuda.usage(false).device);
+    try t.expectEqual(cache.state.ptr, F.dst);
+    try t.expectEqual(@as(usize, 2), F.calls);
+    try t.expectEqual(@as(usize, 0), F.D.hosts);
+    try t.expectEqual(@as(usize, 0), F.D.freed_pending);
+}
+
+test "GPU prefix save and restore failures drain copies before releasing their owners" {
+    const t = std.testing;
+    const F = SnapshotTest;
+    var d = F.driver();
+    var e: Engine = undefined;
+    e.d = &d;
+    e.stream = .{ .d = &d, .handle = F.D.stream };
+    e.g = F.geometry();
+    var cache: Cache = undefined;
+    cache.pend = 0;
+    cache.state = try cuda.DeviceBuffer.alloc(&d, e.g.stateBytes());
+    defer cache.state.free();
+    var x: Prefix = undefined;
+    x.gpa = t.allocator;
+    x.e = &e;
+    x.fine = false;
+    var owner: Owner = .{ .cache = &cache };
+    defer x.discardPending(&owner);
+    const before = cuda.usage(false);
+    for ([_]bool{ true, false }) |copy_fails| {
+        F.fail_copy = copy_fails;
+        F.D.fail_wait_in = if (copy_fails) 0 else 1;
+        try t.expectError(error.NotReady, Prefix.save(&x, &owner, 4096));
+        try t.expectEqual(before.device, cuda.usage(false).device);
+        try t.expectEqual(@as(usize, 0), F.D.freed_pending);
+    }
+    const saved = try Prefix.save(&x, &owner, 4096);
+    defer Prefix.drop(&x, saved);
+    for ([_]bool{ true, false }) |copy_fails| {
+        try Prefix.restore(&x, &owner, saved);
+        F.fail_copy = copy_fails;
+        F.D.fail_wait_in = if (copy_fails) 0 else 1;
+        try t.expectError(error.NotReady, x.put(&owner));
+        try t.expect(owner.pending == null);
+        try t.expectEqual(before.device + e.g.stateBytes(), cuda.usage(false).device);
+        try t.expectEqual(@as(usize, 0), F.D.freed_pending);
+    }
+    try t.expectEqual(before.host, cuda.usage(false).host);
+    try t.expectEqual(@as(usize, 0), F.D.hosts);
+}
