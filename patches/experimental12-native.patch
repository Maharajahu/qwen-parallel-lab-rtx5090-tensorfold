@@ -0,0 +1,99 @@
+//! Compact page reservations exercise real tables, pool refusal and the pre-launch guard without a GPU.
+const std = @import("std");
+const cuda = @import("cuda");
+const pages = @import("cuda_pages.zig");
+const E = @import("cuda_engine.zig");
+const t = std.testing;
+const D = cuda.paging_test_device.Device;
+
+fn engine(d: *cuda.Driver, rows: u32) E.Engine {
+    var e: E.Engine = undefined;
+    e.d = d;
+    e.stream = .{ .d = d, .handle = D.stream };
+    e.kv8 = true;
+    e.window_rows = rows;
+    e.verify_rows = E.most_verify;
+    e.learning = null;
+    e.n_taps = 0;
+    e.tap_capacity = @import("cuda_engine.zig").tap_rows;
+    e.compact_scratch = false;
+    e.g = .{ .hidden = 256, .intermediate = 256, .layers = 2, .vocab = 8, .k_heads = 1, .v_heads = 1, .q_heads = 2, .kv_heads = 1, .eps = 1e-6, .tied = true, .context = 65536, .linear = @splat(false) };
+    e.g.linear[0] = true;
+    return e;
+}
+
+test "compact KV is exact opt-in and follows the configured verify width, including 64" {
+    for ([_]u32{ 2, 16, 64 }) |rows| {
+        try t.expectEqual(rows, try pages.lookaheadOf("1", rows));
+        for ([_]?[]const u8{ null, "0", "" }) |value|
+            try t.expectEqual(pages.window_rows, try pages.lookaheadOf(value, rows));
+        for ([_][]const u8{ "true", "01", " 1 " }) |value|
+            try t.expectError(error.InvalidEnvironment, pages.lookaheadOf(value, rows));
+    }
+}
+
+test "compact KV maximum-context tables cover aligned and nonaligned requests and guard every extra row" {
+    for ([_]u32{ 2, 16, 64 }) |rows| for ([_]usize{ 1, 48, 128 }) |tokens| {
+        for ([_]usize{ 65535, 65536 }) |capacity| {
+            var d = D.driver();
+            var e = engine(&d, rows);
+            const l = pages.layoutWithRows(&e, capacity, tokens, 0, 0, rows);
+            const n = l.need(capacity - 1, 1, rows);
+            const p = try pages.Pages.initWithRows(t.allocator, &e, l, capacity, 0, 1, n, rows);
+            defer p.deinit();
+            try t.expect(p.fits(capacity - 1, 1));
+            try t.expect(!p.fits(capacity, 1));
+            try t.expect(!p.fits(capacity + 1, 0));
+            const cache = try p.open(capacity - 1, 1);
+            defer _ = p.close(cache);
+            const table = cache.paged.?.table;
+            const kv_pages = n - l.runPages();
+            try t.expectEqual(kv_pages * 4, table.len);
+            try t.expectEqual(table.len, l.fixed_bytes);
+            try t.expectEqual(kv_pages, cache.paged.?.ids.len);
+            try t.expectEqual(kv_pages * tokens, cache.cap);
+            try t.expect(cache.cap >= capacity + rows);
+            try t.expect(cache.cap - (capacity + rows) < tokens);
+            var ids: [E.max_rows]u32 = @splat(0);
+            // A full-size final prefill chunk still fits entirely inside the prompt.
+            cache.len = capacity - 1 - E.max_rows;
+            try e.admit(&.{.{ .cache = cache, .rows = E.max_rows }}, &ids, .last);
+            // Every reserved speculative slot fits; graph bucket padding must never consume more slots.
+            cache.len = cache.cap - rows;
