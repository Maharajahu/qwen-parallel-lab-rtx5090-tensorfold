+            try startup.calibrate(&state, a, &cfg);
+            try std.testing.expectEqual(@as(u32, 16), cfg.family_width);
+            try std.testing.expectEqual(@as(?f64, 16.25), cfg.family_costs.get(16));
+            try std.testing.expectEqual(@as(?f64, null), cfg.family_costs.get(17));
+            for (shared) |c| try std.testing.expectEqual(@as(?f64, c.ms), cfg.shared_costs.get(c.width));
+            try std.testing.expect(state.prepare == null);
+        }
+    }
+}
diff --git a/zig/kernels/cuda/nvfp4_dense.cu b/zig/kernels/cuda/nvfp4_dense.cu
new file mode 100644
index 00000000..f9572d4c
--- /dev/null
+++ b/zig/kernels/cuda/nvfp4_dense.cu
@@ -0,0 +1,158 @@
+// Native-A4 (TensorFold contributors, Apache-2.0): ck_experts/ck_lane math; words differ from qmmf W4A16.
+#include <cuda_bf16.h>
+#include <cuda_fp8.h>
+#include <stdint.h>
+#include "mma4.cuh"
+#include "nvfp4q.cuh"
+#include "common/qmm_frag.cuh"
+
+namespace tf_nvfp4_dense {
+constexpr int BM = 32, BN = 128, THREADS = 128, STAGES = 4;
+constexpr int X = BM * 32, XS = BM * 4, W = BN * 32, WS = BN * 4;
+constexpr int STAGE = X + XS + W + WS;
+static_assert(STAGE % 128 == 0);
+
+__device__ __forceinline__ float max_nan(float a, float b) {
+    return (a > b || a != a) ? a : b;
+}
+}  // namespace tf_nvfp4_dense
+
+// tf_ck_quant4's arithmetic: one thread quantizes 16 BF16 values; NaN poisons the group's scale.
+extern "C" __global__ void __launch_bounds__(128)
+tf_nvfp4_quantize(const __nv_bfloat16* __restrict__ x, int ldx, int M, int K, float g,
+                  uint8_t* __restrict__ codes, uint8_t* __restrict__ scales) {
+    const long long i = static_cast<long long>(blockIdx.x) * blockDim.x + threadIdx.x;
+    if (i >= static_cast<long long>(M) * (K / 16)) return;
+    const int row = i / (K / 16), blk = i % (K / 16);
+    float f[16], amax = 0.0f;
+#pragma unroll
+    for (int j = 0; j < 16; ++j) {
+        f[j] = __bfloat162float(x[static_cast<size_t>(row) * ldx + blk * 16 + j]);
+        amax = tf_nvfp4_dense::max_nan(amax, fabsf(f[j]));
+    }
+    const nvfp4q::Scale sc = nvfp4q::block_scale(amax, g);
+    uint32_t lo = 0, hi = 0;
+#pragma unroll
+    for (int j = 0; j < 8; ++j) {
+        lo |= nvfp4q::e2m1(f[j] * sc.mul) << (4 * j);
+        hi |= nvfp4q::e2m1(f[j + 8] * sc.mul) << (4 * j);
+    }
+    *reinterpret_cast<uint2*>(codes + static_cast<size_t>(row) * (K / 2) + blk * 8) = make_uint2(lo, hi);
+    scales[i] = static_cast<uint8_t>(sc.sf8);
+}
+
+// tf_ck_pack4's native nibble order, with padded output rows. No re-quantization or value changes.
+extern "C" __global__ void __launch_bounds__(256)
+tf_nvfp4_pack_words(const uint8_t* __restrict__ src, uint32_t* __restrict__ dst, int N, int K, int Npad) {
+    const int tile = blockIdx.x, kg = blockIdx.y, j = threadIdx.x >> 5, lane = threadIdx.x & 31;
+    const int row = tile * 64 + j * 8 + (lane >> 2), t = lane & 3;
+    if (row >= Npad) return;
+    uint32_t* out = dst + ((static_cast<size_t>(tile) * (K / 64) + kg) * 8 + j) * 64 + lane * 2;
+    if (row >= N) { out[0] = out[1] = 0; return; }
+    const uint8_t* p = src + static_cast<size_t>(row) * (K / 2) + kg * 32;
+    out[0] = *reinterpret_cast<const uint32_t*>(p + 4 * t);
+    out[1] = *reinterpret_cast<const uint32_t*>(p + 16 + 4 * t);
+}
+
+// All row counts use the same m16n8k64 MMA order and shape-only K splits; no A16 tail or atomics.
+extern "C" __global__ void __launch_bounds__(128)
+tf_nvfp4_dense_partial(const uint8_t* __restrict__ x, const uint8_t* __restrict__ xs,
+                       const uint8_t* __restrict__ w, const uint8_t* __restrict__ ws,
+                       float* __restrict__ part, int M, int N, int K, int SK) {
+    using namespace tf_nvfp4_dense;
+    using namespace qmm_frag;
+    extern __shared__ __align__(128) uint8_t buf[];
+    const int tid = threadIdx.x, lane = tid & 31, warp = tid >> 5;
+    const int m0 = blockIdx.y * BM, n0 = blockIdx.x * BN;
+    const int KG = K / 64, per = KG / SK, first = blockIdx.z * per;
+    auto stage = [&](int s) { return buf + s * STAGE; };
+    auto load = [&](int s, int kg) {
+        uint8_t* p = stage(s);
+        for (int c = tid; c < BM * 2; c += THREADS) {
+            const int r = c / 2, ch = c % 2;
+            const bool in = m0 + r < M;
+            cp16z(p + r * 32 + mma4::chunk<mma4::A4>(r, ch) * 16,
+                  x + static_cast<size_t>(in ? m0 + r : 0) * (K / 2) + kg * 32 + ch * 16, in);
+        }
+        for (int r = tid; r < BM; r += THREADS) {
+            const bool in = m0 + r < M;
+            if (in) cp4(p + X + r * 4, xs + static_cast<size_t>(m0 + r) * (K / 16) + kg * 4);
+            else *reinterpret_cast<uint32_t*>(p + X + r * 4) = 0;
+        }
+        uint8_t* pw = p + X + XS;
+        for (int c = tid; c < W / 16; c += THREADS) {
+            const int tile = c / 128, off = c % 128;
+            const bool in = n0 + tile * 64 < N;
+            const size_t from = (static_cast<size_t>(n0 / 64 + (in ? tile : 0)) * KG + kg) * 2048;
+            cp16z(pw + c * 16, w + from + off * 16, in);
+        }
+        for (int c = tid; c < BN; c += THREADS) {
+            const bool in = n0 + c < N;
+            const size_t from = (static_cast<size_t>((n0 + c) / 64) * KG + kg) * 256 + (c % 64) * 4;
+            if (in) cp4(pw + W + c * 4, ws + from);
+            else *reinterpret_cast<uint32_t*>(pw + W + c * 4) = 0;
+        }
+    };
+    float acc[2][4][4] = {};
+#pragma unroll
+    for (int s = 0; s < STAGES - 1; ++s) {
+        if (s < per) load(s, first + s);
+        commit();
+    }
+    for (int it = 0; it < per; ++it) {
+        wait<STAGES - 2>();
+        __syncthreads();
+        const int next = it + STAGES - 1;
+        if (next < per) load(next % STAGES, first + next);
+        commit();
+        const uint8_t* p = stage(it % STAGES);
+        const uint8_t* pw = p + X + XS;
+        const int q = lane >> 3, rr = lane & 7, g = lane >> 2;
+        uint2 b[4];
+        uint32_t sb[4];
+#pragma unroll
+        for (int j = 0; j < 4; ++j) {
+            const int col = warp * 32 + j * 8;
+            b[j] = reinterpret_cast<const uint2*>(pw)[(col / 8) * 32 + lane];
+            sb[j] = reinterpret_cast<const uint32_t*>(pw + W)[col + g];
+        }
+#pragma unroll
+        for (int i = 0; i < 2; ++i) {
+            uint32_t a[4];
+            const int r = i * 16 + rr + (q & 1) * 8;
+            ldmatrix4(a, p + r * 32 + mma4::chunk<mma4::A4>(r, q >> 1) * 16);
+            const int sr = i * 16 + ((lane & 1) << 3) + g;
+            const uint32_t sa = reinterpret_cast<const uint32_t*>(p + X)[sr];
+#pragma unroll
+            for (int j = 0; j < 4; ++j) mma4::mma_fp4(acc[i][j], a, b[j].x, b[j].y, sa, sb[j]);
+        }
+    }
+    wait<0>();
+    __syncthreads();
+#pragma unroll
+    for (int i = 0; i < 2; ++i)
+#pragma unroll
+        for (int j = 0; j < 4; ++j)
+#pragma unroll
+            for (int h = 0; h < 2; ++h) {
+                const int row = m0 + i * 16 + (lane >> 2) + h * 8;
+                const int col = n0 + warp * 32 + j * 8 + (lane & 3) * 2;
+                if (row >= M || col >= N) continue;
+                float* out = part + (static_cast<size_t>(blockIdx.z) * M + row) * N + col;
+                out[0] = acc[i][j][2 * h];
+                if (col + 1 < N) out[1] = acc[i][j][2 * h + 1];
+            }
+}
+
+// Identical ordered reduction for SK=1 too: one fp32 multiply, then the requested output rounding.
+extern "C" __global__ void __launch_bounds__(256)
+tf_nvfp4_dense_reduce(const float* __restrict__ part, void* __restrict__ output,
+                      long long total, int SK, float alpha, int out_f32) {
+    const long long i = static_cast<long long>(blockIdx.x) * blockDim.x + threadIdx.x;
+    if (i >= total) return;
+    float value = part[i];
+    for (int s = 1; s < SK; ++s) value = value + part[s * total + i];
+    value = value * alpha;
+    if (out_f32) reinterpret_cast<float*>(output)[i] = value;
+    else reinterpret_cast<__nv_bfloat16*>(output)[i] = __float2bfloat16_rn(value);
+}
