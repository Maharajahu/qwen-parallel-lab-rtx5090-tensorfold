+
+/// The streams served, the page plan and layout or the KV ledger plan, and TF_KV_SHARE's count when states take slots.
+pub const Count = struct { streams: u32, paged: ?kv_pages.Plan, layout: ?kv_pool.Layout, ledger: ?ledger.Plan = null, slots: ?usize = null, planned: ?kv_pool.Budget = null };
+
+pub const CacheRoom = struct { room: u64, streams: u64 };
+
+/// A host cache sits beside every admitted full window, including a request ledger's declared scratch.
+pub fn cacheRoom(room: u64, stream_bytes: u64, free: u32, counted: Count) CacheRoom {
+    if (counted.ledger) |p| return .{
+        .room = room -| p.cost.each.scratch,
+        .streams = p.one_full *| (counted.streams -| p.standing.streams),
+    };
+    return .{ .room = room, .streams = stream_bytes *| (counted.streams -| free) };
+}
+
+/// TF_KV_SHARE: the cache's part made pool pages, all of it unless the family keeps its states' rest elsewhere (GLM).
+pub fn keptPpm(comptime F: type, share: bool) u32 {
+    if (!share) return 0;
+    return if (@hasDecl(F, "share_kept_ppm")) F.share_kept_ppm else 1_000_000;
+}
+
+/// TF_KV_SHARE's store opens over a cache to make pages of, or for a family keeping copies (GLM) when it keeps any.
+pub fn opensStore(comptime F: type, share: bool, cache: u64, limit: usize) bool {
+    return share and if (keptPpm(F, true) == 0) limit > 0 else cache > 0;
+}
+
+/// TF_KV_SHARE's count when its states take the plan's slots: share on, a layout slot, and the cache on the device.
+pub fn shareSlots(share: bool, snap_bytes: u64, host_cache: bool) !?usize {
+    return if (share and snap_bytes > 0 and !host_cache) try @import("core").kv_prompts.sharing() else null;
+}
+
+/// The family's streams in `b.room`; null with `problem` set when none fit or --parallel asks for more than fit.
+pub fn count(comptime F: type, a: Allocator, loaded: anytype, o: api.Open, b: Budget, problem: *[]const u8) !?Count {
+    const free = loaded.free_streams;
+    const grow = budget.growRoom(b.room, !@hasField(F.Options, "lanes"));
+    const wrapped = kv_pages.wrapped(F, loaded, free, b.stream_bytes, b.room);
+    if (wrapped.layout) |l| {
+        const slots = try shareSlots(b.share, l.snap_bytes, b.host_cache); // GLM: a slot a state
+        const planned = kv_pages.budgetWithRows(l, wrapped.room, o, @intCast(b.window), b.host_cache, kv_pages.enginePaged(loaded), keptPpm(F, b.share), slots, kv_pages.lookahead(F, loaded));
+        const paged = try kv_pages.preparedPlan(a, l, planned, @intCast(b.window), problem, kv_pages.firstRun(loaded)) orelse return null;
+        return .{ .streams = paged.lanes, .paged = paged, .layout = l, .slots = slots, .planned = if (slots != null) planned else null };
+    }
+    // --parallel caps the streams; each request reserves its own bytes (a family that allocates per request)
+    if (ledger.wanted(F, loaded, b.stream_bytes)) {
+        var short: ?ledger.Short = null;
+        const p = ledger.plan(F, loaded, o, .{ .room = b.room, .context = b.window, .host_budget = b.host_budget, .host_cache = b.host_cache }, &short) orelse {
+            problem.* = try std.fmt.allocPrint(a, no_stream, .{ b.window, toGib(short.?.one_full +| short.?.scratch), toGib(b.room), toGib(b.model), toGib(b.reserve), b.low });
+            return null;
+        };
+        return .{ .streams = o.lanes, .paged = null, .layout = null, .ledger = p };
+    }
+    const streams = budget.admit(grow, b.stream_bytes, free, o.lanes, o.lanes_fixed) catch |e| {
+        problem.* = switch (e) {
+            error.NoStream => try std.fmt.allocPrint(a, no_stream, .{
+                b.window,
+                toGib(b.stream_bytes),
+                toGib(b.room),
+                toGib(b.model),
+                toGib(b.reserve),
+                b.low,
+            }),
+            error.TooMany => try std.fmt.allocPrint(a, too_many, .{
+                o.lanes,
+                toGib(b.stream_bytes * (o.lanes -| free)),
+                b.window,
+                toGib(b.room),
+                b.low,
+                free + grow / b.stream_bytes,
+            }),
+        };
+        return null;
+    };
+    return .{ .streams = streams, .paged = null, .layout = null };
+}
+
+test "TF_KV_SHARE makes the whole cache pool pages and opens on a cache, unless the family keeps copies in slots (GLM)" {
+    const Paged = struct {};
+    const Copies = struct {
+        pub const share_kept_ppm: u32 = 0;
+    };
+    try std.testing.expectEqual(@as(u32, 1_000_000), keptPpm(Paged, true));
+    try std.testing.expectEqual(@as(u32, 0), keptPpm(Copies, true));
+    try std.testing.expectEqual(@as(u32, 0), keptPpm(Paged, false));
+    try std.testing.expect(opensStore(Paged, true, 1, 0) and !opensStore(Paged, true, 0, 0) and !opensStore(Paged, false, 1, 0));
+    try std.testing.expect(opensStore(Copies, true, 0, 1) and !opensStore(Copies, true, 1 << 30, 0) and !opensStore(Copies, false, 0, 1));
+}
+
+test "TF_KV_SHARE's states take slots only with share on, a layout slot and the cache on the device" {
+    try std.testing.expect(try shareSlots(true, 1, false) != null);
+    try std.testing.expect(try shareSlots(false, 1, false) == null);
+    try std.testing.expect(try shareSlots(true, 0, false) == null);
+    try std.testing.expect(try shareSlots(true, 1, true) == null);
+}
+
+test "CUDA cache default uses the declared request ledger windows and scratch" {
+    const GiB: u64 = 1 << 30;
+    var counted: Count = .{ .streams = 8, .paged = null, .layout = null };
+    const whole = cacheRoom(88 * GiB, 5 * GiB, 1, counted);
+    try std.testing.expectEqual(@as(u64, 35 * GiB), whole.streams);
+    counted.ledger = .{
+        .total = 88 * GiB,
+        .kept = .{ .snaps = 0, .copied = 0, .snap_bytes = 0 },
+        .one_full = 6 * GiB,
+        .standing = .{ .streams = 1, .each = 6 * GiB },
+        .cost = .{ .context = 1, .each = .{ .layout = .{ .fixed_bytes = 0, .token_bytes = 1, .page_tokens = 1, .snap_bytes = 0 }, .scratch = 2 * GiB } },
+    };
+    const actual = cacheRoom(88 * GiB, 5 * GiB, 1, counted);
+    try std.testing.expectEqual(@as(u64, 86 * GiB), actual.room);
+    try std.testing.expectEqual(@as(u64, 42 * GiB), actual.streams);
+    try std.testing.expectEqual(@as(u64, 22 * GiB), budget.hostCacheBudget(null, 96 * GiB, actual.room, actual.streams, true));
+}
+
+const AllPaged = struct {
+    pub const Options = struct { lanes: u32 };
+    pub const window_rows = 3;
+    const layout: kv_pool.Layout = .{ .fixed_bytes = 3, .token_bytes = 2, .page_tokens = 4, .snap_bytes = 0, .run_bytes = 9 };
+    pub fn pagedLayout(_: *anyopaque, extra: u64) ?kv_pool.Layout {
+        var l = layout;
+        l.fixed_bytes += extra;
+        return l;
+    }
+};
+
+test "shared prefix budget: Qwen PAGES_ALL parallel one pays fixed and one complete request exactly once" {
+    var arena = std.heap.ArenaAllocator.init(std.testing.allocator);
+    defer arena.deinit();
+    var ctx: u8 = 0;
+    const l = AllPaged.layout;
+    const loaded = .{ .ctx = @as(*anyopaque, &ctx), .layout = @as(?kv_pool.Layout, l), .stream_bytes = @as(u64, 35), .free_streams = @as(u32, 0), .engine_paged = true, .all_on_pages = false, .prefix_device_bytes = @as(usize, 0) };
+    const o: api.Open = .{ .dir = "", .model_type = "qwen3_5", .lanes = 1, .lanes_fixed = true, .prompt_cache_gib = 0 };
+    const complete = l.fixed_bytes + l.need(5, 0, AllPaged.window_rows) * l.pageBytes();
+    try std.testing.expectEqual(@as(u64, 35), complete);
+    var b: Budget = .{ .room = complete, .model = 0, .reserve = 0, .low = "", .window = 5, .stream_bytes = 35, .host_cache = false, .host_budget = 0, .share = false };
+    var problem: []const u8 = "";
+    // Both the exact boundary and a large budget must retain the first run in the maximum arena size.
+    for ([_]u64{ complete, 1000 }) |room| {
+        b.room = room;
+        const got = (try count(AllPaged, arena.allocator(), loaded, o, b, &problem)).?;
+        try std.testing.expectEqual(@as(u32, 1), got.streams);
+        try std.testing.expectEqual(@as(usize, 4), got.paged.?.pages);
+        try std.testing.expectEqual(complete, l.fixed_bytes + got.paged.?.pages * l.pageBytes());
+    }
+    b.room = complete - 1;
+    try std.testing.expectEqual(@as(?Count, null), try count(AllPaged, arena.allocator(), loaded, o, b, &problem));
+    try std.testing.expect(std.mem.indexOf(u8, problem, "5-token window") != null);
+}
+
+test "shared prefix budget: Qwen all-paged adaptive lanes leave every private run and fixed part within device room" {
+    var arena = std.heap.ArenaAllocator.init(std.testing.allocator);
+    defer arena.deinit();
+    var ctx: u8 = 0;
+    const l = AllPaged.layout;
+    const loaded = .{ .ctx = @as(*anyopaque, &ctx), .layout = @as(?kv_pool.Layout, l), .stream_bytes = @as(u64, 35), .free_streams = @as(u32, 0), .engine_paged = true, .all_on_pages = false, .prefix_device_bytes = @as(usize, 0) };
+    var o: api.Open = .{ .dir = "", .model_type = "qwen3_5", .lanes = 4, .prompt_cache_gib = 0 };
+    var b: Budget = .{ .room = 62, .model = 0, .reserve = 0, .low = "", .window = 5, .stream_bytes = 35, .host_cache = false, .host_budget = 0, .share = false };
+    var problem: []const u8 = "";
+    const two = (try count(AllPaged, arena.allocator(), loaded, o, b, &problem)).?;
+    try std.testing.expectEqual(@as(u32, 2), two.streams);
+    try std.testing.expectEqual(@as(usize, 7), two.paged.?.pages);
+    try std.testing.expectEqual(b.room, two.streams * l.fixed_bytes + two.paged.?.pages * l.pageBytes());
+    b.room -= 1;
+    try std.testing.expectEqual(@as(u32, 1), (try count(AllPaged, arena.allocator(), loaded, o, b, &problem)).?.streams);
+    o.lanes = 2;
+    o.lanes_fixed = true;
+    try std.testing.expectEqual(@as(?Count, null), try count(AllPaged, arena.allocator(), loaded, o, b, &problem));
+}
+
+test "shared prefix budget: first-run arena accounting preserves ordinary Qwen and other paged families" {
+    var ctx: u8 = 0;
+    const l = AllPaged.layout;
+    var qwen: struct { ctx: *anyopaque, layout: ?kv_pool.Layout, stream_bytes: u64, free_streams: u32, engine_paged: bool, all_on_pages: bool } = .{ .ctx = &ctx, .layout = l, .stream_bytes = 35, .free_streams = 0, .engine_paged = false, .all_on_pages = false };
+    try std.testing.expect(!kv_pages.firstRun(qwen));
+    try std.testing.expectEqual(@as(u64, 965), kv_pages.wrapped(AllPaged, qwen, 0, 35, 1000).room);
+    qwen.engine_paged = true;
+    try std.testing.expectEqual(@as(u64, 997), kv_pages.wrapped(AllPaged, qwen, 0, 35, 1000).room);
+    // A drafter's additional fixed storage stays outside the arena and is charged for the first lane too.
+    try std.testing.expectEqual(@as(u64, 990), kv_pages.wrapped(AllPaged, qwen, 0, 42, 1000).room);
+    const other = .{ .ctx = @as(*anyopaque, &ctx), .layout = @as(?kv_pool.Layout, l), .stream_bytes = @as(u64, 35), .free_streams = @as(u32, 0), .engine_paged = true };
+    try std.testing.expect(!kv_pages.firstRun(other));
+    try std.testing.expectEqual(@as(u64, 965), kv_pages.wrapped(AllPaged, other, 0, 35, 1000).room);
+    const b: kv_pool.Budget = .{ .room = 1000, .engine = 0, .lanes = 2, .window = 8, .engine_paged = true };
+    try std.testing.expectEqual(try kv_pool.plan(l, b), try kv_pages.planBudget(l, b, false));
+}
+
+test "compact KV startup uses the loaded lookahead for the same exact page and run admission boundary" {
+    var arena = std.heap.ArenaAllocator.init(std.testing.allocator);
+    defer arena.deinit();
+    var ctx: u8 = 0;
+    const l = AllPaged.layout;
+    const loaded = .{ .ctx = @as(*anyopaque, &ctx), .layout = @as(?kv_pool.Layout, l), .stream_bytes = @as(u64, 67), .free_streams = @as(u32, 0), .engine_paged = true, .all_on_pages = false, .kv_lookahead = @as(u32, 16) };
+    const o: api.Open = .{ .dir = "", .model_type = "qwen3_5", .lanes = 1, .lanes_fixed = true, .prompt_cache_gib = 0 };
+    const complete = l.fixed_bytes + l.need(5, 0, loaded.kv_lookahead) * l.pageBytes();
+    try std.testing.expectEqual(@as(u64, 67), complete);
+    try std.testing.expectEqual(@as(u32, 16), kv_pages.lookahead(AllPaged, loaded));
+    try std.testing.expectEqual(AllPaged.window_rows, kv_pages.lookahead(AllPaged, .{}));
+    try std.testing.expectEqual(@as(u32, 0), kv_pages.lookahead(struct {}, .{}));
+    var b: Budget = .{ .room = complete, .model = 0, .reserve = 0, .low = "", .window = 5, .stream_bytes = complete, .host_cache = false, .host_budget = 0, .share = false };
+    var problem: []const u8 = "";
+    const counted = (try count(AllPaged, arena.allocator(), loaded, o, b, &problem)).?;
+    try std.testing.expectEqual(l.need(5, 0, loaded.kv_lookahead), counted.paged.?.pages);
+    b.room -= 1;
+    try std.testing.expectEqual(@as(?Count, null), try count(AllPaged, arena.allocator(), loaded, o, b, &problem));
+    try std.testing.expect(std.mem.indexOf(u8, problem, "5-token window") != null);
+    const ordinary = kv_pages.budgetOf(AllPaged, l, complete, o, 5, false, true, 0, null);
+    const compact = kv_pages.budgetWithRows(l, complete, o, 5, false, true, 0, null, loaded.kv_lookahead);
+    try std.testing.expectEqual(@as(u64, 8), ordinary.window);
+    try std.testing.expectEqual(@as(u64, 21), compact.window);
+}
