diff --git a/zig/src/families/qwen3_5/cuda_shared_costs.zig b/zig/src/families/qwen3_5/cuda_shared_costs.zig
new file mode 100644
index 00000000..14dc05b9
--- /dev/null
+++ b/zig/src/families/qwen3_5/cuda_shared_costs.zig
@@ -0,0 +1,125 @@
+//! Measure shared verification on reserved lanes instead of extrapolating a lone window linearly.
+const std = @import("std");
+const lanes = @import("lanes");
+const E = @import("cuda_engine.zig");
+const shared = lanes.cost_cache;
+const Record = extern struct { schema: u32 = 1, rows: u32, key: [32]u8, ms: [E.most_verify]f64, digest: [32]u8 };
+
+fn record(key: [32]u8, rows: usize, ms: [E.most_verify]f64) Record {
+    var r: Record = .{ .rows = @intCast(rows), .key = key, .ms = ms, .digest = undefined };
+    std.crypto.hash.sha2.Sha256.hash(std.mem.asBytes(&r)[0..@offsetOf(Record, "digest")], &r.digest, .{});
+    return r;
+}
+
+fn accepted(r: Record, key: [32]u8, rows: usize) bool {
+    if (r.schema != 1 or r.rows != rows or rows == 0 or rows > E.most_verify or !std.mem.eql(u8, &r.key, &key)) return false;
+    for (r.ms[0..rows]) |ms| if (!(ms > 0) or !std.math.isFinite(ms)) return false;
+    for (r.ms[rows..]) |ms| if (@as(u64, @bitCast(ms)) != 0) return false;
+    const expected = record(key, rows, r.ms);
+    return std.mem.eql(u8, &r.digest, &expected.digest);
+}
+
+fn keyFor(l: anytype, d: anytype, caches: []const *E.Cache) ![32]u8 {
+    const base = try @import("cuda_cost_adapter.zig").identity(l, d, caches[0]);
+    var buf: [128]u8 = undefined;
+    const shape = try std.fmt.bufPrint(&buf, "{d}/{d}/{d}/{d}/{d}/{d}", .{ caches.len, l.e.window_rows, l.e.verify_rows, l.e.tap_capacity, @intFromBool(caches[0].paged != null), @intFromBool(l.e.compact_scratch) });
+    return shared.referenceKey(&.{ "qwen35-shared-costs-v1", &base.current, shape });
+}
+
+/// Balanced, nonempty windows; all admitted lanes participate once there is a row for each.
+pub fn partition(total: usize, streams: usize, window: usize, out: []usize) !usize {
+    if (total == 0 or streams == 0 or window == 0 or out.len < streams or
+        total > streams * window or total > E.most_verify) return error.InvalidSharedWidth;
+    const count = @min(total, streams);
+    for (out[0..count], 0..) |*n, i| n.* = total / count + @intFromBool(i < total % count);
+    return count;
+}
+
+pub fn measure(l: anytype, d: anytype, caches: []const *E.Cache) !void {
+    if (caches.len < 2 or !try @import("sys").environment.read(bool, "TF_QWEN_SHARED_COSTS", false)) return;
+    const e = l.e;
+    const limit = @min(e.verify_rows, caches.len * e.window_rows);
+    const key = keyFor(l, d, caches) catch null;
+    var ms: [E.most_verify]f64 = @splat(0);
+    var hit = false;
+    if (key) |id| if (shared.load(Record, l.gpa, l.io, id)) |kept| {
+        if (accepted(kept, id, limit)) {
+            hit = true;
+            ms = kept.ms;
+            for ([_]usize{ @min(caches.len, limit), @min(32, limit), @min(64, limit), limit }) |rows| {
+                if (!lanes.cost_rule.entryHolds(ms[rows - 1], try probe(l.io, e, caches, rows))) {
+                    hit = false;
+                    break;
+                }
+            }
+        }
+    };
+    if (!hit) {
+        for (ms[0..limit], 1..) |*value, rows| value.* = try probe(l.io, e, caches, rows);
+        if (key) |id| shared.save(Record, l.gpa, l.io, id, record(id, limit, ms));
+    }
+    for (caches) |cache| try cache.reset(e);
+    for (d.shared_costs.values[0..limit], ms[0..limit], 1..) |*cost, value, rows| cost.* = .{ .width = @intCast(rows), .ms = value };
+    d.shared_costs.len = limit;
+    std.log.info("CUDA shared costs: {s} {d} widths on {d} lanes", .{ if (hit) "cached" else "measured", limit, caches.len });
+    for (d.shared_costs.values[0..limit]) |c| if (c.width == caches.len or c.width % 16 == 0)
+        std.log.info("CUDA shared cost: {d} rows {d:.3} ms", .{ c.width, c.ms });
+}
+
+fn probe(io: std.Io, e: *E.Engine, caches: []const *E.Cache, rows: usize) !f64 {
+    var parts: [E.max_segs]E.Part = undefined;
+    var sizes: [E.max_segs]usize = undefined;
+    const ids: [E.most_verify]u32 = @splat(0);
+    var picks: [E.most_verify]E.Draw = undefined;
+    for (&picks) |*p| p.* = .{ .rule = null, .position = 1 };
+    const n = try partition(rows, caches.len, e.window_rows, &sizes);
+    for (caches[0..n], sizes[0..n], parts[0..n]) |cache, size, *p| p.* = .{ .cache = cache, .rows = size };
+    var best = std.math.inf(f64);
+    for (0..lanes.cost_rule.reps + 1) |rep| {
+        for (caches[0..n]) |cache| try cache.reset(e);
+        const start = std.Io.Clock.awake.now(io);
+        try e.forward(parts[0..n], ids[0..rows], .{ .draws = picks[0..rows] });
+        const ms = @as(f64, @floatFromInt(start.durationTo(std.Io.Clock.awake.now(io)).toNanoseconds())) / 1e6;
+        if (!(ms > 0) or !std.math.isFinite(ms)) return error.InvalidWindowMeasurement;
+        if (rep > 0) best = @min(best, ms);
+    }
+    return best;
+}
+
+test "shared costs partition fits each window and includes every available lane" {
+    var sizes: [E.max_segs]usize = undefined;
+    for ([_]usize{ 2, 8, 12, 16 }) |streams| {
+        for (1..@min(E.most_verify, streams * 16) + 1) |total| {
+            const n = try partition(total, streams, 16, &sizes);
+            try std.testing.expectEqual(@min(total, streams), n);
+            var sum: usize = 0;
+            for (sizes[0..n]) |size| {
+                try std.testing.expect(size > 0 and size <= 16);
+                sum += size;
+            }
+            try std.testing.expectEqual(total, sum);
+        }
+    }
+    try std.testing.expectError(error.InvalidSharedWidth, partition(33, 2, 16, &sizes));
+    try std.testing.expectError(error.InvalidSharedWidth, partition(0, 12, 16, &sizes));
+    try std.testing.expectError(error.InvalidSharedWidth, partition(129, 16, 16, &sizes));
+}
+
+test "shared costs cache rejects corruption and mismatched geometry" {
+    const key = shared.referenceKey(&.{"test"});
+    var ms: [E.most_verify]f64 = @splat(0);
+    @memset(ms[0..32], 20);
+    var r = record(key, 32, ms);
+    try std.testing.expect(accepted(r, key, 32));
+    try std.testing.expect(!accepted(r, key, 16));
+    try std.testing.expect(!accepted(r, shared.referenceKey(&.{"other"}), 32));
+    r.ms[2] = 21;
+    try std.testing.expect(!accepted(r, key, 32));
+    for ([_]f64{ 0, -1, std.math.nan(f64), std.math.inf(f64) }) |value| {
+        ms[0] = value;
+        try std.testing.expect(!accepted(record(key, 32, ms), key, 32));
+    }
+    ms[0] = 20;
+    ms[32] = 1;
+    try std.testing.expect(!accepted(record(key, 32, ms), key, 32));
+}
