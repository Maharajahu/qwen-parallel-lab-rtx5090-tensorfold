--- /dev/null
+++ b/zig/src/families/qwen3_5/cuda_prefix_grid.zig
@@ -0,0 +1,80 @@
+//! Explicit shared-prefix cuts; snapshots resume only with the same preceding chunk arithmetic.
+const std = @import("std");
+
+pub fn enabled(value: ?[]const u8) !bool {
+    const v = value orelse return false;
+    if (std.mem.eql(u8, v, "0")) return false;
+    if (std.mem.eql(u8, v, "1")) return true;
+    return error.BadQwenFinePrefix;
+}
+
+/// Only the deepest explicit hint adds a cut; nearby system hints must not create several small forwards.
+pub fn cuts(a: std.mem.Allocator, len: usize, shared: []const u32, page: u32) ![]const u32 {
+    if (page == 0) return error.BadQwenPrefixPage;
+    var deepest: u32 = 0;
+    for (shared) |hint| {
+        const at = hint - hint % page;
+        if (at < len) deepest = @max(deepest, at);
+    }
+    const out = try a.alloc(u32, if (deepest > 0) 1 else 0);
+    if (out.len > 0) out[0] = deepest;
+    return out;
+}
+
+pub fn next(len: usize, boundaries: []const u32, at: usize, rows: usize) usize {
+    var end = at + @min(len - at, rows);
+    for (boundaries) |b| if (b > at) {
+        end = @min(end, b);
+        break;
+    };
+    return end;
+}
+
+pub fn contains(len: usize, boundaries: []const u32, pos: usize, rows: usize) bool {
+    if (pos > len) return false;
+    var at: usize = 0;
+    while (at < pos) at = next(len, boundaries, at, rows);
+    return at == pos;
+}
+
+/// Compare actual forward boundaries, including the saved end; different hints can describe the same grid.
+pub fn compatible(len: usize, saved: []const u32, requested: []const u32, at: usize, rows: usize) bool {
+    if (!contains(len, requested, at, rows)) return false;
+    var pos: usize = 0;
+    while (pos < at) {
+        const old = next(at, saved, pos, rows);
+        const new = next(len, requested, pos, rows);
+        if (old != new) return false;
+        pos = old;
+    }
+    return true;
+}
+
+test "fine prefix flag is explicit and default off" {
+    const t = std.testing;
+    try t.expect(!try enabled(null));
+    try t.expect(!try enabled("0"));
+    try t.expect(try enabled("1"));
+    for ([_][]const u8{ "", " ", "01", "true", "2" }) |v| try t.expectError(error.BadQwenFinePrefix, enabled(v));
+}
+
+test "fine hints round to pages, deduplicate and leave a prompt tail" {
+    const t = std.testing;
+    const got = try cuts(t.allocator, 12000, &.{ 10377, 0, 10368, 12288, 4096, 127 }, 128);
+    defer t.allocator.free(got);
+    try t.expectEqualSlices(u32, &.{10368}, got);
+    try t.expectEqual(@as(usize, 4096), next(12000, got, 0, 4096));
+    try t.expectEqual(@as(usize, 8192), next(12000, got, 4096, 4096));
+    try t.expectEqual(@as(usize, 10368), next(12000, got, 8192, 4096));
+    try t.expectEqual(@as(usize, 12000), next(12000, got, 10368, 4096));
+}
+
+test "resume rejects changed preceding cuts but ignores hints after the snapshot" {
+    const t = std.testing;
+    try t.expect(compatible(20000, &.{10368}, &.{ 10368, 16384 }, 10368, 4096));
+    try t.expect(compatible(20000, &.{ 4096, 10368 }, &.{10368}, 10368, 4096));
+    try t.expect(!compatible(20000, &.{10368}, &.{ 10240, 10368 }, 10368, 4096));
+    try t.expect(!compatible(20000, &.{10368}, &.{}, 10368, 4096));
+    try t.expect(!contains(12000, &.{10368}, 8193, 4096));
+    try t.expect(contains(12000, &.{10368}, 8192, 4096));
+}
