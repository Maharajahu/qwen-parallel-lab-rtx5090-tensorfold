--- /dev/null
+++ b/zig/src/cuda/nvfp4_dense.zig
@@ -0,0 +1,198 @@
+//! Experimental SM120a W4A4 dense projection; its native words differ from qmmf's W4A16 words.
+const std = @import("std");
+const qmmf = @import("qmmf.zig");
+const Driver = @import("driver.zig").Driver;
+const Module = @import("module.zig").Module;
+const Function = @import("module.zig").Function;
+const Stream = @import("stream.zig").Stream;
+const launch = @import("launch.zig");
+
+pub const Weight = qmmf.Weight;
+pub const Out = qmmf.Out;
+/// Bound transient A4 scratch without changing any row's scales, MMA steps or K-slice reduction.
+pub const max_rows: usize = 2048;
+pub const tile = struct {
+    pub const rows = 32;
+    pub const columns = 128;
+    pub const threads = 128;
+    pub const shared = 4 * (32 * 32 + 32 * 4 + 128 * 32 + 128 * 4);
+};
+
+pub const Scratch = struct {
+    quant: u64,
+    quant_bytes: usize,
+    partial: u64,
+    partial_bytes: usize,
+};
+
+/// Counts only, no allocations; the caller owns stream-stable VRAM for both planes and the K partials.
+pub fn quantBytes(rows: usize, k: usize) !usize {
+    if (rows == 0 or k == 0 or k % 64 != 0) return error.BadShape;
+    return std.math.mul(usize, rows, k / 2 + k / 16);
+}
+
+pub fn partialBytes(rows: usize, w: Weight) !usize {
+    try validate(w);
+    const count = try std.math.mul(usize, rows, w.n);
+    return std.math.mul(usize, count, @as(usize, qmmf.slices(w)) * 4);
+}
+
+/// `act` is the checkpoint's positive finite input_scale, NOT its reciprocal or a dynamic tensor amax.
+pub fn validate(w: Weight) !void {
+    if (w.mode != .fp4 or w.n == 0 or w.n % 64 != 0 or w.k == 0 or w.k % 64 != 0) return error.BadShape;
+    if (w.npad < w.n or w.npad % 64 != 0) return error.BadShape;
+    if (w.n > std.math.maxInt(i32) or w.k > std.math.maxInt(i32) or
+        w.npad > std.math.maxInt(i32)) return error.BadShape;
+    if (!std.math.isFinite(w.act) or w.act <= 0 or !std.math.isFinite(1.0 / w.act)) return error.BadScale;
+    const alpha = w.act * w.scale;
+    if (!std.math.isFinite(w.scale) or w.scale <= 0 or !std.math.isFinite(alpha) or alpha <= 0) return error.BadScale;
+    const sk = qmmf.slices(w);
+    if (sk == 0 or sk > 8 or sk & (sk - 1) != 0 or (w.k / 64) % sk != 0) return error.BadSplit;
+}
+
+fn validateRows(w: Weight, x: u64, ldx: usize, rows: usize, out: u64, kind: Out) !void {
+    if (rows == 0 or rows > std.math.maxInt(i32) or ldx < w.k or
+        ldx > std.math.maxInt(i32)) return error.BadShape;
+    const last = try std.math.mul(usize, rows - 1, ldx);
+    const inputs = try std.math.add(usize, last, w.k);
+    const input_bytes = try std.math.mul(usize, inputs, 2);
+    const outputs = try std.math.mul(usize, rows, w.n);
+    const output_bytes = try std.math.mul(usize, outputs, if (kind == .f32) @as(usize, 4) else 2);
+    _ = try std.math.add(u64, x, @intCast(input_bytes));
+    _ = try std.math.add(u64, out, @intCast(output_bytes));
+}
+
+pub const Kernels = struct {
+    mod: Module,
+    pack_fn: Function,
+    quant_fn: Function,
+    partial_fn: Function,
+    reduce_fn: Function,
+
+    /// The image must be built from nvfp4_dense.cu for sm_120a, rather than plain sm_120.
+    pub fn load(d: *const Driver, image: []const u8, capability: u32) !Kernels {
+        if (capability != 120) return error.NativeA4NeedsSm120;
+        var mod = try Module.load(d, image);
+        errdefer mod.unload();
+        return .{
+            .mod = mod,
+            .pack_fn = try mod.function("tf_nvfp4_pack_words"),
+            .quant_fn = try mod.function("tf_nvfp4_quantize"),
+            .partial_fn = try mod.function("tf_nvfp4_dense_partial"),
+            .reduce_fn = try mod.function("tf_nvfp4_dense_reduce"),
+        };
+    }
+
+    pub fn unload(c: *Kernels) void {
+        c.mod.unload();
+        c.* = undefined;
+    }
+
+    /// Overwrite only the weight code allocation after Packer.fp4Lane; its existing scale tiles stay compatible.
+    pub fn packWords(c: *const Kernels, s: Stream, raw: u64, w: Weight) !void {
+        try validate(w);
+        var a: launch.Args = .{};
+        a.add(raw);
+        a.add(w.codes);
+        for ([_]u32{ w.n, w.k, w.npad }) |v| a.add(@as(i32, @intCast(v)));
+        try launch.launch(c.pack_fn, .{
+            .grid = .{ .x = w.npad / 64, .y = w.k / 64 },
+            .block = .{ .x = 256 },
+        }, s, &a);
+    }
+
+    /// BF16 input rows -> codes [M,K/2], then e4m3 scales [M,K/16] in caller-owned `out`.
+    pub fn quantize(c: *const Kernels, s: Stream, x: u64, ldx: usize, rows: usize, k: usize, act: f32, out: u64, bytes: usize) !void {
+        if (ldx < k or rows > std.math.maxInt(i32) or k > std.math.maxInt(i32) or
+            ldx > std.math.maxInt(i32)) return error.BadShape;
+        if (!std.math.isFinite(act) or act <= 0 or !std.math.isFinite(1.0 / act)) return error.BadScale;
+        if (bytes < try quantBytes(rows, k)) return error.ShortScratch;
+        var a: launch.Args = .{};
+        a.add(x);
+        for ([_]usize{ ldx, rows, k }) |v| a.add(@as(i32, @intCast(v)));
+        a.add(@as(f32, 1.0 / act));
+        a.add(out);
+        a.add(out + rows * (k / 2));
+        try launch.launch(c.quant_fn, .{
+            .grid = .{ .x = @intCast((rows * (k / 16) + 127) / 128) },
+            .block = .{ .x = 128 },
+        }, s, &a);
+    }
+
+    pub fn matmul(c: *const Kernels, s: Stream, w: Weight, x: u64, ldx: usize, rows: usize, out: u64, kind: Out, scratch: Scratch) !void {
+        try validate(w);
+        try validateRows(w, x, ldx, rows, out, kind);
+        const chunk = @min(rows, max_rows);
+        const quant_bytes = try quantBytes(chunk, w.k);
+        const partial_bytes = try partialBytes(chunk, w);
+        if (scratch.quant_bytes < quant_bytes or scratch.partial_bytes < partial_bytes) return error.ShortScratch;
+        _ = try std.math.add(u64, scratch.quant, @intCast(quant_bytes));
+        _ = try std.math.add(u64, scratch.partial, @intCast(partial_bytes));
+        const input_stride = ldx * 2;
+        const output_stride = @as(usize, w.n) * (if (kind == .f32) @as(usize, 4) else 2);
+        var at: usize = 0;
+        while (at < rows) {
+            const count = @min(rows - at, max_rows);
+            try c.quantize(s, x + at * input_stride, ldx, count, w.k, w.act, scratch.quant, scratch.quant_bytes);
+            try c.matmulQuantized(s, w, scratch.quant, count, out + at * output_stride, kind, scratch);
+            at += count;
+        }
+    }
+
+    /// The same static scale must have produced `x4`; K slices and their ordered merge never depend on M.
+    pub fn matmulQuantized(c: *const Kernels, s: Stream, w: Weight, x4: u64, rows: usize, out: u64, kind: Out, scratch: Scratch) !void {
+        try validate(w);
+        if (rows == 0 or rows > std.math.maxInt(i32)) return error.BadShape;
+        if (scratch.partial_bytes < try partialBytes(rows, w)) return error.ShortScratch;
+        const sk = qmmf.slices(w);
+        var a: launch.Args = .{};
+        for ([_]u64{ x4, x4 + rows * (w.k / 2), w.codes, w.scales, scratch.partial }) |v| a.add(v);
+        for ([_]usize{ rows, w.n, w.k, sk }) |v| a.add(@as(i32, @intCast(v)));
+        try launch.launch(c.partial_fn, .{
+            .grid = .{ .x = (w.n + tile.columns - 1) / tile.columns, .y = @intCast((rows + tile.rows - 1) / tile.rows), .z = sk },
+            .block = .{ .x = tile.threads },
+            .shared = tile.shared,
+        }, s, &a);
+        const total = try std.math.mul(usize, rows, w.n);
+        var b: launch.Args = .{};
+        b.add(scratch.partial);
+        b.add(out);
+        b.add(@as(i64, @intCast(total)));
+        b.add(@as(i32, @intCast(sk)));
+        b.add(@as(f32, w.act * w.scale));
+        b.add(@as(i32, @intFromBool(kind == .f32)));
+        try launch.launch(c.reduce_fn, .{
+            .grid = .{ .x = @intCast((total + 255) / 256) },
+            .block = .{ .x = 256 },
+        }, s, &b);
+    }
+};
