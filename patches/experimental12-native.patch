index 00000000..2c753c09
--- /dev/null
+++ b/zig/src/families/qwen3_5/cuda_scratch_test.zig
@@ -0,0 +1,147 @@
+//! Host-only scratch proofs use synthetic device addresses; no driver calls or device memory are needed.
+const std = @import("std");
+const E = @import("cuda_engine.zig");
+const cuda = @import("cuda");
+const geo = @import("cuda_geometry.zig");
+const scratch = @import("cuda_scratch.zig").scratch;
+const R = E.max_rows;
+const V = E.most_verify;
+const Range = struct { at: u64, bytes: usize };
+
+fn of(e: *const E.Engine, comptime name: []const u8, bytes: usize) Range {
+    return .{ .at = @field(e, name), .bytes = bytes };
+}
+
+fn size(ranges: []const Range) usize {
+    var bytes: usize = 0;
+    for (ranges) |r| bytes += E.aligned(r.bytes);
+    return bytes;
+}
+
+fn separate(a: Range, b: Range) !void {
+    if (a.bytes == 0 or b.bytes == 0) return;
+    try std.testing.expect(a.at + a.bytes <= b.at or b.at + b.bytes <= a.at);
+}
+
+fn phase(e: *const E.Engine, live: []const Range, persistent: []const Range) !void {
+    for (live, 0..) |a, i| {
+        if (a.bytes == 0) continue;
+        try std.testing.expectEqual(@as(u64, 0), a.at % 256);
+        try std.testing.expect(a.at >= e.arena.ptr and a.at + a.bytes <= e.arena.ptr + e.arena_at);
+        for (live[0..i]) |b| try separate(a, b);
+        for (persistent) |b| try separate(a, b);
+    }
+}
+
+fn shape(large: bool) geo.Geometry {
+    return .{
+        .hidden = if (large) 5120 else 2048,
+        .intermediate = if (large) 17408 else 6144,
+        .layers = if (large) 64 else 24,
+        .vocab = 248320,
+        .k_heads = 16,
+        .v_heads = if (large) 48 else 16,
+        .q_heads = if (large) 24 else 8,
+        .kv_heads = if (large) 4 else 2,
+        .eps = 1e-6,
+        .tied = !large,
+        .context = 65536,
+        .linear = @splat(true),
+    };
+}
+
+fn prove(g: geo.Geometry, compact: bool, quant: u2, start: usize) !usize {
+    var e: E.Engine = undefined;
+    e.g = g;
+    e.compact_scratch = compact;
+    e.fp8_acts = quant == 1;
+    e.fp4_acts = quant == 2;
+    e.arena_at = start;
+    e.arena.ptr = 0x100000000;
+    const measured = try scratch(&e, .measure);
