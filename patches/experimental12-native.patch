+    e.arena.len = start + measured;
+    try std.testing.expectEqual(measured, try scratch(&e, .allocate));
+    try std.testing.expectEqual(measured, E.aligned(e.arena_at) - start);
+    const wide = @max(g.valueWidth(), g.attnWidth(), g.hidden);
+    const partials = V * g.q_heads * E.max_chunks;
+    const persistent = [_]Range{
