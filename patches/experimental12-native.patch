+//! Fine shared-grid admission and invalidation use pool and snapshot ownership on the fake CUDA device.
+const std = @import("std");
+const cuda = @import("cuda");
+const engine = @import("cuda_engine.zig");
+const pages = @import("cuda_pages.zig");
+const Prefix = @import("cuda_prefix.zig").Prefix;
+const t = std.testing;
+
+test "fine prefix resumes at a page edge and changed hints invalidate snapshots and live shared pages" {
+    const D = cuda.paging_test_device.Device;
+    var d = D.driver();
+    var e: engine.Engine = undefined;
+    e.d = &d;
+    e.stream = .{ .d = &d, .handle = D.stream };
+    e.kv8 = false;
+    e.window_rows = engine.most_window;
+    e.n_taps = 0;
+    e.tap_capacity = @import("cuda_engine.zig").tap_rows;
+    e.compact_scratch = false;
+    const capacity = 12288;
+    e.g = .{ .hidden = 256, .intermediate = 256, .layers = 2, .vocab = 8, .k_heads = 1, .v_heads = 1, .q_heads = 1, .kv_heads = 1, .eps = 1e-6, .tied = true, .context = capacity, .linear = @splat(false) };
+    e.g.linear[0] = true;
+    const layout = pages.layout(&e, capacity, 128, 0, 0);
+    const p = try pages.Pages.init(t.allocator, &e, layout, capacity, 0, 2, 3 * layout.need(capacity, 0, pages.window_rows));
+    defer p.deinit();
+    const x = try Prefix.init(t.allocator, &e, p, 4);
+    defer x.deinit();
+    x.fine = true;
+    const ids = try t.allocator.alloc(u32, 11000);
+    defer t.allocator.free(ids);
+    for (ids, 0..) |*id, i| id.* = @intCast(i);
+    const cold = try x.open(ids, 16, 10240, &.{ 8329, 9865, 10377 });
+    defer t.allocator.free(cold.plan.marks);
+    defer t.allocator.free(cold.cuts);
+    try t.expectEqual(@as(u32, 0), cold.plan.from);
+    try t.expectEqualSlices(u32, &.{10368}, cold.cuts);
+    try t.expectEqualSlices(u32, &.{10368}, cold.plan.marks);
+    try x.keepWithCuts(cold.cache, ids, 10368, cold.cuts);
+    try t.expect(p.close(cold.cache));
+    const resumed = try x.open(ids, 16, 0, &.{10377});
+    defer t.allocator.free(resumed.plan.marks);
+    defer t.allocator.free(resumed.cuts);
+    try t.expectEqual(@as(u32, 10368), resumed.plan.from);
+    const shared_page = resumed.cache.paged.?.ids[0];
+    try t.expectEqual(@as(u32, 2), p.pool.refs[shared_page]);
+    // Leave the resumed lane live: invalidation must release the tree's references, never that lane's.
+    const changed = try x.open(ids, 16, 0, &.{10240});
+    defer t.allocator.free(changed.plan.marks);
+    defer t.allocator.free(changed.cuts);
+    try t.expectEqual(@as(u32, 0), changed.plan.from);
+    try t.expectEqualSlices(u32, &.{10240}, changed.plan.marks);
+    try t.expectEqual(@as(usize, 0), x.store.tree.snaps);
+    try t.expectEqual(@as(usize, 0), x.store.tree.held_pages);
+    try t.expectEqual(@as(u32, 1), p.pool.refs[shared_page]);
+    try t.expectEqual(shared_page, resumed.cache.paged.?.ids[0]);
+    try t.expect(p.close(changed.cache));
+    // An older pass may finish after a new grid was selected; its save switches identity back safely.
+    try x.keepWithCuts(resumed.cache, ids, 10368, resumed.cuts);
+    try t.expect(p.close(resumed.cache));
+    const again = try x.open(ids, 16, 0, &.{10377});
+    defer t.allocator.free(again.plan.marks);
+    defer t.allocator.free(again.cuts);
+    try t.expectEqual(@as(u32, 10368), again.plan.from);
+    try t.expect(p.close(again.cache));
+}
