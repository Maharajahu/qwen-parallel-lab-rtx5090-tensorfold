index 00000000..7ee70753
--- /dev/null
+++ b/zig/src/server/shared_prefix_hints.zig
@@ -0,0 +1,67 @@
+//! Optional client checkpoint positions in the fully rendered prompt; the cache still matches actual token IDs.
+const std = @import("std");
+const json = @import("json");
+const errors = @import("errors.zig");
+const Cx = errors.Cx;
+pub const max_hints = 32;
+
+/// Parse without coercing floats, booleans, strings or null into token positions.
+pub fn parse(cx: *Cx, value: ?json.Value) errors.Refused![]const u32 {
+    const v = value orelse return &.{};
+    if (v != .array or v.array.len > max_hints)
+        return cx.refuse("shared_prefixes must be an array of at most 32 integer token positions");
+    var out: std.ArrayList(u32) = .empty;
+    errdefer out.deinit(cx.a);
+    for (v.array) |item| {
+        const n = if (item == .int) item.int64() else null;
+        if (n == null or n.? < 0 or n.? > std.math.maxInt(u32))
+            return cx.refuse("shared_prefixes positions must be nonnegative integers fitting u32");
+        const at: u32 = @intCast(n.?);
+        if (std.mem.indexOfScalar(u32, out.items, at) == null) try out.append(cx.a, at);
+    }
+    std.mem.sort(u32, out.items, {}, std.sort.asc(u32));
+    return out.toOwnedSlice(cx.a);
+}
+
+/// Append only after validating against the final template-rendered prompt length.
+pub fn append(cx: *Cx, shared: *std.ArrayList(u32), explicit: []const u32, len: usize) errors.Refused!void {
+    for (explicit) |at| if (at >= len)
+        return cx.refuse("shared_prefixes positions must be smaller than the rendered prompt token count");
+    if (explicit.len == 0) return;
+    for (explicit) |at| if (std.mem.indexOfScalar(u32, shared.items, at) == null) try shared.append(cx.a, at);
+    std.mem.sort(u32, shared.items, {}, std.sort.asc(u32));
+}
+
+test "shared prefix hints reject coercions, negative and oversized positions and oversized arrays" {
+    var arena = std.heap.ArenaAllocator.init(std.testing.allocator);
+    defer arena.deinit();
+    var cx: Cx = .{ .a = arena.allocator() };
+    for ([_][]const u8{ "null", "false", "1", "[true]", "[1.0]", "[\"1\"]", "[-1]", "[4294967296]" }) |text| {
+        const v = (try json.parse(cx.a, text)).ok;
+        try std.testing.expectError(error.Refused, parse(&cx, v));
+    }
+    const many = try cx.a.alloc(json.Value, max_hints + 1);
+    @memset(many, .{ .int = "1" });
+    try std.testing.expectError(error.Refused, parse(&cx, .{ .array = many }));
+}
+
+test "shared prefix hints sort deduplicate and validate rendered boundaries without changing absent hints" {
+    const t = std.testing;
+    var arena = std.heap.ArenaAllocator.init(t.allocator);
+    defer arena.deinit();
+    var cx: Cx = .{ .a = arena.allocator() };
+    try t.expectEqualSlices(u32, &.{}, try parse(&cx, null));
+    const v = (try json.parse(cx.a, "[10377,0,10377,4096]")).ok;
+    const parsed = try parse(&cx, v);
+    try t.expectEqualSlices(u32, &.{ 0, 4096, 10377 }, parsed);
+    var shared: std.ArrayList(u32) = .empty;
+    try shared.appendSlice(cx.a, &.{ 512, 1024 });
+    const before = shared.items.ptr;
+    try append(&cx, &shared, &.{}, 11000);
+    try t.expectEqual(before, shared.items.ptr);
+    try t.expectEqualSlices(u32, &.{ 512, 1024 }, shared.items);
+    try append(&cx, &shared, parsed, 10378);
+    try t.expectEqualSlices(u32, &.{ 0, 512, 1024, 4096, 10377 }, shared.items);
+    try t.expectError(error.Refused, append(&cx, &shared, &.{10377}, 10377));
+    try t.expectError(error.Refused, append(&cx, &shared, &.{0}, 0));
+}
