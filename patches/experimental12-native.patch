diff --git a/zig/src/core/lane_host_group.zig b/zig/src/core/lane_host_group.zig
new file mode 100644
index 00000000..dde20139
--- /dev/null
+++ b/zig/src/core/lane_host_group.zig
@@ -0,0 +1,150 @@
+//! Explicit finite groups: prepare every member, then release one shared decode start.
+const std = @import("std");
+const api = @import("engine_api.zig");
+const Host = @import("lane_host.zig").LaneHost;
+const Job = Host.Job;
+const ends = @import("lane_host_end.zig");
+const ledger = @import("lane_host_ledger.zig");
+pub const timeout_ns = 10 * std.time.ns_per_s;
+
+fn same(a: api.StartGroup, b: api.StartGroup) bool {
+    return std.mem.eql(u8, a.id, b.id);
+}
+
+/// Called under the host lock. A duplicate member cannot satisfy the barrier.
+pub fn accepts(h: *const Host, request: *const api.Request) bool {
+    const group = request.start_group orelse return true;
+    if (h.rounds != null or group.id.len == 0 or group.id.len > 64 or group.count < 2 or
+        group.count > @min(h.info_.lanes, api.max_start_group) or group.index >= group.count or request.background or
+        request.max_tokens == 0 or request.promptOnly()) return false;
+    for (h.admitted.items) |job| if (job.request.start_group) |other| {
+        if (same(group, other)) return false;
+    };
+    for (h.queued.items) |job| if (job.request.start_group) |other| {
+        if (same(group, other) and (group.count != other.count or group.index == other.index)) return false;
+    };
+    return true;
+}
+
+fn ready(ptr: *anyopaque) void {
+    const job: *Job = @ptrCast(@alignCast(ptr));
+    job.host.prefilled(job, job.began);
+    // The first token belongs to prefill. No delivery or decode round before the barrier.
+}
+
+fn prepare(h: *Host, job: *Job) !void {
+    const load = @import("lane_host_load.zig");
+    if (!h.core.fills()) {
+        load.calling(h, job);
+        return h.core.addStreamCommitted(&job.stream, .{ .ptr = job, .call = ready });
+    }
+    // Preserve the served backend's stepped prefill/cache path, without decode
+    // rounds between chunks or members of this group.
+    while (true) {
+        const first = !job.fill_began;
+        job.fill_began = true;
+        load.calling(h, job);
+        const done = try h.core.fillStreamCommitted(&job.stream, first, .{ .ptr = job, .call = ready }, 0);
+        load.progress(h, job);
+        if (done) return;
+    }
+}
+
+pub fn cancelPeers(h: *Host, cancelled: *const Job) void {
+    const group = cancelled.request.start_group orelse return;
+    h.lock();
+    defer h.unlock();
+    for ([_][]*Job{ h.queued.items, h.admitted.items }) |list| for (list) |job| {
+        if (job.id == cancelled.id) continue;
+        if (job.request.start_group) |other| if (same(group, other)) {
+            h.cancels.append(h.gpa, job.id) catch {};
+        };
+    };
+    h.wake.signal(h.io);
+}
+
+/// The ordinary loop calls this before admission. Never fall back to serial generation.
+pub fn run(h: *Host) bool {
+    h.lock();
+    if (h.closing or h.stale or h.admitted.items.len != 0) {
+        h.unlock();
+        return false;
+    }
+    const first = for (h.queued.items) |job| {
+        if (job.request.start_group != null) break job;
+    } else {
+        h.unlock();
+        return false;
+    };
+    const group = first.request.start_group.?;
+    var count: usize = 0;
+    for (h.queued.items) |job| if (job.request.start_group) |other| {
+        if (same(group, other)) count += 1;
+    };
+    const expired = std.Io.Clock.awake.now(h.io).toNanoseconds() - first.submitted >= timeout_ns;
+    if (count < group.count and !expired) {
+        h.unlock();
+        return false;
+    }
+    var jobs: [api.max_start_group]*Job = undefined;
+    var n: usize = 0;
+    var i: usize = 0;
+    while (i < h.queued.items.len) {
+        const job = h.queued.items[i];
+        if (job.request.start_group) |other| if (same(group, other)) {
+            jobs[n] = h.queued.orderedRemove(i);
+            n += 1;
+            continue;
+        };
+        i += 1;
+    }
+    h.admitted.ensureUnusedCapacity(h.gpa, n) catch {
+        h.unlock();
+        for (jobs[0..n]) |job| h.finish(job, .failed, "synchronized start: out of memory");
+        return true;
+    };
+    for (jobs[0..n]) |job| {
+        job.noteAdmission();
+        job.seq = h.admissions;
+        h.admissions += 1;
+        h.admitted.appendAssumeCapacity(job);
+    }
+    h.unlock();
+    if (expired and count < group.count) {
+        ends.failAll(h, "synchronized start: incomplete group timed out");
+        return true;
+    }
+    for (jobs[0..n]) |job| {
+        h.lock();
+        const promised = ledger.promise(h, job);
+        h.unlock();
+        if (!promised) {
+            ends.failAll(h, "synchronized start: the complete group does not fit in GPU memory");
+            return true;
+        }
+        if (h.setup(job) == null) {
+            ends.failAll(h, "synchronized start: a member could not initialize");
+            return true;
+        }
+        prepare(h, job) catch |err| {
+            if (err == error.Cancelled) _ = h.cancel(job); // the core already released its backend state
+            ends.failed(h, err);
+            ends.failAll(h, if (err == error.LaneMemory) "synchronized start: the complete group does not fit in GPU memory" else @errorName(err));
+            return true;
+        };
+        h.prefilled(job, job.began);
+    }
+    // Each member has at most its prefill token; no member has executed a decode round.
+    std.log.info("synchronized start: {d} members ready; releasing first tokens before their common decode round", .{n});
+    for (jobs[0..n]) |job| std.debug.assert(job.stream.rounds == 0);
+    h.core.sweep() catch |err| {
+        ends.failRound(h, err);
+        return true;
+    };
+    ends.deliverPending(h);
+    return true;
+}
+
+test {
+    _ = @import("lane_host_group_test.zig");
+}
diff --git a/zig/src/core/lane_host_group_test.zig b/zig/src/core/lane_host_group_test.zig
new file mode 100644
index 00000000..33038210
--- /dev/null
+++ b/zig/src/core/lane_host_group_test.zig
@@ -0,0 +1,106 @@
+const std = @import("std");
+const api = @import("engine_api.zig");
+const lanes = @import("lanes");
+const Host = @import("lane_host.zig").LaneHost;
+const group = @import("lane_host_group.zig");
+const a = std.testing.allocator;
+
+const Box = struct {
+    target: *lanes.fake.Fake,
+    expected: usize,
+    mutex: std.Io.Mutex = .init,
+    first: bool = true,
+    early: bool = false,
+    count: usize = 0,
+    done: ?api.Reason = null,
+    fn event(ptr: *anyopaque, _: api.Id, ev: *const api.Event) void {
+        const b: *Box = @ptrCast(@alignCast(ptr));
+        b.mutex.lockUncancelable(std.testing.io);
+        defer b.mutex.unlock(std.testing.io);
+        switch (ev.*) {
+            .tokens => |t| {
+                if (b.first) b.early = b.target.lanes.count() != b.expected;
+                b.first = false;
+                b.count += t.len;
+            },
+            .finished => |f| b.done = f.reason,
+            else => {},
+        }
+    }
+    fn wait(b: *Box) !api.Reason {
+        for (0..2000) |_| {
+            b.mutex.lockUncancelable(std.testing.io);
+            const result = b.done;
+            b.mutex.unlock(std.testing.io);
+            if (result) |r| return r;
+            try std.Io.sleep(std.testing.io, .fromMilliseconds(1), .awake);
+        }
+        return error.TimedOut;
+    }
+};
+
+fn run(comptime n: usize, fail_memory: bool, expired: bool, cancel: bool, stepped: bool) !void {
+    var target: lanes.fake.Fake = .{ .gpa = a, .memory_lanes = if (fail_memory) 2 else null, .prefill_chunks = if (stepped) 2 else 0 };
+    defer target.deinit();
+    var cfg = try lanes.Config.init(a, .{ .exact_width = 8, .gpu_tokens = true, .hidden_rows = true }, n, 7);
+    defer cfg.deinit(a);
+    var clock: lanes.fake.FixedClock = .{};
+    var core = lanes.Engine.init(a, &cfg, if (stepped) target.stepped() else target.backend(), clock.clock());
+    defer core.deinit();
+    var host = Host.init(a, std.testing.io, &core, .{ .lanes = n });
+    const engine = host.engine();
+    var requests: [n]api.Request = undefined;
+    var boxes: [n]Box = undefined;
+    for (0..n) |i| {
+        requests[i] = .{ .prompt = &.{ 2, 7, 1, 8 }, .max_tokens = 12, .drafts = false, .start_group = .{ .id = "test-group", .count = n, .index = @intCast(i) } };
+        boxes[i] = .{ .target = &target, .expected = n };
+    }
+    try engine.submit(1, &requests[0], .{ .ctx = &boxes[0], .event = Box.event });
+    // No first member is admitted or prefills while the other members are absent.
+    try std.testing.expect(!group.run(&host));
+    try std.testing.expect(!host.admitOne());
+    try std.testing.expectEqual(@as(usize, 0), target.lanes.count());
+    try std.testing.expectError(error.InvalidRequest, engine.submit(20, &requests[0], .{ .ctx = &boxes[0], .event = Box.event }));
+    if (expired) {
+        host.queued.items[0].submitted -= group.timeout_ns;
+    } else {
+        for (1..if (cancel) 2 else n) |i| try engine.submit(@intCast(i + 1), &requests[i], .{ .ctx = &boxes[i], .event = Box.event });
+    }
+    if (cancel) engine.cancel(1);
+    const old_log = std.testing.log_level;
+    std.testing.log_level = .err;
+    defer std.testing.log_level = old_log;
+    try host.start();
+    var stopped = false;
+    defer if (!stopped) host.stop();
+    for (boxes[0..if (expired) 1 else if (cancel) 2 else n]) |*box| {
+        try std.testing.expectEqual(if (cancel) api.Reason.cancelled else if (fail_memory or expired) api.Reason.failed else api.Reason.length, try box.wait());
+    }
+    host.stop();
+    stopped = true;
+    for (boxes[0..if (expired) 1 else if (cancel) 2 else n]) |box| {
+        try std.testing.expectEqual(@as(usize, if (fail_memory or expired or cancel) 0 else 12), box.count);
+        try std.testing.expect(!box.early);
+    }
+    try std.testing.expectEqual(@as(usize, 0), target.lanes.count());
+}
+
+test "synchronized start waits for all members at widths eight through sixteen" {
+    inline for (.{ 8, 10, 12, 14, 16 }) |n| {
+        try run(n, false, false, false, false);
+        try run(n, false, false, false, true);
+    }
+}
+
+test "a group that does not fit fails every member without emitting or serial fallback" {
+    try run(16, true, false, false, false);
+    try run(16, true, false, false, true);
+}
+
+test "an incomplete group times out without any prefill or output" {
+    try run(16, false, true, false, false);
+}
+
+test "cancelling an incomplete group cancels its peers without waiting for the deadline" {
+    try run(16, false, false, true, false);
+}
