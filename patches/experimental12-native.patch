+test "native A4 validates static scales, shape-only splits and bounded scratch" {
+    var w: Weight = .{ .mode = .fp4, .codes = 0, .scales = 0, .scale = 0.25, .act = 0.5, .n = 17408, .k = 5120, .npad = 17408 };
+    try validate(w);
+    try std.testing.expectEqual(@as(usize, 32 * 5120 * 9 / 16), try quantBytes(32, 5120));
+    try std.testing.expectEqual(@as(usize, 32 * 17408 * 4), try partialBytes(32, w));
+    for ([_]f32{ 0, -1, std.math.nan(f32), std.math.inf(f32) }) |scale| {
+        w.act = scale;
+        try std.testing.expectError(error.BadScale, validate(w));
+    }
+    w.act = 0.5;
+    w.sk = 8;
+    try validate(w);
+    w.sk = 3;
+    try std.testing.expectError(error.BadSplit, validate(w));
+}
+
+test "native A4 validates a complete chunked call before launching its first chunk" {
+    const w: Weight = .{ .mode = .fp4, .codes = 0, .scales = 0, .scale = 0.25, .act = 0.5, .n = 192, .k = 576, .npad = 256 };
+    try validateRows(w, 256, 592, max_rows + 1, 256, .bf16);
+    try validateRows(w, 256, 592, max_rows + 1, 256, .f32);
+    try std.testing.expectError(error.BadShape, validateRows(w, 256, 575, max_rows + 1, 256, .bf16));
+    try std.testing.expectError(error.BadShape, validateRows(w, 256, 592, 0, 256, .bf16));
+    try std.testing.expectError(error.BadShape, validateRows(w, 256, 592, @as(usize, std.math.maxInt(i32)) + 1, 256, .bf16));
+    try std.testing.expectError(error.Overflow, validateRows(w, std.math.maxInt(u64) - 4, 592, max_rows + 1, 256, .bf16));
+    try std.testing.expectError(error.Overflow, validateRows(w, 256, 592, max_rows + 1, std.math.maxInt(u64) - 4, .f32));
+    try std.testing.expect(try quantBytes(max_rows, w.k) < try quantBytes(max_rows + 1, w.k));
+    try std.testing.expect(try partialBytes(max_rows, w) < try partialBytes(max_rows + 1, w));
+}
