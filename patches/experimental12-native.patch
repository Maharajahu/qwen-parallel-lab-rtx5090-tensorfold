--- /dev/null
+++ b/zig/src/families/qwen3_5/cuda_gpu_profile.zig
@@ -0,0 +1,112 @@
+//! Optional verify-only GPU phase timings; captured event nodes are diagnostic overhead.
+const std = @import("std");
+const cuda = @import("cuda");
+
+pub const Phase = enum {
+    embed,
+    input_norm,
+    inproj,
+    gdn_pre,
+    gdn_scan,
+    gdn_post,
+    attention,
+    outproj,
+    post_norm,
+    gate_up,
+    act,
+    down,
+    moe,
+    taps,
+    final_norm,
+    head,
+};
+const phase_count = @typeInfo(Phase).@"enum".field_names.len;
+const Mark = struct { event: cuda.Event, phase: Phase = .embed };
+
+pub const Profile = struct {
+    gpa: std.mem.Allocator,
+    marks: []Mark,
+    n: usize = 0,
+    cursor: usize = 0,
+    captured: bool = false,
+    rounds: u64 = 0,
+    samples: u64 = 0,
+    ms: [phase_count]f64 = @splat(0),
+
+    pub fn init(gpa: std.mem.Allocator, d: *const cuda.Driver, layers: usize) !?*Profile {
+        if (!try @import("sys").environment.read(bool, "TF_QWEN_GPU_PROFILE", false)) return null;
+        const p = try gpa.create(Profile);
+        errdefer gpa.destroy(p);
+        const marks = try gpa.alloc(Mark, layers * 11 + 4);
+        errdefer gpa.free(marks);
+        var made: usize = 0;
+        errdefer for (marks[0..made]) |*m| m.event.deinit();
+        for (marks) |*m| {
+            m.* = .{ .event = try cuda.Event.init(d, true) };
+            made += 1;
+        }
+        p.* = .{ .gpa = gpa, .marks = marks };
+        return p;
+    }
+
+    pub fn deinit(p: *Profile) void {
+        for (p.marks) |*m| m.event.deinit();
+        p.gpa.free(p.marks);
+        p.gpa.destroy(p);
+    }
+
+    fn record(p: *Profile, s: cuda.Stream, at: usize) !void {
+        const event = p.marks[at].event;
+        if (p.captured) try event.recordExternal(s) else try event.record(s);
+    }
+
+    /// Called only after the forward's existing wait; reads one completed verify out of every 64.
+    pub fn completed(p: *Profile, rows: usize, streams: usize) !void {
+        p.rounds += 1;
+        if (p.rounds % 64 != 0) return;
+        var sample: [phase_count]f64 = @splat(0);
+        for (p.marks[1 .. p.n + 1], 0..) |m, i| {
+            const ms = try cuda.Event.elapsedMs(p.marks[i].event, m.event);
+            if (!std.math.isFinite(ms) or ms < 0) return error.InvalidQwenGpuTiming;
+            sample[@backingInt(m.phase)] += ms;
+        }
+        p.samples += 1;
+        const count: f64 = @floatFromInt(p.samples);
+        var total: f64 = 0;
+        for (&p.ms, sample) |*sum, ms| {
+            sum.* += ms;
+            total += sum.*;
+        }
+        std.debug.print("[qwen-gpu] samples={d} every=64 rows={d} streams={d} avg_ms={d:.3}", .{ p.samples, rows, streams, total / count });
+        inline for (@typeInfo(Phase).@"enum".field_names, 0..) |name, i| {
+            std.debug.print(" {s}={d:.3}", .{ name, p.ms[i] / count });
+        }
+        std.debug.print("\n", .{});
+    }
+};
+
+pub fn begin(p: ?*Profile, s: cuda.Stream, enabled: bool) !?*Profile {
+    if (!enabled) return null;
+    const v = p orelse return null;
+    v.cursor = 0;
+    v.captured = try cuda.graph.captureStatus(s) != .none;
+    try v.record(s, 0);
+    return v;
+}
+
+pub inline fn mark(p: ?*Profile, s: cuda.Stream, phase: Phase) !void {
+    const v = p orelse return;
+    if (v.cursor + 1 >= v.marks.len) return error.QwenGpuProfileOverflow;
+    v.cursor += 1;
+    v.marks[v.cursor].phase = phase;
+    try v.record(s, v.cursor);
+}
+
+/// Init can fail after warmup captured graphs; their event references must die before their event owners.
+pub fn failed(e: anytype) void {
+    cuda.completion.drain(e.d, e.stream, "Qwen profiler warmup did not drain");
+    var it = e.graphs.valueIterator();
+    while (it.next()) |graph| graph.deinit();
+    e.graphs.deinit(e.gpa);
+    e.gpu_profile.?.deinit();
+}
