+    const tail_n = spans[1][1] - tail_at;
+    const a = logits; // rows x 98,304, then rows x the tail's columns, then the packed rows x 98,592
+    const b = a + rows * spans[0][1] * 2;
+    const out = b + rows * tail_n * 2;
+    if (e.affine.pdl and first == .a4 and tail == .a4) {
+        try e.projManySums(&.{ first, tail }, x, d.xs, &.{ a, b }, rows, false, 0);
+    } else {
+        try draft.precision.project(e, first, x, d.xs, a, rows, .proposal, draft.precision.dflash_projection_prompt_cutoff);
+        try draft.precision.project(e, tail, x, d.xs, b, rows, .proposal, draft.precision.dflash_projection_prompt_cutoff);
+    }
+    const skip = spans[1][0] - tail_at;
+    const copies = [2]cuda.abi.Memcpy2D{
+        .{ .src = a, .src_pitch = spans[0][1] * 2, .dst = out, .dst_pitch = span_width * 2, .width = spans[0][1] * 2, .height = rows },
+        .{ .src = b + skip * 2, .src_pitch = tail_n * 2, .dst = out + spans[0][1] * 2, .dst_pitch = span_width * 2, .width = (tail_n - skip) * 2, .height = rows },
+    };
+    for (&copies) |*m| try e.d.check(e.d.api.cuMemcpy2DAsync_v2(m, e.stream.handle), "cuMemcpy2DAsync");
+    return out;
+}
+
+/// The rows' draft logits over the whole vocabulary, in `logits`.
+fn full(d: anytype, x: u64, logits: u64, rows: usize) !?u64 {
+    try draft.precision.project(d.e, d.e.head, x, d.xs, logits, rows, .proposal, draft.precision.dflash_projection_prompt_cutoff);
+    return null;
+}
+
+
+test "DFlash head pruning: truncated candidates produce the identical bounded tree" {
+    const t = std.testing;
+    const walker = @import("lanes").draft_tree;
+    var words: [15 * lp_words * 4]u8 align(4) = @splat(0);
+    const w = std.mem.bytesAsSlice(u32, &words);
+    const zeros: [64]u16 = @splat(0);
+    for (0..15) |r| for (0..4) |j| {
+        w[r * lp_words + 2 + j] = @intCast(r * 4 + j);
+        const score: f32 = @as(f32, @floatFromInt((r * 7 + j * 3) % 11)) - 5;
+        w[r * lp_words + 22 + j] = @bitCast(score);
+    };
+    var c: walker.Candidates = .{
+        .words = &words,
+        .projected = std.mem.sliceAsBytes(zeros[0..15]),
+        .topk = 4,
+        .rank = 1,
+        .predecessor = &zeros,
+        .successor = &zeros,
+    };
+    for (1..16) |budget| {
+        var all_ids: [15]u32 = undefined;
+        var all_parents: [15]i32 = undefined;
+        var all_chances: [15]f64 = undefined;
+        var cut_ids: [15]u32 = undefined;
+        var cut_parents: [15]i32 = undefined;
+        var cut_chances: [15]f64 = undefined;
+        c.words = &words;
+        c.projected = std.mem.sliceAsBytes(zeros[0..15]);
+        const a = walker.grow(64, c, 0, 15, budget, &all_ids, &all_parents, &all_chances);
+        c.words = words[0 .. budget * lp_words * 4];
+        c.projected = std.mem.sliceAsBytes(zeros[0..budget]);
+        const b = walker.grow(64, c, 0, budget, budget, &cut_ids, &cut_parents, &cut_chances);
+        try t.expectEqual(a, b);
+        try t.expectEqualSlices(u32, all_ids[0..a], cut_ids[0..b]);
+        try t.expectEqualSlices(i32, all_parents[0..a], cut_parents[0..b]);
+        try t.expectEqualSlices(f64, all_chances[0..a], cut_chances[0..b]);
+    }
+}
